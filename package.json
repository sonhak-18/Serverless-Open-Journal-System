    "deploy": "npm run deploy:cdn && npm run deploy:portal"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/tailwind": "^5.1.5",
    "astro": "^4.16.18",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "docx": "^9.11.0",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true,
    "workerd@1.20261012.1": true
  }
}
