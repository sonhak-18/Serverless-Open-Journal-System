{
  "name": "sektansia-press",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy:portal": "astro build && wrangler pages deploy dist --project-name sektansia-press",
