---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPdfDownloadUrl } from '../config/journal';
import { getDbSettings } from '../lib/db';
import type { Article } from '../data/articles';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  article?: Article;
}

const { title, description, article } = Astro.props;

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);

const pageTitle = title 
  ? `${title} | ${journalConfig.shortName}` 
  : `${journalConfig.name} (${journalConfig.shortName})`;

const metaDescription = description || 
  `Portal publikasi ilmiah ${journalConfig.name}. Peer-reviewed Diamond Open Access bidang Audit, Akuntansi, dan Perpajakan. Diterbitkan oleh ${journalConfig.publisher}.`;

const canonicalOrigin = Astro.url.origin && !Astro.url.origin.includes('localhost') && !Astro.url.origin.includes('pages.dev')
  ? Astro.url.origin
  : (Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://jurnal.example.com');

const canonicalUrl = new URL(Astro.url.pathname, canonicalOrigin);

let scholarPdfUrl = '';
if (article) {
  scholarPdfUrl = getPdfDownloadUrl(article.pdfFileName);
  // Pastikan URL absolut untuk Google Scholar
  if (scholarPdfUrl.startsWith('/')) {
    scholarPdfUrl = new URL(scholarPdfUrl, canonicalOrigin).toString();
  }
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={journalConfig.branding?.faviconUrl || '/favicon.png'} />
    <link rel="apple-touch-icon" href={journalConfig.branding?.faviconUrl || '/favicon.png'} />
    <link rel="canonical" href={canonicalUrl.toString()} />

    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: https://cloudflareinsights.com; frame-ancestors 'self';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta Sosial -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:site_name" content={journalConfig.name} />

    <!-- Google Scholar Academic Meta Tags (Aktif saat di halaman artikel) -->
    {article && (
      <>
        <meta name="citation_title" content={article.title} />
        {article.authors.map((author) => (
          <>
            <meta name="citation_author" content={author.name} />
            {author.affiliation && (
              <meta name="citation_author_institution" content={author.affiliation} />
            )}
          </>
        ))}
        <meta name="citation_publication_date" content={article.publishDate.replaceAll('-', '/')} />
        <meta name="citation_journal_title" content={journalConfig.name} />
        <meta name="citation_journal_abbrev" content={journalConfig.shortName} />
        <meta name="citation_volume" content={article.volume.toString()} />
        <meta name="citation_issue" content={article.issue.toString()} />
        <meta name="citation_firstpage" content={article.firstPage.toString()} />
        <meta name="citation_lastpage" content={article.lastPage.toString()} />
        <meta name="citation_doi" content={article.doi} />
        <meta name="citation_pdf_url" content={scholarPdfUrl} />
      </>
    )}
  </head>
  <body data-article-slug={article?.slug} class="min-h-screen flex flex-col bg-academic-paper text-academic-ink selection:bg-red-100 selection:text-academic-navy">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <script>
      // Global PDF Download Tracker via Cloudflare KV
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('[data-track-download]') as HTMLElement | null;
        if (!target) return;
        const slug = target.getAttribute('data-track-download');
        if (!slug) return;
        try {
          fetch('/api/stats', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'track_download', slug }),
            keepalive: true,
          }).catch(() => {});
        } catch (_) {}
      });
    </script>
  </body>
</html>
