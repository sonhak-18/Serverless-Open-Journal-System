---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPdfDownloadUrl } from '../config/journal';
import { getCachedSettings } from '../lib/kv';
import type { Article } from '../data/articles';
import '../styles/global.css';

interface Props {
  title?: string;
  exactTitle?: boolean;
  description?: string;
  article?: Article;
  faviconUrl?: string;
  showHeader?: boolean;
  showFooter?: boolean;
}

const { 
  title, 
  exactTitle = false, 
  description, 
  article, 
  faviconUrl,
  showHeader = true, 
  showFooter = true 
} = Astro.props;

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const kv = (Astro.locals as any)?.runtime?.env?.KV;
const journalConfig = await getCachedSettings(kv, d1);

const effectiveFavicon = faviconUrl || journalConfig.branding?.faviconUrl || '/favicon.png';
const cacheBuster = '20261017v2';
const faviconWithVersion = effectiveFavicon.startsWith('data:') ? effectiveFavicon : `${effectiveFavicon}?v=${cacheBuster}`;

const pageTitle = exactTitle
  ? (title || journalConfig.name)
  : (title 
      ? `${title} | ${journalConfig.shortName}` 
      : `${journalConfig.name} (${journalConfig.shortName})`);

const metaDescription = description || 
  `Portal publikasi ilmiah ${journalConfig.name} (${journalConfig.shortName}). Open Access peer-reviewed bidang Akuntansi Keberlanjutan & ESG, Perpajakan, Auditing & Tata Kelola, serta Dinamika Ekonomi & Bisnis. Diterbitkan oleh ${journalConfig.publisher}.`;

const canonicalOrigin = Astro.url.origin && !Astro.url.origin.includes('localhost') && !Astro.url.origin.includes('pages.dev')
  ? Astro.url.origin
  : (Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://jurnal.example.com');

const canonicalUrl = new URL(Astro.url.pathname, canonicalOrigin);

let scholarPdfUrl = '';
if (article) {
  scholarPdfUrl = getPdfDownloadUrl(article.pdfFileName);
  // Pastikan URL absolut untuk Google Scholar
  if (scholarPdfUrl.startsWith('/')) {
    scholarPdfUrl = new URL(scholarPdfUrl, canonicalOrigin).toString();
  }
}
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href={faviconWithVersion} />
    <link rel="icon" type="image/png" sizes="192x192" href={faviconWithVersion} />
    <link rel="icon" type="image/png" href={faviconWithVersion} />
    <link rel="shortcut icon" href={faviconWithVersion} />
    <link rel="apple-touch-icon" href={faviconWithVersion} />
    <link rel="canonical" href={canonicalUrl.toString()} />

    <!-- Google Fonts: Open Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />

    <!-- Security Headers -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: https://cloudflareinsights.com; object-src 'none'; frame-ancestors 'none';" />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta Sosial -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:site_name" content={journalConfig.name} />

    <!-- Google Scholar Academic Meta Tags (Aktif saat di halaman artikel) -->
    {article && (
      <>
        <meta name="citation_title" content={article.title} />
        {article.authors.map((author) => (
          <>
            <meta name="citation_author" content={author.name} />
            {author.affiliation && (
              <meta name="citation_author_institution" content={author.affiliation} />
            )}
          </>
        ))}
        <meta name="citation_publication_date" content={article.publishDate.replaceAll('-', '/')} />
        <meta name="citation_journal_title" content={journalConfig.name} />
        <meta name="citation_journal_abbrev" content={journalConfig.shortName} />
        <meta name="citation_volume" content={article.volume.toString()} />
        <meta name="citation_issue" content={article.issue.toString()} />
        <meta name="citation_firstpage" content={article.firstPage.toString()} />
        <meta name="citation_lastpage" content={article.lastPage.toString()} />
        <meta name="citation_doi" content={article.doi} />
        <meta name="citation_pdf_url" content={scholarPdfUrl} />
      </>
    )}
  </head>
  <body data-article-slug={article?.slug} class="min-h-screen flex flex-col bg-academic-paper text-academic-ink selection:bg-red-100 selection:text-academic-navy">
    {showHeader && <Header journalConfig={journalConfig} />}
    <main class="flex-grow">
      <slot />
    </main>
    {showFooter && <Footer journalConfig={journalConfig} />}

    <script>
      // 1. Client-Side Security Hygiene: Bersihkan token sensitif dari client storage jika pernah tersimpan
      if (typeof window !== 'undefined' && window.localStorage) {
        try {
          localStorage.removeItem('repo_admin_token');
        } catch (_) {}
      }

      // 2. Global PDF Download Tracker via Cloudflare KV dengan Validasi Client-Side
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('[data-track-download]') as HTMLElement | null;
        if (!target) return;
        const slug = target.getAttribute('data-track-download')?.trim();
        // Strict client-side validation format pencegah IDOR / Parameter Tampering
        if (!slug || !/^[a-zA-Z0-9_-]{1,100}$/.test(slug)) return;

        try {
          fetch('/api/stats', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'track_download', slug }),
            keepalive: true,
          }).catch(() => {});
        } catch (_) {}
      });
    </script>
  </body>
</html>
