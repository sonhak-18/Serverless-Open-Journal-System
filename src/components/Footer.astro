---
import { getDbSettings } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0a1a33] text-slate-300 border-t-4 border-[#0f284e] mt-16 text-xs">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Kolom 1: Institusi & Alamat Kantor Jurnal -->
      <div class="md:col-span-7 space-y-2">
        <h2 class="text-sm font-bold text-white tracking-wide uppercase">
          {journalConfig.name}
        </h2>
        <p class="text-slate-400 leading-relaxed max-w-xl">
          Diterbitkan oleh <strong class="text-slate-200">{journalConfig.publisher}</strong> bekerja sama dengan {journalConfig.institution}.
        </p>
        <p class="text-slate-400">
          <strong>Alamat Redaksi:</strong> {journalConfig.address}
        </p>
        <div class="pt-2 flex flex-wrap gap-4 text-slate-400">
          <span>Email: <a href={`mailto:${journalConfig.submission.email}`} class="text-slate-200 hover:underline font-mono">{journalConfig.submission.email}</a></span>
          <span>•</span>
          <span>WhatsApp: <span class="text-slate-200 font-mono">{journalConfig.submission.whatsappDisplay}</span></span>
        </div>
      </div>

      <!-- Kolom 2: Lisensi & Standar Platform -->
      <div class="md:col-span-5 space-y-2">
        <h3 class="text-xs font-bold uppercase text-slate-300 tracking-wider">
          Lisensi & Hak Akses
        </h3>
        <p class="text-slate-300 leading-relaxed">
          Semua artikel yang diterbitkan oleh {journalConfig.shortName} didistribusikan di bawah lisensi resmi{' '}
          <a
            href={journalConfig.licenseUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[#c89b3c] hover:underline font-medium"
          >
            Creative Commons Attribution-ShareAlike 4.0 (CC BY-SA 4.0)
          </a>.
        </p>
        <p class="text-xs text-slate-400 pt-1">
          Penulis memegang hak cipta penuh tanpa batasan penyerahan naskah.
        </p>
      </div>
    </div>

    <!-- Baris Bawah OJS -->
    <div class="border-t border-slate-800 mt-8 pt-5 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-300 gap-3">
      <div>
        <p>
          Copyright © {currentYear} <a href="/" class="text-slate-200 hover:text-white font-medium hover:underline">{journalConfig.publisher}</a>. Hak Cipta Dilindungi Undang-Undang.
        </p>
      </div>

      <div class="flex items-center space-x-3 text-slate-300">
        <a href="/index/JTEBA/guidelines" class="hover:text-slate-200">Publication Ethics</a>
        <span>|</span>
        <a href="/index/JTEBA/indexing" class="hover:text-slate-200">Indexing</a>
        <span>|</span>
        <a href="/index/JTEBA/admin" class="hover:text-emerald-300 font-medium text-slate-300">Panel Redaksi</a>
      </div>
    </div>
  </div>
</footer>
