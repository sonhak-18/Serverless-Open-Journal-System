---
import { getPdfDownloadUrl } from '../config/journal';
import type { Article } from '../data/articles';
import { kvGetCounter } from '../lib/kv';

interface Props {
  article: Article;
  storage?: { gdriveIndexBaseUrl?: string; pdfDirectoryPath?: string };
}

const { article, storage } = Astro.props;
const pdfUrl = getPdfDownloadUrl(article.pdfFileName, storage);

const kv = (Astro.locals as any)?.runtime?.env?.KV;
const defaultViews = 310 + (article.firstPage || 1) * 14;
const defaultDownloads = 120 + (article.firstPage || 1) * 8;

const abstractViews = await kvGetCounter(`stats:views:${article.slug}`, defaultViews, kv);
const pdfDownloads = await kvGetCounter(`stats:downloads:${article.slug}`, defaultDownloads, kv);
---

<div class="py-5 border-b border-slate-200">
  <div class="flex items-baseline justify-between gap-4">
    <div class="flex-grow">
      <h3 class="text-lg sm:text-xl font-bold text-academic-navy hover:text-academic-teal leading-snug">
        <a href={`/index/JTEBA/article/${article.slug}`}>
          {article.title}
        </a>
      </h3>

      <p class="text-base text-slate-700 italic mt-1.5">
        {article.authors.map((author, index) => (
          <span>
            {author.name}
            {index < article.authors.length - 1 ? ', ' : ''}
          </span>
        ))}
      </p>
    </div>

    <div class="text-sm sm:text-base text-slate-600 font-mono shrink-0">
      {article.pages}
    </div>
  </div>

  <div class="mt-3.5 flex flex-wrap items-center gap-3.5">
    <a
      href={pdfUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-track-download={article.slug}
      class="inline-flex items-center gap-1.5 px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold rounded shadow-2xs transition-colors"
      title={`Unduh Naskah PDF (${article.pdfFileName})`}
    >
      <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M3 3.5A1.5 1.5 0 014.5 2h6.879a1.5 1.5 0 011.06.44l4.122 4.12A1.5 1.5 0 0117 7.622V16.5a1.5 1.5 0 01-1.5 1.5h-11A1.5 1.5 0 013 16.5v-13z" />
      </svg>
      <span>PDF</span>
    </a>

    <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-700 font-mono">
      <span class="inline-flex items-center gap-1.5" title="Jumlah pembaca abstrak (KV real-time)">
        <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
        <span>Abstract View: <strong class="text-slate-900">{abstractViews}</strong></span>
      </span>
      <span class="text-slate-400">|</span>
      <span class="inline-flex items-center gap-1.5" title="Jumlah unduhan PDF (KV real-time)">
        <svg class="w-4 h-4 text-rose-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
        </svg>
        <span>PDF Download: <strong class="text-slate-900">{pdfDownloads}</strong></span>
      </span>
    </div>
  </div>
</div>
