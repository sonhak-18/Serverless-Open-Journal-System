---
import { getCachedSettings, getCachedIndexing } from '../lib/kv';
import type { JournalConfig } from '../config/journal';

interface Props {
  journalConfig?: JournalConfig;
}
import { issnToEan13, generateEan13BarcodeSvgBars } from '../lib/issn';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const kv = (Astro.locals as any)?.runtime?.env?.KV;
const journalConfig = Astro.props.journalConfig || await getCachedSettings(kv, d1);
const indexingList = await getCachedIndexing(kv, d1);
const rawWaNum = journalConfig.submission?.whatsappNumber || journalConfig.submission?.whatsappDisplay || '628981822777';
const cleanWaPhone = rawWaNum.replace(/\D/g, '');
const waMsg = journalConfig.submission?.whatsappDefaultMessage || 'Halo Dewan Redaksi, saya ingin berkonsultasi mengenai publikasi naskah.';
const waUrl = `https://wa.me/${cleanWaPhone}?text=${encodeURIComponent(waMsg)}`;

const showEditorial = journalConfig.features?.showEditorialTeam !== false;

const sidebarLinks = [
  { label: 'Focus and Scope', href: '/index/journal/guidelines#focus-scope' },
  ...(showEditorial ? [
    { label: 'Editorial Team', href: '/index/journal/editorial-team' },
    { label: 'Peer Reviewers', href: '/index/journal/editorial-team#reviewers' },
  ] : []),
  { label: 'Author Guidelines', href: '/index/journal/guidelines#author-guidelines' },
  { label: 'Peer Review Process', href: '/index/journal/guidelines#review-process' },
  { label: 'Publication Ethics', href: '/index/journal/guidelines#ethics' },
  { label: 'Plagiarism Policy', href: '/index/journal/guidelines#plagiarism' },
  { label: 'Journal Template', href: '/index/journal/guidelines#template' },
  { label: 'Abstracting and Indexing', href: '/index/journal/indexing' },
  { label: 'Online Submission', href: '/index/journal/submit' },
  { label: 'Search / Cari Artikel', href: '/index/journal/search' },
];

const sidebarIndexers = indexingList.filter((idx) => idx.showInSidebar);
const templateUrl = journalConfig.branding?.templateUrl || '/template-manuskrip.docx';
const isExternalTemplate = templateUrl.startsWith('http://') || templateUrl.startsWith('https://');
---

<aside class="space-y-6" aria-label="Sidebar Standardisasi Jurnal">
  <div class="space-y-1">
    {sidebarLinks.map((item) => (
      <a
        href={item.href}
        class="group w-full py-2.5 px-3.5 text-sm font-semibold text-white bg-[#0f284e] hover:bg-[#183e6d] border border-[#0a1a33] rounded-sm transition-colors shadow-2xs flex items-center justify-between"
      >
        <span>{item.label}</span>
        <svg class="w-3.5 h-3.5 text-slate-300 group-hover:text-amber-300 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    ))}
  </div>

  <div class="border border-slate-300 bg-white p-3 rounded-sm shadow-2xs">
    <div class="text-xs font-bold text-slate-800 mb-2">
      Pencarian Artikel:
    </div>
    <form action="/index/journal/search" method="GET" class="flex gap-1.5">
      <input
        type="search"
        name="query"
        placeholder="Kata kunci, judul, penulis..."
        class="flex-grow px-2.5 py-1.5 text-xs border border-slate-300 rounded-sm text-slate-800 focus:outline-none focus:border-[#16707a] bg-white"
      />
      <button
        type="submit"
        class="px-3 py-1.5 bg-[#0f284e] hover:bg-[#183e6d] text-white text-xs font-semibold rounded-sm transition-colors flex items-center justify-center"
        title="Cari"
      >
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
        </svg>
      </button>
    </form>
  </div>

  <div class="border border-slate-300 bg-white p-3 rounded-sm">
    <div class="text-xs font-bold italic text-slate-800 mb-2">
      Template:
    </div>
    <a
      href="/api/template"
      download={`Template_Naskah_${journalConfig.shortName}.docx`}
      class="flex items-center gap-3 p-3 border border-slate-200 bg-slate-50 hover:bg-slate-100 rounded-sm transition-colors group shadow-2xs"
      title="Unduh Template Manuskrip Word (.docx)"
    >
      <div class="w-12 h-14 bg-white border border-slate-300 group-hover:border-blue-500 rounded flex flex-col items-center justify-between p-1.5 shadow-xs shrink-0 transition-colors">
        <svg class="w-6 h-6 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <span class="text-xs font-bold font-mono text-blue-800 bg-blue-50 px-1 rounded-xs">DOCX</span>
      </div>

      <div class="flex-grow">
        <span class="block text-sm font-bold text-slate-900 group-hover:text-blue-800 leading-tight">
          Article Template
        </span>
        <span class="text-xs text-slate-600 block mt-0.5">Format Naskah Resmi (.docx)</span>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-700 group-hover:underline mt-1.5">
          <svg class="w-3.5 h-3.5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
          </svg>
          <span>Unduh Berkas (.docx)</span>
        </span>
      </div>
    </a>
  </div>

  {journalConfig.features.showIssnBlock && (() => {
    // Nomor p-ISSN digunakan sebagai basis barcode cetak standar serial terbitan berkala
    const targetIssn = journalConfig.pIssn || journalConfig.eIssn || '2999-7119';
    const { ean13, formatted: eanFormatted } = issnToEan13(targetIssn);
    const { rects } = generateEan13BarcodeSvgBars(ean13);

    return (
      <div class="border border-slate-300 bg-white rounded-sm overflow-hidden shadow-2xs">
        <div class="bg-[#0f284e] text-white text-xs font-bold py-1.5 px-3 flex items-center justify-between">
          <span>ISSN</span>
          <span class="text-xs font-medium text-slate-200 font-mono">ISO 3297</span>
        </div>
        <div class="p-3.5 text-center space-y-2.5">
          <div class="text-xs font-bold text-slate-800 flex items-center justify-center gap-1.5 flex-wrap">
            <span class="text-slate-600 font-medium">e-ISSN:</span>
            <span class="font-mono text-academic-navy bg-slate-50 px-2 py-0.5 rounded border border-slate-200">
              {journalConfig.eIssn}
            </span>
            <span class="text-xs text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded font-semibold border border-emerald-200">Online</span>
          </div>

          <div class="inline-block p-2 bg-white border border-slate-200 rounded">
            <svg class="h-14 w-44 mx-auto" viewBox="0 0 160 52" fill="currentColor">
              {rects.map((r) => (
                <rect x={r.x} y={r.y} width={r.width} height={r.height} />
              ))}
              <text x="80" y="48" font-size="10" text-anchor="middle" font-family="'Courier New', Courier, monospace" font-weight="bold" letter-spacing="1.5">
                {eanFormatted}
              </text>
            </svg>
          </div>

          <div class="text-xs font-bold text-slate-800 flex items-center justify-center gap-1.5 flex-wrap">
            <span class="text-slate-600 font-normal">p-ISSN:</span>
            <span class="font-mono text-slate-800 bg-slate-50 px-2 py-0.5 rounded border border-slate-200">
              {journalConfig.pIssn}
            </span>
            <span class="text-xs text-blue-800 bg-blue-50 px-1.5 py-0.5 rounded font-semibold border border-blue-200">Print</span>
          </div>
        </div>
      </div>
    );
  })()}

  {journalConfig.features.showToolsBlock && (
    <div class="border border-slate-300 bg-white p-3 rounded-sm">
      <div class="text-xs font-bold italic text-slate-800 mb-2">
        Recommended Tools :
      </div>
      <div class="space-y-2">
        <a
          href="https://www.mendeley.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Mendeley Reference Manager"
        >
          <span class="font-bold text-red-900 text-sm tracking-widest font-serif flex items-center gap-1 group-hover:scale-102 transition-transform">
            <span class="text-base text-red-800 font-sans">●●</span> MENDELEY
          </span>
        </a>

        <a
          href="https://www.zotero.org"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Zotero Reference Assistant"
        >
          <span class="font-bold text-slate-900 text-sm flex items-center gap-1.5 group-hover:scale-102 transition-transform">
            <span class="w-5 h-5 rounded-xs bg-[#c9261f] text-white text-xs flex items-center justify-center font-serif font-black">Z</span>
            <span class="font-sans font-bold tracking-tight text-slate-800">zotero</span>
          </span>
        </a>

        <a
          href="https://www.grammarly.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Grammarly Writing Assistant"
        >
          <span class="font-bold text-emerald-700 text-sm flex items-center gap-1.5 group-hover:scale-102 transition-transform">
            <span class="w-5 h-5 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center font-bold">G</span>
            <span>grammarly</span>
          </span>
        </a>

        <a
          href="https://endnote.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi EndNote Clarivate"
        >
          <span class="font-bold text-blue-900 text-sm tracking-wide group-hover:scale-102 transition-transform">
            EndNote.
          </span>
        </a>
      </div>
    </div>
  )}

  <div class="border border-slate-300 bg-white p-3 rounded-sm">
    <div class="text-xs font-bold italic text-slate-800 mb-2">
      Plagiarism Tool :
    </div>
    <a
      href="https://www.turnitin.com"
      target="_blank"
      rel="noopener noreferrer"
      class="p-2.5 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center gap-2 rounded transition-colors group"
      title="Pemeriksaan Kemiripan Turnitin"
    >
      <img
        src="/images/turnitin.jpg"
        alt="Turnitin Logo"
        class="w-6 h-6 object-contain shrink-0"
      />
      <span class="font-bold text-slate-900 text-base font-serif tracking-tight">
        turnitin
      </span>
    </a>
  </div>

  {journalConfig.features.showIndexingBlock && (
    <div class="border border-slate-300 bg-white rounded-sm overflow-hidden">
      <div class="bg-[#0f284e] text-white text-xs font-bold py-1.5 px-3">
        Indexed by :
      </div>
      <div class="p-3 bg-white space-y-2.5">
        {sidebarIndexers.length > 0 ? (
          sidebarIndexers.map((idx) => (
            <a
              href={idx.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block p-2 border border-slate-200 hover:border-slate-400 bg-white text-center rounded-xs transition-colors"
              title={`Kunjungi ${idx.name}`}
            >
              {idx.iconUrl ? (
                <div class="flex items-center justify-center gap-2 py-0.5">
                  <img src={idx.iconUrl} alt={idx.name} class="max-h-6 max-w-[110px] object-contain" />
                  <span class="font-bold text-xs text-slate-800 tracking-tight">{idx.name}</span>
                </div>
              ) : idx.name === 'Google Scholar' ? (
                <span class="font-bold text-sm tracking-wide">
                  <span class="text-blue-600">G</span><span class="text-red-500">o</span><span class="text-amber-500">o</span><span class="text-blue-600">g</span><span class="text-emerald-500">l</span><span class="text-red-500">e</span>
                  <span class="text-slate-600 font-serif italic ml-1">Scholar</span>
                </span>
              ) : idx.name.includes('Garuda') ? (
                <span class="font-bold text-xs tracking-wider text-red-700">
                  GARUDA <span class="text-xs text-slate-600 font-normal">(Garba Rujukan Digital)</span>
                </span>
              ) : idx.name.includes('Crossref') ? (
                <span class="font-bold text-xs tracking-wide text-slate-800">
                  Crossref <span class="text-xs text-slate-600 font-mono font-normal">DOI Member</span>
                </span>
              ) : (
                <span class="font-bold text-xs tracking-wide text-cyan-800">
                  {idx.name}
                </span>
              )}
            </a>
          ))
        ) : (
          <p class="text-xs text-slate-500 italic text-center py-2">Belum ada pengindeks yang diaktifkan.</p>
        )}

        <div class="pt-1 text-center">
          <a href="/index/journal/indexing" class="inline-flex items-center justify-center gap-1 text-xs text-blue-700 hover:underline font-semibold min-h-[32px]">
            <span>Lihat Seluruh Pengindeks ({sidebarIndexers.length})</span>
            <svg class="w-3.5 h-3.5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  )}

  <div class="border border-slate-300 bg-white rounded-sm overflow-hidden">
    <div class="bg-[#0f284e] text-white text-xs font-bold py-1.5 px-3">
      Secretariat
    </div>
    <div class="p-3 text-xs text-slate-700 space-y-2 leading-relaxed">
      <div>
        <strong class="block text-slate-900">Editor and Administration Address:</strong>
        <p class="mt-0.5 text-slate-600">{journalConfig.institution}</p>
        <p class="text-slate-600">{journalConfig.publisher}</p>
        <p class="text-slate-600">{journalConfig.address}</p>
      </div>

      <div class="pt-2 border-t border-slate-200 space-y-1">
        <p>
          <span class="text-slate-500">Email:</span>{' '}
          <!--email_off-->
          <a href={`mailto:${journalConfig.submission.email}`} class="text-blue-700 hover:underline font-mono">
            {journalConfig.submission.email}
          </a>
          <!--/email_off-->
        </p>
        <p>
          <span class="text-slate-500">WhatsApp Redaksi:</span>{' '}
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline font-semibold">
            {journalConfig.submission.whatsappDisplay}
          </a>
        </p>
      </div>
    </div>
  </div>
</aside>
