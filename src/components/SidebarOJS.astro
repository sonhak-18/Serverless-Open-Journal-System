---
import { journalConfig, getWhatsAppSubmissionUrl } from '../config/journal';

const waUrl = getWhatsAppSubmissionUrl();

const sidebarLinks = [
  { label: 'Focus and Scope', href: '/guidelines#focus-scope' },
  { label: 'Editorial Team', href: '/editorial-team' },
  { label: 'Peer Reviewers', href: '/editorial-team#reviewers' },
  { label: 'Author Guidelines', href: '/guidelines#author-guidelines' },
  { label: 'Peer Review Process', href: '/guidelines#review-process' },
  { label: 'Publication Ethics', href: '/guidelines#ethics' },
  { label: 'Plagiarism Policy', href: '/guidelines#plagiarism' },
  { label: 'Journal Template', href: '/guidelines#template' },
  { label: 'Abstracting and Indexing', href: '/indexing' },
  { label: 'Online Submission', href: '/submit' },
];

const sidebarIndexers = journalConfig.indexing.filter((idx) => idx.showInSidebar);
---

<aside class="space-y-6" aria-label="Sidebar Standarisasi Jurnal">
  <!-- 1. Menu Standarisasi OJS (Stacked Blue Buttons) -->
  <div class="space-y-1">
    {sidebarLinks.map((item) => (
      <a
        href={item.href}
        class="block w-full py-2 px-3 text-xs font-semibold text-white bg-[#1e4a7a] hover:bg-[#153457] border border-[#183c63] rounded-sm transition-colors shadow-xs"
      >
        {item.label}
      </a>
    ))}
  </div>

  <!-- 2. Kotak Template Naskah (Modern Material Design Icon) -->
  <div class="border border-slate-300 bg-white p-3 rounded-sm">
    <div class="text-xs font-bold italic text-slate-800 mb-2">
      Template:
    </div>
    <a
      href="/guidelines#template"
      class="flex items-center gap-3 p-3 border border-slate-200 bg-slate-50 hover:bg-slate-100 rounded-sm transition-colors group shadow-2xs"
      title="Unduh Template Manuskrip Word (.docx)"
    >
      <!-- Material Design File Document Icon -->
      <div class="w-11 h-12 bg-white border border-slate-300 group-hover:border-blue-500 rounded flex flex-col items-center justify-between p-1.5 shadow-xs shrink-0 transition-colors">
        <svg class="w-6 h-6 text-blue-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <!-- Material description/article icon -->
          <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
        </svg>
        <span class="text-[9px] font-bold font-mono text-blue-800 bg-blue-50 px-1 rounded-2xs">DOCX</span>
      </div>

      <div class="flex-grow">
        <span class="block text-xs font-bold text-slate-900 group-hover:text-blue-800 leading-tight">
          Article Template
        </span>
        <span class="text-[11px] text-slate-500 block mt-0.5">Format Naskah Resmi (.docx)</span>
        <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-blue-700 group-hover:underline mt-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>Unduh Berkas</span>
        </span>
      </div>
    </a>
  </div>

  <!-- 3. Kotak ISSN & Barcode -->
  {journalConfig.features.showIssnBlock && (
    <div class="border border-slate-300 bg-white rounded-sm overflow-hidden">
      <div class="bg-[#1e4a7a] text-white text-xs font-bold py-1 px-3">
        ISSN
      </div>
      <div class="p-4 text-center">
        <div class="text-xs font-bold text-slate-700 mb-2">
          e-ISSN: {journalConfig.eIssn}
        </div>
        <div class="inline-block p-2 bg-white border border-slate-200">
          <svg class="h-12 w-44 mx-auto" viewBox="0 0 160 50" fill="currentColor">
            <rect x="0" y="0" width="3" height="40" />
            <rect x="5" y="0" width="2" height="40" />
            <rect x="10" y="0" width="4" height="40" />
            <rect x="17" y="0" width="2" height="40" />
            <rect x="22" y="0" width="5" height="40" />
            <rect x="30" y="0" width="2" height="40" />
            <rect x="35" y="0" width="3" height="40" />
            <rect x="41" y="0" width="4" height="40" />
            <rect x="48" y="0" width="2" height="40" />
            <rect x="53" y="0" width="3" height="40" />
            <rect x="59" y="0" width="5" height="40" />
            <rect x="67" y="0" width="2" height="40" />
            <rect x="72" y="0" width="3" height="40" />
            <rect x="78" y="0" width="4" height="40" />
            <rect x="85" y="0" width="2" height="40" />
            <rect x="90" y="0" width="4" height="40" />
            <rect x="97" y="0" width="3" height="40" />
            <rect x="103" y="0" width="2" height="40" />
            <rect x="108" y="0" width="5" height="40" />
            <rect x="116" y="0" width="3" height="40" />
            <rect x="122" y="0" width="2" height="40" />
            <rect x="127" y="0" width="4" height="40" />
            <rect x="134" y="0" width="3" height="40" />
            <rect x="140" y="0" width="2" height="40" />
            <rect x="145" y="0" width="5" height="40" />
            <rect x="153" y="0" width="3" height="40" />
            <text x="80" y="49" font-size="9" text-anchor="middle" font-family="monospace">9 773048 289007</text>
          </svg>
        </div>
        <div class="text-[11px] text-slate-500 mt-1">
          p-ISSN: {journalConfig.pIssn}
        </div>
      </div>
    </div>
  )}

  <!-- 4. Kotak Tools Referensi & Penulisan -->
  {journalConfig.features.showToolsBlock && (
    <div class="border border-slate-300 bg-white p-3 rounded-sm">
      <div class="text-xs font-bold italic text-slate-800 mb-2">
        Recommended Tools :
      </div>
      <div class="space-y-2">
        <a
          href="https://www.mendeley.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Mendeley Reference Manager"
        >
          <span class="font-bold text-red-900 text-sm tracking-widest font-serif flex items-center gap-1 group-hover:scale-102 transition-transform">
            <span class="text-base text-red-800 font-sans">●●</span> MENDELEY
          </span>
        </a>

        <a
          href="https://www.zotero.org"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Zotero Reference Assistant"
        >
          <span class="font-bold text-slate-900 text-sm flex items-center gap-1.5 group-hover:scale-102 transition-transform">
            <span class="w-4 h-4 rounded-xs bg-[#c9261f] text-white text-[11px] flex items-center justify-center font-serif font-black">Z</span>
            <span class="font-sans font-bold tracking-tight text-slate-800">zotero</span>
          </span>
        </a>

        <a
          href="https://www.grammarly.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi Grammarly Writing Assistant"
        >
          <span class="font-bold text-emerald-700 text-sm flex items-center gap-1.5 group-hover:scale-102 transition-transform">
            <span class="w-4 h-4 rounded-full bg-emerald-600 text-white text-[10px] flex items-center justify-center font-bold">G</span>
            <span>grammarly</span>
          </span>
        </a>

        <a
          href="https://endnote.com"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center rounded transition-colors group"
          title="Kunjungi EndNote Clarivate"
        >
          <span class="font-bold text-blue-900 text-sm tracking-wide group-hover:scale-102 transition-transform">
            EndNote.
          </span>
        </a>
      </div>
    </div>
  )}

  <!-- 5. Kotak Plagiarisme -->
  <div class="border border-slate-300 bg-white p-3 rounded-sm">
    <div class="text-xs font-bold italic text-slate-800 mb-2">
      Plagiarism Tool :
    </div>
    <a
      href="https://www.turnitin.com"
      target="_blank"
      rel="noopener noreferrer"
      class="p-2.5 border border-slate-200 hover:border-slate-400 bg-slate-50 hover:bg-slate-100 flex items-center justify-center gap-2 rounded transition-colors group"
      title="Pemeriksaan Kemiripan Turnitin"
    >
      <img
        src="/images/turnitin.jpg"
        alt="Turnitin Logo"
        class="w-6 h-6 object-contain shrink-0"
      />
      <span class="font-bold text-slate-900 text-base font-serif tracking-tight">
        turnitin
      </span>
    </a>
  </div>

  <!-- 6. Kotak Indexing (Indexed By - Bersih Tanpa Bocor Setup Link) -->
  {journalConfig.features.showIndexingBlock && (
    <div class="border border-slate-300 bg-white rounded-sm overflow-hidden">
      <div class="bg-[#1e4a7a] text-white text-xs font-bold py-1.5 px-3">
        Indexed by :
      </div>
      <div class="p-3 bg-white space-y-2.5">
        {sidebarIndexers.map((idx) => (
          <a
            href={idx.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-2 border border-slate-200 hover:border-slate-400 bg-white text-center rounded-xs transition-colors"
            title={`Kunjungi ${idx.name}`}
          >
            {idx.name === 'Google Scholar' ? (
              <span class="font-bold text-sm tracking-wide">
                <span class="text-blue-600">G</span><span class="text-red-500">o</span><span class="text-amber-500">o</span><span class="text-blue-600">g</span><span class="text-emerald-500">l</span><span class="text-red-500">e</span>
                <span class="text-slate-600 font-serif italic ml-1">Scholar</span>
              </span>
            ) : idx.name.includes('Garuda') ? (
              <span class="font-bold text-xs tracking-wider text-red-700">
                GARUDA <span class="text-[10px] text-slate-500 font-normal">(Garba Rujukan Digital)</span>
              </span>
            ) : idx.name.includes('Crossref') ? (
              <span class="font-bold text-xs tracking-wide text-slate-800">
                Crossref <span class="text-[10px] text-slate-500 font-mono font-normal">DOI Member</span>
              </span>
            ) : (
              <span class="font-bold text-xs tracking-wide text-cyan-800">
                {idx.name}
              </span>
            )}
          </a>
        ))}

        <div class="pt-1 text-center">
          <a href="/indexing" class="text-[11px] text-blue-700 hover:underline font-medium">
            Lihat Seluruh Pengindeks ({journalConfig.indexing.length})
          </a>
        </div>
      </div>
    </div>
  )}

  <!-- 7. Kotak Secretariat (Alamat & Kontak Redaksi) -->
  <div class="border border-slate-300 bg-white rounded-sm overflow-hidden">
    <div class="bg-[#1e4a7a] text-white text-xs font-bold py-1.5 px-3">
      Secretariat
    </div>
    <div class="p-3 text-xs text-slate-700 space-y-2 leading-relaxed">
      <div>
        <strong class="block text-slate-900">Editor and Administration Address:</strong>
        <p class="mt-0.5 text-slate-600">{journalConfig.institution}</p>
        <p class="text-slate-600">{journalConfig.publisher}</p>
        <p class="text-slate-600">{journalConfig.address}</p>
      </div>

      <div class="pt-2 border-t border-slate-200 space-y-1">
        <p>
          <span class="text-slate-500">Email:</span>{' '}
          <a href={`mailto:${journalConfig.submission.email}`} class="text-blue-700 hover:underline font-mono">
            {journalConfig.submission.email}
          </a>
        </p>
        <p>
          <span class="text-slate-500">WhatsApp Redaksi:</span>{' '}
          <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-700 hover:underline font-semibold">
            {journalConfig.submission.whatsappDisplay}
          </a>
        </p>
      </div>
    </div>
  </div>
</aside>
