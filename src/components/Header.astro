---
import { getDbSettings } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/current', label: 'Current' },
  { href: '/archives', label: 'Archives' },
  { href: '/editorial-team', label: 'Editorial Team' },
  { href: '/guidelines', label: 'Guidelines & Ethics' },
  { href: '/indexing', label: 'Abstracting & Indexing' },
  { href: '/submit', label: 'Submissions' },
];
---

<header class="border-b border-slate-300 bg-white">
  <!-- Topmost Access Bar (Register / Login / Editorial Panel) -->
  <div class="bg-[#1b4332] text-slate-200 text-xs py-1.5 px-4 border-b border-[#143225]">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="text-[11px] text-emerald-200">
        <span>{journalConfig.publisher}</span>
        <span class="mx-1">/</span>
        <span>{journalConfig.institution}</span>
      </div>
      <div class="flex items-center space-x-3 text-xs">
        <a href="/submit" class="hover:text-white transition-colors">Submit Paper</a>
        <span class="text-emerald-500">|</span>
        <a href="/admin" rel="nofollow" class="hover:text-white font-medium text-emerald-100 transition-colors">
          Panel Redaksi (Admin)
        </a>
      </div>
    </div>
  </div>

  <!-- Main OJS Journal Header Banner (Matching Image 2) -->
  <div class="bg-[#1f543c] text-white py-6 px-4">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <!-- Journal Logo (Original Colors & Transparent Background) -->
        <a href="/" class="flex-shrink-0 group" title={`Beranda ${journalConfig.name}`}>
          <img
            src="/images/logo.png"
            alt={`Logo ${journalConfig.shortName}`}
            class="h-12 md:h-14 w-auto object-contain group-hover:opacity-90 transition-opacity"
          />
        </a>

        <!-- Title & Subtitles -->
        <div class="border-l border-white/20 pl-4">
          <a href="/" class="hover:underline">
            <h1 class="text-xl md:text-2xl font-serif font-bold text-white tracking-wide leading-tight">
              {journalConfig.name}
            </h1>
          </a>
          <p class="text-xs md:text-sm text-emerald-100 font-serif italic mt-0.5">
            {journalConfig.nameEn}
          </p>
          <div class="flex flex-wrap items-center gap-2 text-xs text-emerald-200 mt-1">
            <span>{journalConfig.accreditedText}</span>
            <span>•</span>
            <span class="font-mono">e-ISSN {journalConfig.eIssn}</span>
            <span>•</span>
            <span class="font-mono">p-ISSN {journalConfig.pIssn}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Classic OJS Horizontal Navigation Menu Bar -->
  <nav class="bg-[#2d3748] text-white text-xs border-b border-slate-700" aria-label="Navigasi Utama OJS">
    <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
      <!-- Desktop Links -->
      <ul class="hidden md:flex flex-wrap items-center font-medium">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class={`inline-block py-2.5 px-4 transition-colors border-r border-slate-600/50 ${
                  isActive
                    ? 'bg-[#1a202c] text-white font-bold'
                    : 'text-slate-200 hover:bg-[#1a202c] hover:text-white'
                }`}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>

      <div class="hidden md:flex items-center text-xs text-slate-300">
        <a href="/submit" class="py-2.5 px-3 bg-[#b45309] hover:bg-[#92400e] text-white font-bold transition-colors">
          Submit Naskah
        </a>
      </div>

      <!-- Mobile Menu Toggle Button (tap target >= 44px) -->
      <div class="md:hidden py-1 flex items-center justify-between w-full">
        <span class="text-xs uppercase font-semibold text-slate-300">Menu Jurnal</span>
        <button
          type="button"
          id="ojs-mobile-menu-btn"
          class="p-2 text-slate-200 hover:text-white focus:outline-none min-w-[44px] min-h-[44px] flex items-center justify-center"
          aria-expanded="false"
          aria-controls="ojs-mobile-menu"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="ojs-mobile-menu" class="hidden md:hidden bg-[#1a202c] px-4 py-2 border-t border-slate-700 space-y-1">
      {navLinks.map((link) => {
        const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block py-2.5 px-3 text-sm rounded ${
              isActive ? 'bg-emerald-800 text-white font-bold' : 'text-slate-300 hover:bg-slate-800'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('ojs-mobile-menu-btn');
  const menu = document.getElementById('ojs-mobile-menu');

  btn?.addEventListener('click', () => {
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      btn?.focus();
    }
  });
</script>
