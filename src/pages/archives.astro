---
import Layout from '../layouts/Layout.astro';
import { journalConfig } from '../config/journal';
import { issues, getArticlesByIssue } from '../data/articles';
---

<Layout title="Arsip Edisi" description={`Arsip seluruh volume dan edisi terbitan ilmiah ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="border-b border-academic-border pb-6 mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-academic-crimson">
        Koleksi Publikasi
      </span>
      <h1 class="text-3xl font-serif font-bold text-academic-navy mt-1">
        Arsip Terbitan Berkala
      </h1>
      <p class="text-sm text-academic-ink-muted mt-2 max-w-3xl">
        Seluruh volume dan nomor terbitan {journalConfig.name} diarsipkan secara permanen dan dapat diakses secara terbuka tanpa batasan langganan.
      </p>
    </div>

    <!-- Daftar Edisi -->
    <div class="space-y-6">
      {issues.map((issue) => {
        const issueArticles = getArticlesByIssue(issue.volume, issue.issue);
        return (
          <div class="academic-card p-6 rounded border border-academic-border bg-white">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
              <div class="flex items-center gap-2">
                <span class="text-sm font-serif font-bold text-academic-navy">
                  Volume {issue.volume} Nomor {issue.issue} ({issue.year})
                </span>
                {issue.isCurrent && (
                  <span class="academic-badge bg-emerald-100 text-emerald-800 text-xs">
                    Terkini
                  </span>
                )}
              </div>
              <span class="text-xs text-slate-500">
                Terbit: {issue.monthRange}
              </span>
            </div>

            <p class="text-xs text-academic-ink-muted mt-3">
              {issue.description}
            </p>

            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs text-slate-500">
                {issueArticles.length} Naskah Diterbitkan
              </span>

              <a
                href={issue.isCurrent ? '/current' : `/archives#vol-${issue.volume}-no-${issue.issue}`}
                class="inline-flex items-center text-xs font-semibold text-academic-crimson hover:underline"
              >
                Buka Edisi Ini →
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
