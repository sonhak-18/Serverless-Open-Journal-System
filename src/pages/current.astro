---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import ArticleItemOJS from '../components/ArticleItemOJS.astro';
import { getDbSettings, getDbArticles } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const allArticles = await getDbArticles(d1);

const curVolume = journalConfig.currentIssue?.volume ?? 1;
const curIssue = journalConfig.currentIssue?.issue ?? 1;
const curYear = journalConfig.currentIssue?.year ?? 2026;
const curPeriod = journalConfig.currentIssue?.period || 'Maret 2026';
const curTheme = journalConfig.currentIssue?.theme || 'Edisi Perdana: Inovasi Audit, Akuntansi Keberlanjutan & Modernisasi Sistem Perpajakan';

const currentArticles = allArticles.filter(a => a.volume === curVolume && a.issue === curIssue);
const displayArticles = currentArticles.length > 0 ? currentArticles : allArticles;
---

<Layout title="Current Issue" description={`Terbitan terkini ${journalConfig.name} - Vol. ${curVolume} No. ${curIssue}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Edisi Terkini (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>Current Issue</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-xl md:text-2xl font-serif font-bold text-slate-900">
            Vol. {curVolume} No. {curIssue} ({curYear}): {curPeriod}
          </h1>
          {curTheme && (
            <p class="text-xs text-slate-600 italic mt-0.5">
              Tema: {curTheme}
            </p>
          )}
        </div>

        <!-- Detail Terbitan & Cover -->
        <div class="p-4 border border-slate-200 bg-white rounded-xs flex flex-col sm:flex-row gap-5 items-start">
          <div class="w-32 shrink-0 border border-slate-300 shadow-xs bg-[#0f284e] text-white p-3.5 flex flex-col justify-between aspect-[3/4] text-center rounded-2xs">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest block text-[#c89b3c]">JTAAP</span>
              <span class="text-xs font-bold mt-2 block leading-tight">
                JURNAL TERBUKA AUDIT, AKUNTANSI, PAJAK
              </span>
            </div>
            <div class="text-[10px] text-slate-300 border-t border-[#c89b3c]/40 pt-1 font-mono">
              Vol. {curVolume} No. {curIssue} ({curYear})
            </div>
          </div>

          <div class="text-xs text-slate-700 space-y-2 leading-relaxed">
            <p>{curTheme}</p>
            <div class="pt-2 text-[11px] text-slate-600 border-t border-slate-100 space-y-1">
              <div>
                <strong>DOI Edisi:</strong>{' '}
                <a href={`https://doi.org/${journalConfig.doiPrefix}.v${curVolume}i${curIssue}`} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                  https://doi.org/{journalConfig.doiPrefix}.v${curVolume}i${curIssue}
                </a>
              </div>
              <div>
                <strong>Periode:</strong> {curPeriod} ({curYear})
              </div>
            </div>
          </div>
        </div>

        <!-- Daftar Naskah OJS -->
        <div class="mt-8 space-y-2">
          <div class="border-b-2 border-amber-600 pb-1 flex justify-between items-baseline">
            <h2 class="text-base font-serif font-bold text-slate-900">
              Articles
            </h2>
            <span class="text-xs text-slate-500">
              {displayArticles.length} Naskah
            </span>
          </div>

          <div class="divide-y divide-slate-200">
            {displayArticles.map((article) => (
              <ArticleItemOJS article={article} />
            ))}
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
