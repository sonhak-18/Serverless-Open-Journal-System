---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import { getDbSettings, getDbIndexing } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const indexing = await getDbIndexing(d1);
---

<Layout title="Abstracting and Indexing" description={`Daftar pengindeks dan pangkalan data bibliografis ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Kolom Utama (Kiri ~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Breadcrumb OJS -->
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>Abstracting and Indexing</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-academic-navy">
            Abstracting and Indexing
          </h1>
        </div>

        <p class="text-base sm:text-lg text-slate-800 leading-relaxed">
          {journalConfig.name} ({journalConfig.shortName}) berkomitmen untuk meningkatkan keterlihatan (*visibility*) dan keterjangkauan naskah ilmiah melalui pangkalan data akademik bereputasi nasional dan internasional. Seluruh artikel yang diterbitkan dipersiapkan dengan metadata sitasi standar untuk perayap mesin ilmiah.
        </p>

        <!-- Daftar Pengindeks Terstruktur -->
        <div class="space-y-4">
          {indexing.length > 0 ? (
            indexing.map((item) => (
              <div class="p-6 border border-slate-200 bg-white rounded shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="space-y-2">
                  <div class="flex items-center gap-3">
                    {item.iconUrl && (
                      <img
                        src={item.iconUrl}
                        alt={item.name}
                        class="w-10 h-10 object-contain rounded bg-slate-50 p-1 border border-slate-200 shrink-0"
                      />
                    )}
                    <div class="flex flex-wrap items-center gap-2.5">
                      <h3 class="text-lg sm:text-xl font-bold text-academic-navy">
                        <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                          {item.name}
                        </a>
                      </h3>
                      <span class={`text-xs font-bold px-2.5 py-0.5 rounded uppercase tracking-wider ${
                        item.status === 'Indexed'
                          ? 'bg-emerald-100 text-emerald-800'
                          : item.status === 'In Process'
                          ? 'bg-blue-100 text-blue-800'
                          : 'bg-amber-100 text-amber-800'
                      }`}>
                        {item.status}
                      </span>
                    </div>
                  </div>
                  <p class="text-base text-slate-700 leading-relaxed">
                    {item.description}
                  </p>
                  <div class="text-sm text-slate-600 font-mono">
                    URL Portal: <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-academic-teal hover:underline font-semibold">{item.url}</a>
                  </div>
                </div>

                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-sm font-bold rounded border border-slate-300 text-center shrink-0 transition-colors"
                >
                  Kunjungi Portal ↗
                </a>
              </div>
            ))
          ) : (
            <div class="p-8 border border-dashed border-slate-300 rounded bg-slate-50 text-center text-sm text-slate-500 italic">
              Belum ada pangkalan data pengindeks yang didaftarkan. Pengindeks dapat ditambahkan melalui panel admin.
            </div>
          )}
        </div>

        <!-- Panduan Pengaturan Indexing untuk Admin & Redaksi -->
        <div class="border border-slate-300 bg-slate-50 p-6 rounded mt-8 space-y-4 shadow-2xs">
          <h2 class="text-xl sm:text-2xl font-bold text-academic-navy border-b-2 border-slate-200 pb-2">
            Pengaturan & Verifikasi Pengindeksan Mandiri
          </h2>
          <p class="text-base sm:text-lg text-slate-800 leading-relaxed">
            Untuk mendaftarkan atau memverifikasi pengindeksan artikel baru di mesin pencari akademik:
          </p>
          <ul class="text-base sm:text-lg text-slate-800 space-y-3.5 list-disc list-inside leading-relaxed">
            <li>
              <strong>Google Scholar:</strong> Sistem sudah menyertakan tag sitasi lengkap (`citation_title`, `citation_pdf_url`, `citation_journal_title`). Google Scholar akan secara otomatis merayap situs ini dalam 1-2 minggu setelah domain terhubung.
            </li>
            <li>
              <strong>Pendaftaran Garuda (Kemdikbud):</strong> Daftarkan OAI-PMH feed atau tautan halaman arsip jurnal ke portal Garuda setelah memiliki minimal 2 nomor terbitan reguler.
            </li>
            <li>
              <strong>Crossref / DOI:</strong> Pastikan metadata artikel menyertakan prefix DOI valid. Penulis dan pembaca dapat memverifikasi tautan naskah melalui resolusi resmi `doi.org`.
            </li>
          </ul>
        </div>
      </main>

      <!-- Kolom Sidebar Kanan (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
