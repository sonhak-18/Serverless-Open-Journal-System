---
import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import { journalConfig } from '../config/journal';
---

<Layout title="404 - Halaman Tidak Ditemukan" description="Halaman atau naskah ilmiah yang Anda tuju tidak ditemukan.">
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <main class="lg:col-span-8 space-y-6">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>404 Not Found</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-academic-navy">
            404 - Halaman Tidak Ditemukan
          </h1>
        </div>

        <div class="p-8 border border-slate-300 bg-white rounded shadow-2xs space-y-4">
          <p class="text-base text-slate-700 leading-relaxed">
            Mohon maaf, naskah atau laman yang Anda cari tidak dapat ditemukan pada repositori publikasi <strong>{journalConfig.name}</strong>.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed">
            Kemungkinan penyebab:
          </p>
          <ul class="list-disc list-inside text-sm text-slate-600 space-y-1 pl-2">
            <li>Tautan atau pengidentifikasi objek digital (DOI) salah diketik.</li>
            <li>Naskah sedang dalam tahap pemutakhiran dewan redaksi atau telah ditarik kembali.</li>
            <li>Struktur arsip terbitan telah diperbarui.</li>
          </ul>

          <div class="pt-4 border-t border-slate-200 flex flex-wrap gap-3">
            <a
              href="/"
              class="px-4 py-2 bg-academic-navy text-white text-sm font-semibold rounded hover:bg-slate-800 transition-colors inline-block"
            >
              Kembali ke Beranda
            </a>
            <a
              href="/archives"
              class="px-4 py-2 bg-slate-100 text-academic-navy border border-slate-300 text-sm font-semibold rounded hover:bg-slate-200 transition-colors inline-block"
            >
              Jelajahi Arsip Terbitan
            </a>
          </div>
        </div>
      </main>

      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
