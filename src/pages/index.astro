---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getDbSettings, getDbArticles, getDbPortalSettings } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const allArticles = await getDbArticles(d1);
const portal = await getDbPortalSettings(d1);

const curVolume = journalConfig.currentIssue?.volume ?? 1;
const curIssue = journalConfig.currentIssue?.issue ?? 1;
const curYear = journalConfig.currentIssue?.year ?? 2026;

const cacheBuster = '20261017v2';
const withVersion = (url?: string) => {
  if (!url || url.startsWith('data:') || url.includes('?v=')) return url;
  return `${url}?v=${cacheBuster}`;
};
---

<Layout 
  title={portal.orgName}
  exactTitle={true}
  description={portal.description}
  faviconUrl={withVersion(portal.faviconUrl || '/favicon-jteba.png')}
  showHeader={false}
  showFooter={false}
>
  <!-- TOP UTILITY BAR -->
  <div class="bg-[#07172e] text-slate-300 text-xs py-2 px-4 border-b border-[#0f2c59]/80">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <div class="flex items-center gap-2 font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span class="text-slate-200 tracking-wide font-semibold">PRANITI INSTITUTE</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400 italic">{portal.orgName}</span>
      </div>
      <div class="flex items-center gap-4 text-xs">
        <span class="font-mono text-slate-400 bg-white/5 px-2 py-0.5 rounded border border-white/10">
          {portal.domainDisplay}
        </span>
      </div>
    </div>
  </div>

  <!-- MODERN NAVIGATION BAR -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-50 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 py-3.5 flex items-center justify-between gap-4">
      <!-- Official Logo Brand (Prominent & Crisp) -->
      <a href="/" class="flex items-center gap-3 group py-1" title={`Beranda ${portal.orgName}`}>
        <img
          src={withVersion(portal.logoUrl || '/images/logo-praniti.png')}
          alt={`Logo Resmi ${portal.orgName}`}
          class="h-12 sm:h-14 md:h-16 w-auto object-contain transition-transform group-hover:scale-[1.02]"
        />
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-6 text-sm font-semibold text-slate-700">
        <a href="#journals" class="hover:text-[#0f2c59] transition-colors">Jurnal Ilmiah</a>
        <a href="#about" class="hover:text-[#0f2c59] transition-colors">Profil Organisasi</a>
        <a href="#values" class="hover:text-[#0f2c59] transition-colors">Nilai PRANITI</a>
        <a href="#programs" class="hover:text-[#0f2c59] transition-colors">Klaster Riset</a>
      </div>

      <!-- Quick Action Button to Flagship Journal -->
      <div class="flex items-center gap-2.5">
        <a
          href={portal.flagshipJournalUrl || '/index/JTEBA'}
          class="px-4 py-2 bg-[#0f2c59] hover:bg-[#183e6d] text-white text-xs font-bold rounded shadow-xs transition-all flex items-center gap-1.5"
        >
          <span>Kunjungi JTEBA</span>
          <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- MODERN HERO BANNER (Clean, Prestigious, Academic Elegance) -->
  <header class="bg-gradient-to-b from-slate-900 via-[#0b2040] to-[#0f2c59] text-white py-8 sm:py-16 md:py-20 px-4 relative overflow-hidden">
    <!-- Subtle Geometric Glow Background -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,rgba(30,86,49,0.22),transparent_45%),radial-gradient(circle_at_80%_70%,rgba(200,155,60,0.15),transparent_45%)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10 space-y-8">
      <div class="max-w-3xl space-y-4">
        <!-- Live Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 backdrop-blur-md border border-white/15 rounded-full text-xs font-semibold tracking-wider text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Portal Gerbang Penerbit Ilmiah Mandiri</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight">
          {portal.orgName}
        </h1>
        <p class="text-base sm:text-xl text-slate-200 font-light tracking-wide">
          {portal.orgNameEn}
        </p>

        <!-- Slogan Resmi Tagline Card -->
        <div class="p-4 sm:p-5 bg-white/5 border border-white/15 rounded-xl backdrop-blur-md space-y-1.5 border-l-4 border-l-[#c89b3c]">
          <div class="text-base sm:text-lg font-bold text-amber-300 tracking-wide">
            "{portal.sloganId}"
          </div>
          <div class="text-xs sm:text-sm text-slate-300 italic">
            "{portal.sloganEn}"
          </div>
        </div>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed pt-1">
          {portal.description}
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-3">
          <a
            href="#journals"
            class="px-5 py-3 bg-[#c89b3c] hover:bg-[#b0842b] text-slate-900 font-bold text-xs uppercase tracking-wider rounded shadow-md transition-all flex items-center gap-2"
          >
            <span>Daftar Jurnal Berkala</span>
            <svg class="w-4 h-4 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </a>
          <a
            href="/index/JTEBA"
            class="px-5 py-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold text-xs uppercase tracking-wider rounded transition-all flex items-center gap-2"
          >
            <span>Buka Jurnal JTEBA</span>
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 4 HIGHLIGHT PILL CARDS (Modern Grid) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4 border-t border-white/10">
        <div class="p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm space-y-1">
          <div class="text-emerald-400 font-bold text-xs flex items-center gap-1.5 uppercase tracking-wider">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Open Access</span>
          </div>
          <div class="text-sm font-semibold text-white">Akses Terbuka Penuh</div>
          <p class="text-xs text-slate-300">Bebas diakses, dibaca, dan diunduh tanpa pembatasan biaya bagi pembaca.</p>
        </div>

        <div class="p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm space-y-1">
          <div class="text-emerald-400 font-bold text-xs flex items-center gap-1.5 uppercase tracking-wider">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>COPE Compliant</span>
          </div>
          <div class="text-sm font-semibold text-white">Integritas Akademik</div>
          <p class="text-xs text-slate-300">Menolak manipulasi data, fabrikasi naskah, dan praktik rekayasa sitasi.</p>
        </div>

        <div class="p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm space-y-1">
          <div class="text-emerald-400 font-bold text-xs flex items-center gap-1.5 uppercase tracking-wider">
            <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Hak Cipta Penulis</span>
          </div>
          <div class="text-sm font-semibold text-white">Lisensi CC BY-SA 4.0</div>
          <p class="text-xs text-slate-300">Penulis memegang hak cipta penuh atas manuskrip yang dipublikasikan.</p>
        </div>

        <div class="p-4 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm space-y-1">
          <div class="text-amber-300 font-bold text-xs flex items-center gap-1.5 uppercase tracking-wider font-mono">
            <svg class="w-4 h-4 text-amber-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z" />
            </svg>
            <span>Domain Resmi</span>
          </div>
          <div class="text-sm font-semibold text-white font-mono">ejournal.praniti.or.id</div>
          <p class="text-xs text-slate-300">Infrastruktur penerbitan OJS 3 terpusat dan berkecepatan tinggi.</p>
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN OPEN GATE CONTENT BODY -->
  <main class="max-w-7xl mx-auto px-4 py-16 space-y-20">

    <!-- SECTION 1: PUSAT PUBLIKASI JURNAL BERKALA ILMIAH -->
    <section id="journals" class="space-y-8 scroll-mt-24">
      <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-slate-200 pb-4 gap-3">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#967028] font-mono block">
            Journal Publishing Cluster
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#0f2c59] mt-1">
            Pusat Publikasi Jurnal Berkala Ilmiah
          </h2>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 max-w-md">
          Pengelolaan jurnal elektronik berbasis sistem penelaahan sejawat ganda (<em class="text-slate-800">double-blind peer review</em>) taat asas.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
        <!-- KARTU JURNAL UTAMA: JTEBA (Modern Rework) -->
        <article class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-all flex flex-col justify-between overflow-hidden">
          <div class="p-6 sm:p-8 space-y-6">
            <!-- Header Badge Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-100">
              <div class="flex flex-wrap items-center gap-2">
                <span class="px-3 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold rounded-full flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  <span>Open Access</span>
                </span>
                {journalConfig.features?.hasActiveIssue ? (
                  <span class="px-3 py-1 bg-blue-50 text-blue-800 border border-blue-200 text-xs font-bold rounded-full font-mono">
                    Vol. {curVolume} No. {curIssue} ({curYear})
                  </span>
                ) : (
                  <span class="px-3 py-1 bg-blue-50 text-blue-800 border border-blue-200 text-xs font-bold rounded-full">
                    Menuju Edisi Perdana
                  </span>
                )}
                <span class="px-3 py-1 bg-amber-50 text-amber-900 border border-amber-200 text-xs font-bold rounded-full">
                  Call for Papers
                </span>
              </div>
              <span class="text-xs font-mono font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded border border-slate-200">
                Singkatan: JTEBA
              </span>
            </div>

            <!-- Title & Subtitle with Emblem -->
            <div class="flex items-start gap-4">
              <img
                src={withVersion(portal.flagshipJournalEmblemUrl || '/favicon-jteba.png')}
                alt={`Emblem Resmi ${portal.flagshipJournalName}`}
                class="w-14 h-14 rounded-xl border border-slate-200 shadow-xs object-contain shrink-0 hidden sm:block bg-white p-1.5"
              />
              <div class="space-y-1">
                <h3 class="text-2xl sm:text-3xl font-bold text-[#0f2c59] leading-snug">
                  <a href={portal.flagshipJournalUrl || '/index/JTEBA'} class="hover:text-emerald-700 transition-colors">
                    {portal.flagshipJournalName || 'JTEBA: Jurnal Terbuka Ekonomi, Bisnis, dan Akuntabilitas'}
                  </a>
                </h3>
                <p class="text-sm sm:text-base text-slate-500 italic font-medium">
                  {portal.flagshipJournalEn || 'Open Journal of Economics, Business, and Accountability'}
                </p>
              </div>
            </div>

            <!-- Focus & Scope Pillars Grid -->
            <div class="space-y-2.5 pt-2">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-700">
                Fokus dan Ruang Lingkup Publikasi (Focus & Scope):
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
                <div class="p-3.5 bg-emerald-50/60 border border-emerald-200 rounded-xl space-y-1">
                  <strong class="text-emerald-950 font-bold block text-sm">A. Akuntansi Keberlanjutan & ESG</strong>
                  <p class="text-slate-700 leading-relaxed text-xs">
                    Sustainability reporting (GRI, IFRS S1 & S2), pengungkapan ESG, akuntansi lingkungan & karbon.
                  </p>
                </div>

                <div class="p-3.5 bg-amber-50/60 border border-amber-200 rounded-xl space-y-1">
                  <strong class="text-amber-950 font-bold block text-sm">B. Perpajakan & Kebijakan Fiskal</strong>
                  <p class="text-slate-700 leading-relaxed text-xs">
                    Tax compliance, tax avoidance, pajak karbon, perpajakan ekonomi digital & kebijakan fiskal makro.
                  </p>
                </div>

                <div class="p-3.5 bg-blue-50/60 border border-blue-200 rounded-xl space-y-1">
                  <strong class="text-blue-950 font-bold block text-sm">C. Auditing, Forensik & Tata Kelola</strong>
                  <p class="text-slate-700 leading-relaxed text-xs">
                    Audit quality, fraud investigation, whistleblowing system, dan Good Corporate Governance (GCG).
                  </p>
                </div>

                <div class="p-3.5 bg-indigo-50/60 border border-indigo-200 rounded-xl space-y-1">
                  <strong class="text-indigo-950 font-bold block text-sm">D. Dinamika Ekonomi & Bisnis Terapan</strong>
                  <p class="text-slate-700 leading-relaxed text-xs">
                    Kinerja korporasi, kewirausahaan hijau, keuangan digital/fintech, dan UMKM berkelanjutan.
                  </p>
                </div>
              </div>
            </div>

            <!-- Extra Metadata Row -->
            <div class="flex flex-wrap items-center gap-y-2 gap-x-5 text-xs text-slate-600 pt-2 border-t border-slate-100">
              <div><strong>Frekuensi Terbit:</strong> {journalConfig.publicationFrequency || '4 Kali/Tahun (Maret, Juni, September, Desember)'}</div>
              <div><strong>Penelaahan:</strong> Double-Blind Peer Review</div>
              <div><strong>Penerbit:</strong> {journalConfig.publisher}</div>
              {journalConfig.features?.showIssnBlock && (
                <>
                  <div><strong>e-ISSN:</strong> <span class="font-mono text-slate-800 font-semibold">{journalConfig.eIssn}</span> (Online)</div>
                  <div><strong>p-ISSN:</strong> <span class="font-mono text-slate-800 font-semibold">{journalConfig.pIssn}</span> (Print)</div>
                </>
              )}
            </div>
          </div>

          <!-- Bottom Action Buttons Cluster -->
          <div class="bg-slate-50 border-t border-slate-200 p-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
              <a
                href="/index/JTEBA"
                class="px-4 py-2.5 bg-[#0f2c59] hover:bg-[#183e6d] text-white text-xs font-bold rounded-lg shadow-xs transition-colors flex items-center gap-1.5"
              >
                <span>Lihat Jurnal (View Journal)</span>
                <svg class="w-3.5 h-3.5 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a
                href="/index/JTEBA/current"
                class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-800 font-semibold text-xs rounded-lg transition-colors"
              >
                Terbitan Terkini
              </a>
              <a
                href="/index/JTEBA/archives"
                class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-800 font-semibold text-xs rounded-lg transition-colors"
              >
                Arsip
              </a>
              <a
                href="/index/JTEBA/guidelines"
                class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-800 font-semibold text-xs rounded-lg transition-colors"
              >
                Pedoman Penulis
              </a>
              <a
                href="/index/JTEBA/search"
                class="px-3.5 py-2.5 bg-white border border-slate-300 hover:bg-slate-100 text-slate-800 font-semibold text-xs rounded-lg transition-colors flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
                <span>Cari Artikel</span>
              </a>
            </div>

            <a
              href="/index/JTEBA/submit"
              class="w-full sm:w-auto text-center px-4 py-2.5 bg-[#c89b3c] hover:bg-[#b0842b] text-slate-900 font-bold text-xs uppercase tracking-wider rounded-lg shadow-xs transition-colors flex items-center justify-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4.5v15m7.5-7.5h-15" />
              </svg>
              <span>Kirim Naskah (Submit)</span>
            </a>
          </div>
        </article>

        <!-- KARTU JURNAL INTIATIF (FORTHCOMING) -->
        <article class="lg:col-span-4 bg-gradient-to-br from-slate-50 to-slate-100/80 border border-slate-200 border-dashed rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between gap-2 border-b border-slate-200 pb-3">
              <span class="px-2.5 py-0.5 bg-purple-100 text-purple-900 border border-purple-200 text-xs font-bold rounded-full">
                Segera Hadir
              </span>
              <span class="text-xs font-mono text-slate-500">Forthcoming</span>
            </div>

            <div class="space-y-1">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500 block">Lini Bahasa & Sastra Inggris</span>
              <h3 class="text-xl font-bold text-slate-800 leading-snug">
                Journal of English Studies, Applied Linguistics, and Literature
              </h3>
              <p class="text-xs text-slate-600 italic font-medium">
                Wadah Telaah Kritis Bahasa, Linguistik Terapan, dan Sastra Inggris
              </p>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Praniti tengah menyiapkan wadah publikasi berkala mandiri untuk mengkaji kritik sastra (Literary Criticism), analisis wacana kritis (Critical Discourse Analysis), studi penerjemahan, serta komunikasi bisnis internasional.
            </p>

            <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs text-slate-700 space-y-1.5">
              <div class="font-bold text-slate-900 text-xs">Cakupan Inisiatif:</div>
              <ul class="list-disc list-inside space-y-1 text-slate-700 text-xs">
                <li>Kritik Sastra & Sastra Bandingan</li>
                <li>Linguistik Terapan & Sosiolinguistik</li>
                <li>Analisis Wacana & Retorika Korporasi</li>
                <li>English for Specific Purposes (ESP)</li>
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-200">
            <div class="p-3 bg-purple-50/80 rounded-xl border border-purple-200 text-center text-xs text-purple-950 font-medium">
              Tahap persiapan dewan editorial & sistem OJS.
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- SECTION 2: FILOSOFI & ETIMOLOGI PRANITI -->
    <section id="about" class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-xs space-y-6 scroll-mt-24">
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-[#967028] font-mono block">
          Etymology & Philosophical Foundation
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f2c59] mt-1">
          Filosofi & Arti Nama Praniti (प्रणीति)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
        <!-- Sanskerta Callout -->
        <div class="md:col-span-5 bg-gradient-to-br from-[#0f2c59] to-[#184687] text-white p-7 sm:p-8 rounded-2xl shadow-sm space-y-4">
          <div class="text-4xl sm:text-5xl text-amber-300 font-bold">
            प्रणीति
          </div>
          <h3 class="text-lg font-bold text-white">
            Praniti (Sanskerta / Khazanah Klasik)
          </h3>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-light">
            Mengandung makna tindakan menuntun, kepemimpinan yang arif (<em class="text-amber-200 font-normal">guided conduct</em>), kebijaksanaan terarah, serta penyusunan karya secara saksama dan beraturan.
          </p>
        </div>

        <div class="md:col-span-7 space-y-4 text-slate-700 text-sm sm:text-base leading-relaxed">
          <p>
            Secara filosofis akademik, <strong>Organisasi Riset dan Publikasi Ilmiah Praniti</strong> berkedudukan sebagai kompas moral dan intelektual yang mengarahkan akademisi, peneliti, dan praktisi dalam melahirkan karya ilmiah yang sahih secara metodologis, mandiri, akuntabel, serta memberikan kemaslahatan nyata bagi peradaban dan literasi global.
          </p>
          <div class="p-4 bg-slate-50 border-l-4 border-l-[#0f2c59] rounded-r-xl text-xs sm:text-sm text-slate-800 space-y-1.5">
            <strong class="text-[#0f2c59] block font-bold text-sm">Visi Organisasi:</strong>
            <blockquote class="italic leading-relaxed text-slate-700">
              "Menjadi organisasi riset dan penerbitan ilmiah independen terkemuka yang menjunjung tinggi keterbukaan ilmu (open science), integritas akademik, serta keunggulan multidisiplin pada rumpun ilmu ekonomi-bisnis berkelanjutan dan humaniora-sastra di tingkat nasional maupun internasional."
            </blockquote>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: 7 NILAI DASAR P-R-A-N-I-T-I (Modern Grid) -->
    <section id="values" class="space-y-6 scroll-mt-24">
      <div class="border-b border-slate-200 pb-4">
        <span class="text-xs font-bold uppercase tracking-wider text-[#967028] font-mono block">
          Core Values
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-[#0f2c59] mt-1">
          Tujuh Nilai Dasar — P-R-A-N-I-T-I
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Prinsip fundamental yang memandu setiap kebijakan editorial dan riset terapan organisasi.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- P -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              P
            </span>
            <h3 class="text-base font-bold text-slate-900">Profesional</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Berkomitmen penuh pada standar baku tata kelola penerbitan ilmiah, objektivitas penelaahan sejawat, dan ketepatan periodisitas terbitan.
          </p>
        </div>

        <!-- R -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              R
            </span>
            <h3 class="text-base font-bold text-slate-900">Resik & Transparan</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Menolak segala bentuk manipulasi data, fabrikasi karya, rekayasa sitasi, serta praktik publikasi yang mencederai integritas etika ilmiah.
          </p>
        </div>

        <!-- A -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              A
            </span>
            <h3 class="text-base font-bold text-slate-900">Akuntabel</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Memastikan setiap naskah, laporan riset, dan kebijakan editorial dapat dipertanggungjawabkan metodologi, keabsahan data, serta rujukannya.
          </p>
        </div>

        <!-- N -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              N
            </span>
            <h3 class="text-base font-bold text-slate-900">Nalar Kritis</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Menempatkan ketajaman analisis logis, objektivitas berpikir, dan kemandirian ilmiah di atas segala kepentingan pragmatis golongan.
          </p>
        </div>

        <!-- I -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              I
            </span>
            <h3 class="text-base font-bold text-slate-900">Inklusif & Terbuka</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Menyediakan ruang berekspresi ilmiah yang setara bagi setiap akademisi, peneliti mandiri, maupun praktisi tanpa sekat senioritas atau asal institusi.
          </p>
        </div>

        <!-- T -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              T
            </span>
            <h3 class="text-base font-bold text-slate-900">Tanggap Isu Kontemporer</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Responsif terhadap dinamika global, khususnya krisis lingkungan (akuntansi hijau & ESG), etika fiskal/bisnis, hingga perkembangan bahasa dan sastra digital.
          </p>
        </div>

        <!-- I (Inovatif) Span Full -->
        <div class="p-5 bg-white border border-slate-200 rounded-xl shadow-2xs hover:border-[#0f2c59] transition-all space-y-2 sm:col-span-2 lg:col-span-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-lg bg-[#0f2c59] text-amber-300 font-bold text-lg flex items-center justify-center shrink-0 shadow-2xs">
              I
            </span>
            <h3 class="text-base font-bold text-slate-900">Inovatif</h3>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Memanfaatkan infrastruktur teknologi informasi secara optimal dalam tata kelola alur kerja editorial, preservasi digital, serta standarisasi metadata global (Crossref/DOI).
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 4: MISI ORGANISASI & PILAR PROGRAM KLASTER -->
    <section id="programs" class="grid grid-cols-1 md:grid-cols-12 gap-8 scroll-mt-24">
      <!-- 5 Misi Utama -->
      <div class="md:col-span-6 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-xs space-y-5">
        <div class="border-b border-slate-100 pb-3">
          <span class="text-xs font-mono font-bold uppercase text-[#967028]">Mission</span>
          <h3 class="text-xl font-bold text-[#0f2c59] mt-0.5">5 Misi Utama Organisasi</h3>
        </div>
        <ol class="space-y-3.5 text-xs sm:text-sm text-slate-700 leading-relaxed list-decimal list-inside pl-1">
          {portal.missions && portal.missions.map((mission) => {
            const parts = mission.split(':');
            return parts.length > 1 ? (
              <li><strong>{parts[0]}:</strong>{parts.slice(1).join(':')}</li>
            ) : (
              <li>{mission}</li>
            );
          })}
        </ol>
      </div>

      <!-- Klaster Riset B & C -->
      <div class="md:col-span-6 space-y-5">
        <!-- Klaster B -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-2.5">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <span class="text-xs font-mono font-bold text-[#967028] uppercase">Klaster B</span>
            <span class="text-xs text-slate-500 font-mono">Interdisciplinary Research</span>
          </div>
          <h4 class="text-base font-bold text-slate-900">Riset Terapan & Kajian Antardisiplin</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Mengkaji titik temu antara komunikasi bisnis internasional, narasi korporasi (corporate narrative disclosure), retorika pengungkapan laporan ESG, analisis semiotika laporan tahunan, serta penyusunan ringkasan kebijakan (Policy Briefs).
          </p>
        </div>

        <!-- Klaster C -->
        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs space-y-2.5">
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
            <span class="text-xs font-mono font-bold text-[#967028] uppercase">Klaster C</span>
            <span class="text-xs text-slate-500 font-mono">Academic Capacity & Services</span>
          </div>
          <h4 class="text-base font-bold text-slate-900">Pengembangan Kapasitas & Layanan Bahasa</h4>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Lokakarya tata kelola sistem OJS 3, etika publikasi ilmiah internasional, pendampingan penulisan artikel ilmiah (academic writing), uji kemiripan teks (similarity check), serta penyuntingan naskah (copyediting & proofreading).
          </p>
        </div>
      </div>
    </section>

  </main>

