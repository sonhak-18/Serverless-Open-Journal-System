---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import ArticleItemOJS from '../components/ArticleItemOJS.astro';
import { getDbSettings, getDbArticles } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const allArticles = await getDbArticles(d1);

const curVolume = journalConfig.currentIssue?.volume ?? 1;
const curIssue = journalConfig.currentIssue?.issue ?? 1;
const curYear = journalConfig.currentIssue?.year ?? 2026;
const curPeriod = journalConfig.currentIssue?.period || 'Maret 2026';
const curTheme = journalConfig.currentIssue?.theme || 'Edisi Perdana: Inovasi Audit, Akuntansi Keberlanjutan & Modernisasi Sistem Perpajakan';
const curCoverUrl = journalConfig.currentIssue?.coverUrl || '';

const currentArticles = allArticles.filter(a => a.volume === curVolume && a.issue === curIssue);
const displayArticles = currentArticles.length > 0 ? currentArticles : allArticles;
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Konten Utama Jurnal (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Pengumuman Redaksi dari Database -->
        {journalConfig.announcement?.active && (
          <div class="p-5 sm:p-6 bg-amber-50/70 border border-amber-200/80 rounded space-y-2 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-100 px-2.5 py-0.5 rounded">
                Pengumuman Redaksi
              </span>
              <span class="text-xs text-slate-500 font-mono">
                {journalConfig.announcement.date}
              </span>
            </div>
            <h2 class="text-lg sm:text-xl font-serif font-bold text-academic-navy pt-0.5">
              {journalConfig.announcement.title}
            </h2>
            <p class="text-base sm:text-lg text-slate-800 leading-relaxed pt-1">
              {journalConfig.announcement.content}
            </p>
          </div>
        )}

        <!-- Bagian Current Issue -->
        <div class="space-y-4">
          <div class="border-b-2 border-academic-gold pb-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
              Current Issue
            </span>
            <h2 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-0.5">
              Vol. {curVolume} No. {curIssue} ({curYear}): {curPeriod}
            </h2>
            {curTheme && (
              <p class="text-base text-slate-700 italic mt-1">
                Tema: {curTheme}
              </p>
            )}
          </div>

          <!-- Cover Jurnal & Metadata Terbitan -->
          <div class="p-6 border border-slate-200 bg-white rounded flex flex-col sm:flex-row gap-6 items-start shadow-2xs">
            {curCoverUrl ? (
              <img
                src={curCoverUrl}
                alt={`Cover ${journalConfig.shortName} Vol. ${curVolume} No. ${curIssue}`}
                class="w-36 sm:w-40 shrink-0 border border-slate-300 shadow-xs aspect-[3/4] object-cover rounded"
              />
            ) : (
              <!-- Cover Mockup Jurnal (Academic Navy & Gold) -->
              <div class="w-36 sm:w-40 shrink-0 border border-slate-300 shadow-xs bg-[#0f284e] text-white p-4 flex flex-col justify-between aspect-[3/4] text-center rounded">
                <div>
                  <span class="text-xs font-bold uppercase tracking-widest block text-[#c89b3c]">JTAAP</span>
                  <span class="text-xs font-bold mt-2.5 block leading-tight">
                    JURNAL TERBUKA AUDIT, AKUNTANSI, PAJAK
                  </span>
                </div>
                <div class="text-xs text-slate-300 border-t border-[#c89b3c]/40 pt-1 font-mono">
                  Vol. {curVolume} No. {curIssue} ({curYear})
                </div>
              </div>
            )}

            <!-- Deskripsi & Info Resmi Terbitan -->
            <div class="text-base text-slate-800 space-y-3 leading-relaxed">
              <p>
                <strong>{journalConfig.name} ({journalConfig.shortName})</strong> adalah jurnal ilmiah telaah sejawat (*peer-reviewed*) yang mempublikasikan hasil riset teoretis dan empiris di bidang pemeriksaan akuntansi, pelaporan keuangan, dan perpajakan.
              </p>
              <p class="text-slate-700">
                {curTheme}
              </p>
              <div class="pt-3 text-sm text-slate-600 border-t border-slate-100 space-y-1.5">
                <div>
                  <strong>DOI Edisi:</strong>{' '}
                  <a href={`https://doi.org/${journalConfig.doiPrefix}.v${curVolume}i${curIssue}`} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                    https://doi.org/{journalConfig.doiPrefix}.v{curVolume}i{curIssue}
                  </a>
                </div>
                <div>
                  <strong>Periode Publikasi:</strong> {curPeriod} ({curYear})
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Daftar Artikel (Articles Header dengan Garis Emas Akademik) -->
        <div class="mt-8 space-y-3">
          <div class="border-b-2 border-academic-gold pb-1.5 flex justify-between items-baseline">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Articles
            </h2>
            <span class="text-xs sm:text-sm text-slate-500 font-medium">
              {displayArticles.length} Naskah Terbit
            </span>
          </div>

          <!-- List Item Artikel OJS -->
          <div class="divide-y divide-slate-200">
            {displayArticles.map((article) => (
              <ArticleItemOJS article={article} />
            ))}
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi Jurnal (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
