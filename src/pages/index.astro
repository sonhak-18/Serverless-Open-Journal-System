---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import ArticleItemOJS from '../components/ArticleItemOJS.astro';
import { getDbSettings, getDbArticles } from '../lib/db';
import { getCurrentIssue } from '../data/articles';

const journalConfig = await getDbSettings();
const allArticles = await getDbArticles();
const currentIssue = getCurrentIssue();
const currentArticles = allArticles.filter(a => a.volume === currentIssue.volume && a.issue === currentIssue.issue);
---

<Layout>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Konten Utama Jurnal (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Pengumuman Singkat / Status Jurnal (Persis OJS Image 2) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-4 border-b border-slate-200">
          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xs">
            <h2 class="text-xs font-serif font-bold text-[#1b3d6d]">
              Penerbitan Edisi Perdana JTAAP (Volume 1 Nomor 1)
            </h2>
            <span class="text-[10px] text-slate-500 font-mono block mt-0.5">2026-03-30</span>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed line-clamp-3">
              Dewan Redaksi mengundang akademisi, peneliti, dan praktisi untuk mengakses naskah riset terbitan terkini mengenai audit berbasis risiko, Coretax, dan ESG.
            </p>
          </div>

          <div class="p-4 bg-slate-50 border border-slate-200 rounded-xs">
            <h2 class="text-xs font-serif font-bold text-[#1b3d6d]">
              Pemberitahuan Penyerahan Manuskrip
            </h2>
            <span class="text-[10px] text-slate-500 font-mono block mt-0.5">2026-03-15</span>
            <p class="text-xs text-slate-600 mt-1 leading-relaxed line-clamp-3">
              Penulis dapat mengajukan manuskrip melalui jalur penyerahan naskah daring atau melalui kontak langsung dengan sekretariat redaksi.
            </p>
          </div>
        </div>

        <!-- Bagian Current Issue (Persis OJS Image 2) -->
        <div class="space-y-4">
          <div class="border-b-2 border-amber-600 pb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
              Current Issue
            </span>
            <h2 class="text-lg md:text-xl font-serif font-bold text-slate-900 mt-0.5">
              Vol. {currentIssue.volume} No. {currentIssue.issue} ({currentIssue.year}): {currentIssue.monthRange}
            </h2>
          </div>

          <!-- Cover Jurnal & Metadata Terbitan -->
          <div class="p-4 border border-slate-200 bg-white rounded-xs flex flex-col sm:flex-row gap-5 items-start">
            <!-- Cover Mockup Jurnal OJS -->
            <div class="w-32 sm:w-36 shrink-0 border border-slate-300 shadow-xs bg-[#1f543c] text-white p-3 flex flex-col justify-between aspect-[3/4] text-center">
              <div>
                <span class="text-[9px] uppercase tracking-widest block text-emerald-200">JTAAP</span>
                <span class="text-xs font-serif font-bold mt-2 block leading-tight">
                  JURNAL TERBUKA AUDIT, AKUNTANSI, PAJAK
                </span>
              </div>
              <div class="text-[8px] text-emerald-100 border-t border-emerald-600/60 pt-1">
                Vol. {currentIssue.volume} No. {currentIssue.issue} ({currentIssue.year})
              </div>
            </div>

            <!-- Deskripsi & Info Resmi Terbitan -->
            <div class="text-xs text-slate-700 space-y-2 leading-relaxed">
              <p>
                <strong>{journalConfig.name} ({journalConfig.shortName})</strong> adalah jurnal ilmiah telaah sejawat (*peer-reviewed*) yang mempublikasikan hasil riset teoretis dan empiris di bidang pemeriksaan akuntansi, pelaporan keuangan, dan perpajakan.
              </p>
              <p class="text-slate-600">
                {currentIssue.description}
              </p>
              <div class="pt-2 text-[11px] text-slate-600 border-t border-slate-100 space-y-1">
                <div>
                  <strong>DOI Edisi:</strong>{' '}
                  <a href={`https://doi.org/${journalConfig.doiPrefix}.v1i1`} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                    https://doi.org/{journalConfig.doiPrefix}.v1i1
                  </a>
                </div>
                <div>
                  <strong>Tanggal Terbit:</strong> {new Date(currentIssue.publishDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Daftar Artikel (Articles Header dengan Garis Oranye Khas OJS Image 1) -->
        <div class="mt-8 space-y-2">
          <div class="border-b-2 border-amber-600 pb-1 flex justify-between items-baseline">
            <h2 class="text-base font-serif font-bold text-slate-900">
              Articles
            </h2>
            <span class="text-xs text-slate-500">
              {currentArticles.length} Naskah Terbit
            </span>
          </div>

          <!-- List Item Artikel OJS -->
          <div class="divide-y divide-slate-200">
            {currentArticles.map((article) => (
              <ArticleItemOJS article={article} />
            ))}
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi Jurnal (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
