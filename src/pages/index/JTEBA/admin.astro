        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Edisi terbitan aktif berhasil disimpan ke database D1!');
      } else {
        showToast('Gagal menyimpan edisi: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menyimpan edisi: ' + err.message, true);
    }
  });

  // Simpan Pengumuman / Announcement
  const formAnnouncement = document.getElementById('form-announcement-settings');
  formAnnouncement?.addEventListener('submit', async (e) => {
    e.preventDefault();
    sessionStorage.setItem('jteba_active_tab', 'tab-announcement-settings');
    const data = {
      announcementActive: (document.getElementById('cfg-ann-active') as HTMLInputElement).checked,
      announcementTitle: (document.getElementById('cfg-ann-title') as HTMLInputElement).value,
      announcementDate: (document.getElementById('cfg-ann-date') as HTMLInputElement).value,
      announcementContent: (document.getElementById('cfg-ann-content') as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Pengumuman redaksi berhasil disimpan ke database D1!');
      } else {
        showToast('Gagal menyimpan pengumuman: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menyimpan pengumuman: ' + err.message, true);
    }
  });

  // Pengaturan kontak dan metadata jurnal
  const formContact = document.getElementById('form-contact-settings');
  formContact?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = {
      whatsappNumber: (document.getElementById('cfg-wa-num') as HTMLInputElement).value,
      whatsappDisplay: (document.getElementById('cfg-wa-display') as HTMLInputElement).value,
      whatsappMessage: (document.getElementById('cfg-wa-msg') as HTMLInputElement).value,
      email: (document.getElementById('cfg-email') as HTMLInputElement).value,
      resendApiKey: (document.getElementById('cfg-resend-key') as HTMLInputElement)?.value.trim() ?? '',
      showIndexingBlock: (document.getElementById('toggle-idx') as HTMLInputElement).checked,
      showToolsBlock: (document.getElementById('toggle-tools') as HTMLInputElement).checked,
      showIssnBlock: (document.getElementById('toggle-issn') as HTMLInputElement).checked,
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Seluruh data kontak & pengaturan jurnal berhasil disimpan ke database!');
      }
    } catch (err: any) {
      showToast('Gagal menyimpan kontak: ' + err.message, true);
    }
  });

  // Toggle lihat/sembunyikan Resend API Key
  const btnToggleKey = document.getElementById('btn-toggle-resend-key');
  const keyInput = document.getElementById('cfg-resend-key') as HTMLInputElement | null;
  const eyeOpen = document.getElementById('eye-icon-open');
  const eyeClosed = document.getElementById('eye-icon-closed');
  btnToggleKey?.addEventListener('click', () => {
    if (!keyInput) return;
    const isPass = keyInput.type === 'password';
    keyInput.type = isPass ? 'text' : 'password';
    if (eyeOpen && eyeClosed) {
      if (isPass) {
        eyeOpen.classList.remove('hidden');
        eyeClosed.classList.add('hidden');
      } else {
        eyeOpen.classList.add('hidden');
        eyeClosed.classList.remove('hidden');
      }
    }
  });

  // Tombol Uji Coba Pengiriman Resend Email
  const btnTestEmail = document.getElementById('btn-test-email') as HTMLButtonElement | null;
  const testEmailFeedback = document.getElementById('test-email-feedback');
  btnTestEmail?.addEventListener('click', async () => {
    const resendKeyInput = document.getElementById('cfg-resend-key') as HTMLInputElement;
    const emailInput = document.getElementById('cfg-email') as HTMLInputElement;
    const apiKey = resendKeyInput?.value.trim() || '';
    const email = emailInput?.value.trim() || '';

    if (!apiKey) {
      if (testEmailFeedback) {
        testEmailFeedback.className = 'mt-2 text-xs p-2.5 rounded border bg-amber-50 text-amber-800 border-amber-200 block';
        testEmailFeedback.textContent = 'Silakan masukkan Resend API Key Anda (diawali "re_") terlebih dahulu sebelum melakukan pengujian.';
      }
      resendKeyInput?.focus();
      return;
    }

    const origHtml = btnTestEmail.innerHTML;
    btnTestEmail.disabled = true;
    btnTestEmail.innerHTML = '<span class="inline-block animate-spin mr-1">↻</span> Mengirim surel uji coba...';
    if (testEmailFeedback) {
      testEmailFeedback.className = 'mt-2 text-xs p-2.5 rounded border bg-blue-50 text-blue-800 border-blue-200 block';
      testEmailFeedback.textContent = 'Sedang mengirim surel uji coba ke ' + (email || 'alamat redaksi') + '...';
    }

    try {
      const res = await fetch('/api/test-email', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apiKey, email }),
      });
      const data = await res.json();
      if (data.success) {
        if (testEmailFeedback) {
          testEmailFeedback.className = 'mt-2 text-xs p-2.5 rounded border bg-emerald-50 text-emerald-800 border-emerald-300 block';
          testEmailFeedback.innerHTML = '<strong>Pengujian Berhasil!</strong> ' + data.message;
        }
      } else {
        if (testEmailFeedback) {
          testEmailFeedback.className = 'mt-2 text-xs p-2.5 rounded border bg-rose-50 text-rose-800 border-rose-300 block';
          testEmailFeedback.innerHTML = '<strong>Pengujian Gagal:</strong> ' + (data.error || 'Terjadi penolakan dari penyedia surel.');
        }
      }
    } catch (err: any) {
      if (testEmailFeedback) {
        testEmailFeedback.className = 'mt-2 text-xs p-2.5 rounded border bg-rose-50 text-rose-800 border-rose-300 block';
        testEmailFeedback.innerHTML = '<strong>Gagal:</strong> ' + (err.message || 'Gagal menghubungi server');
      }
    } finally {
      btnTestEmail.disabled = false;
      btnTestEmail.innerHTML = origHtml;
    }
  });

  // Pengaturan tampilan pengindeks di sidebar
  document.querySelectorAll<HTMLInputElement>('.toggle-index-sidebar').forEach((chk) => {
    chk.addEventListener('change', async () => {
      const name = chk.getAttribute('data-name');
      const showInSidebar = chk.checked;
      if (!name) return;

      try {
        const res = await fetch('/api/indexing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, showInSidebar }),
        });
        const json = await res.json();
        if (json.success) {
          showToast(`Status tampilan "${name}" di sidebar berhasil diperbarui!`);
        }
      } catch (err: any) {
        showToast('Gagal mengupdate indexing: ' + err.message, true);
      }
    });
  });

  // Integrasi direktori repositori dokumen
  const formGDrive = document.getElementById('form-gdrive');
  const gdriveUrlInput = document.getElementById('cfg-gdrive-url') as HTMLInputElement | null;
  const gdrivePathInput = document.getElementById('cfg-gdrive-path') as HTMLInputElement | null;
  const previewPdfLink = document.getElementById('preview-pdf-link');

  function updatePdfPreview() {
    if (!previewPdfLink) return;
    const base = (gdriveUrlInput?.value || '').replace(/\/$/, '');
    const path = (gdrivePathInput?.value || '').replace(/^\//, '').replace(/\/$/, '');
    const full = path
      ? `${base}/${path}/JTEBA_V1N1_01_artikel-penelitian.pdf`
      : `${base}/JTEBA_V1N1_01_artikel-penelitian.pdf`;
    previewPdfLink.textContent = full;
  }

  gdriveUrlInput?.addEventListener('input', updatePdfPreview);
  gdrivePathInput?.addEventListener('input', updatePdfPreview);

  formGDrive?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const gdriveBaseUrl = (document.getElementById('cfg-gdrive-url') as HTMLInputElement).value.trim();
    const pdfDirectoryPath = (document.getElementById('cfg-gdrive-path') as HTMLInputElement).value.trim();

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ gdriveBaseUrl, pdfDirectoryPath }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Pengaturan URL & direktori Google Drive Index berhasil disimpan ke database!');
      }
    } catch (err: any) {
      showToast('Gagal menyimpan: ' + err.message, true);
    }
  });

  // 5b. Muat Berkas Google Drive Repositori Live
  const btnSyncDrive = document.getElementById('btn-sync-gdrive-files');
  const driveFilesTableWrap = document.getElementById('gdrive-files-table-wrap');
  const driveFilesPlaceholder = document.getElementById('gdrive-files-placeholder');
  const driveFilesTbody = document.getElementById('gdrive-files-tbody');

  async function loadDriveFiles() {
    if (!driveFilesPlaceholder || !driveFilesTbody || !driveFilesTableWrap) return;
    driveFilesPlaceholder.innerHTML = '<span class="text-academic-navy animate-pulse">Menghubungkan ke Google Drive Worker & memuat berkas...</span>';
    driveFilesPlaceholder.classList.remove('hidden');
    driveFilesTableWrap.classList.add('hidden');

    try {
      const baseInput = (gdriveUrlInput?.value || '').trim().replace(/\/$/, '').replace(/\/(one|two|three|1|2|3|0:|1:|2:)$/i, '');
      let activeToken = memoryWorkerAdminToken;
      if (!activeToken) {
        const inputPrompt = prompt('Masukkan Token Otorisasi Worker Repositori (admin_token):');
        if (!inputPrompt || !inputPrompt.trim()) {
          driveFilesPlaceholder.innerHTML = 'Sinkronisasi dibatalkan. Token otorisasi diperlukan untuk mengakses berkas repositori.';
          return;
        }
        activeToken = inputPrompt.trim();
        memoryWorkerAdminToken = activeToken;
      }

      // Kirim token via HTTP Authorization Header (bukan query parameter URL) untuk mencegah kebocoran log
      const endpoint = baseInput ? `${baseInput}/api/admin/files` : `/api/admin/files`;
      const res = await fetch(endpoint, {
        headers: {
          'Authorization': `Bearer ${activeToken}`,
        },
      });
      if (!res.ok) throw new Error('Status HTTP: ' + res.status);
      const data = await res.json();
      if (!data.success || !Array.isArray(data.files) || data.files.length === 0) {
        driveFilesPlaceholder.innerHTML = 'Tidak ada berkas yang ditemukan di Google Drive.';
        return;
      }

      driveFilesPlaceholder.classList.add('hidden');
      driveFilesTableWrap.classList.remove('hidden');
      driveFilesTbody.innerHTML = '';

      data.files.forEach((f: any) => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition-colors';
        const sizeKb = (f.size / 1024).toFixed(1) + ' KB';
        const modified = f.modifiedTime ? new Date(f.modifiedTime).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-';
        tr.innerHTML = `
          <td class="py-2.5 px-3 font-medium text-slate-800 break-all">${f.name}</td>
          <td class="py-2.5 px-3 text-slate-600 whitespace-nowrap font-mono">${sizeKb}</td>
          <td class="py-2.5 px-3 text-slate-500 whitespace-nowrap">${modified}</td>
          <td class="py-2.5 px-3 text-right whitespace-nowrap space-x-1.5">
            <a href="${f.url}" target="_blank" class="px-2 py-1 bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-200 rounded text-xs font-semibold transition-colors inline-flex items-center gap-1" title="Buka PDF di Browser Native">
              Pratinjau
            </a>
            <button type="button" class="btn-copy-drive-url px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 rounded text-xs font-semibold transition-colors cursor-pointer" data-url="${f.url}" title="Salin Tautan Resmi">
              Salin URL
            </button>
            <button type="button" class="btn-fill-filename px-2 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded text-xs font-semibold transition-colors cursor-pointer" data-filename="${f.name}" title="Pakai nama berkas ini di form terbit naskah">
              Pilih Naskah
            </button>
          </td>
        `;
        driveFilesTbody.appendChild(tr);
      });

      // Bind action buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-copy-drive-url').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const url = (e.currentTarget as HTMLElement).dataset.url;
          if (url) {
            navigator.clipboard.writeText(url);
            showToast('Tautan /one/ berhasil disalin ke clipboard!');
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-fill-filename').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const fname = (e.currentTarget as HTMLElement).dataset.filename;
          const inputPdf = (document.getElementById('art-pdffile') || document.getElementById('art-pdf')) as HTMLInputElement | null;
          if (inputPdf && fname) {
            inputPdf.value = fname;
            switchTab('tab-add-article');
            window.scrollTo({ top: 0, behavior: 'smooth' });
            inputPdf.focus();
            showToast(`Nama file "${fname}" disalin ke form terbit naskah!`);
          }
        });
      });

      showToast(`Berhasil memuat ${data.files.length} berkas dari Google Drive!`);
    } catch (err: any) {
      driveFilesPlaceholder.innerHTML = `<span class="text-rose-600">Gagal memuat berkas: ${err.message}</span>`;
      showToast('Gagal memuat berkas Google Drive: ' + err.message, true);
    }
  }

  btnSyncDrive?.addEventListener('click', loadDriveFiles);

  // Pembaruan URL pengindeks
  document.querySelectorAll<HTMLButtonElement>('.btn-save-index-url').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.getAttribute('data-name');
      if (!name) return;
      const row = btn.closest('tr');
      const input = row?.querySelector<HTMLInputElement>('.input-index-url');
      const url = input?.value.trim();
      if (!url) {
        showToast('Tautan URL tidak boleh kosong!', true);
        return;
      }

      try {
        const res = await fetch('/api/indexing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, url }),
        });
        const json = await res.json();
        if (json.success) {
          showToast(`Tautan URL untuk "${name}" berhasil diperbarui ke database!`);
        } else {
          showToast('Gagal menyimpan URL: ' + json.error, true);
        }
      } catch (err: any) {
        showToast('Gagal menyimpan URL: ' + err.message, true);
      }
    });
  });

  // Konversi berkas ikon pengindeks
  const inputNewIdxIconFile = document.getElementById('new-idx-icon-file') as HTMLInputElement | null;
  const inputNewIdxIconUrl = document.getElementById('new-idx-icon-url') as HTMLInputElement | null;
  const previewNewIdxIcon = document.getElementById('new-idx-icon-preview');
  const statusNewIdxIcon = document.getElementById('new-idx-icon-status');

  inputNewIdxIconFile?.addEventListener('change', () => {
    const file = inputNewIdxIconFile.files?.[0];
    if (!file) return;

    if (file.size > 500 * 1024) {
      showToast('Ukuran file ikon maksimal 500 KB!', true);
      inputNewIdxIconFile.value = '';
      return;
    }

    const reader = new FileReader();
    reader.onload = () => {
      const result = reader.result as string;
      if (inputNewIdxIconUrl) inputNewIdxIconUrl.value = result;
      if (previewNewIdxIcon) {
        previewNewIdxIcon.innerHTML = `<img src="${result}" alt="Preview Ikon" class="w-full h-full object-contain p-0.5" />`;
      }
      if (statusNewIdxIcon) {
        statusNewIdxIcon.textContent = `Berkas ikon: ${file.name} (${Math.round(file.size / 1024)} KB)`;
        statusNewIdxIcon.className = 'text-xs font-semibold text-emerald-700 mt-1';
      }
    };
    reader.readAsDataURL(file);
  });

  // Pendaftaran entitas pengindeks baru
  const formAddIndexing = document.getElementById('form-add-indexing');
  formAddIndexing?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('new-idx-name') as HTMLInputElement).value.trim();
    const category = (document.getElementById('new-idx-category') as HTMLSelectElement).value;
    const status = (document.getElementById('new-idx-status') as HTMLSelectElement).value;
    const url = (document.getElementById('new-idx-url') as HTMLInputElement).value.trim();
    const description = (document.getElementById('new-idx-desc') as HTMLInputElement).value.trim();
    const showInSidebar = (document.getElementById('new-idx-sidebar') as HTMLInputElement).checked;
    const iconUrl = inputNewIdxIconUrl?.value || '';

    if (!name || !url) {
      showToast('Nama pengindeks dan tautan URL wajib diisi!', true);
      return;
    }

    try {
      const res = await fetch('/api/indexing', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'add',
          name,
          category,
          status,
          url,
          description,
          showInSidebar,
          iconUrl,
        }),
      });
      const json = await res.json();
      if (json.success) {
        showToast(`Berhasil menambahkan pangkalan pengindeks "${name}"!`);
        setTimeout(() => window.location.reload(), 800);
      } else {
        showToast('Gagal menambahkan pengindeks: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menambahkan pengindeks: ' + err.message, true);
    }
  });

  // Pembaruan ikon pengindeks
  document.querySelectorAll<HTMLInputElement>('.row-idx-icon-file').forEach((input) => {
    input.addEventListener('change', () => {
      const name = input.getAttribute('data-name');
      const file = input.files?.[0];
      if (!name || !file) return;

      if (file.size > 500 * 1024) {
        showToast('Ukuran berkas ikon maksimal 500 KB!', true);
        input.value = '';
        return;
      }

      const reader = new FileReader();
      reader.onload = async () => {
        const result = reader.result as string;
        try {
          const res = await fetch('/api/indexing', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'update',
              name,
              iconUrl: result,
            }),
          });
          const json = await res.json();
          if (json.success) {
            showToast(`Ikon untuk "${name}" berhasil diperbarui ke database!`);
            setTimeout(() => window.location.reload(), 800);
          } else {
            showToast('Gagal memperbarui ikon: ' + json.error, true);
          }
        } catch (err: any) {
          showToast('Gagal memperbarui ikon: ' + err.message, true);
        }
      };
      reader.readAsDataURL(file);
    });
  });

  // Penghapusan entitas pengindeks
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-indexing').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.getAttribute('data-name');
      if (!name) return;
      if (!confirm(`Apakah Anda yakin ingin menghapus pengindeks "${name}" dari pangkalan data jurnal?`)) {
        return;
      }

      try {
        const res = await fetch('/api/indexing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'delete', name }),
        });
        const json = await res.json();
        if (json.success) {
          showToast(`Pengindeks "${name}" berhasil dihapus.`);
          const row = btn.closest('tr');
          row?.remove();
          const remainingRows = document.querySelectorAll('#table-indexing tbody tr');
          if (remainingRows.length === 0) {
            const tbody = document.querySelector('#table-indexing tbody');
            if (tbody) {
              tbody.innerHTML = `
                <tr id="row-indexing-empty">
                  <td colspan="7" class="p-8 text-center text-slate-500 italic bg-slate-50/50">
                    Belum ada pangkalan data pengindeks di database. Gunakan formulir di bawah untuk menambahkan pengindeks baru.
                  </td>
                </tr>
              `;
            }
          }
        } else {
          showToast('Gagal menghapus pengindeks: ' + json.error, true);
        }
      } catch (err: any) {
        showToast('Gagal menghapus: ' + err.message, true);
      }
    });
  });

  // Pembaruan kredensial akun redaksi
  const formChangePin = document.getElementById('form-change-pin');
  formChangePin?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPin = (document.getElementById('current-pin') as HTMLInputElement).value;
    const newUsername = (document.getElementById('new-username') as HTMLInputElement)?.value.trim();
    const newPin = (document.getElementById('new-pin') as HTMLInputElement).value;
    const confirmNewPin = (document.getElementById('confirm-new-pin') as HTMLInputElement).value;

    if (newPin !== confirmNewPin) {
      showToast('Konfirmasi PIN baru tidak cocok dengan PIN baru!', true);
      return;
    }

    try {
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'change_credentials', currentPin, newPin, newUsername }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Kredensial login (Username & PIN) berhasil diperbarui!');
        (formChangePin as HTMLFormElement).reset();
      } else {
        showToast(json.error || 'Gagal mengubah PIN', true);
      }
    } catch (err: any) {
      showToast('Gagal mengubah PIN: ' + err.message, true);
    }
  });
</script>
