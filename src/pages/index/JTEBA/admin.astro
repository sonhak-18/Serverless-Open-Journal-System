---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getDbSettings, getDbArticles, getDbEditorial, getDbIndexing, getDbIssues } from '../../../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const articles = await getDbArticles(d1);
const editorial = await getDbEditorial(d1);
const indexing = await getDbIndexing(d1);
const issues = await getDbIssues(d1);

const { editorInChief, editors, reviewers } = editorial;

const totalArticlesCount = articles.length;
const nextArticleOrder = totalArticlesCount + 1;
const defaultDoiPrefix = journalConfig.doiPrefix && journalConfig.doiPrefix.startsWith('10.') && !journalConfig.doiPrefix.includes('zenodo')
  ? journalConfig.doiPrefix
  : '10.00000';
---

<Layout title="Panel Redaksi & Admin Jurnal" description={`Halaman pengelolaan dan publikasi naskah ${journalConfig.name}`}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header Admin -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-academic-border pb-5 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="academic-badge bg-academic-navy text-white">Editorial Studio (GUI)</span>
          <span class="text-xs text-academic-ink-subtle">Sistem Pengelolaan Publikasi Mandiri Terintegrasi Database</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-1">
          Panel Administrasi & Redaksi JTEBA
        </h1>
        <p class="text-xs text-academic-ink-muted mt-1">
          Semua pengaturan, penambahan artikel, kontak narahubung, dan dewan redaksi dapat dikelola langsung lewat antarmuka grafis (GUI) di bawah ini.
        </p>
      </div>

      <!-- Status Database & Tombol Logout -->
      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-center">
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-semibold transition-colors"
          title="Buka Panel Admin Portal Open Gate"
        >
          <svg class="w-3.5 h-3.5 text-amber-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          <span>Admin Portal Open Gate</span>
        </a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Database Terhubung (D1 / SQLite)</span>
        </span>
        <button
          type="button"
          id="btn-admin-logout"
          class="hidden px-3.5 py-1.5 bg-rose-700 hover:bg-rose-800 text-white text-xs font-semibold rounded transition-colors shadow-2xs flex items-center gap-1.5"
          title="Keluar dari Panel Admin"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Keluar</span>
        </button>
      </div>
    </div>

    <!-- Alert Notifikasi Global -->
    <div id="admin-toast" class="hidden mb-6 p-4 rounded border text-xs sm:text-sm font-semibold flex items-center justify-between transition-all">
      <span id="admin-toast-msg"></span>
      <button type="button" aria-label="Tutup notifikasi" onclick="document.getElementById('admin-toast').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 ml-4 p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Area Login Sederhana (Gerbang Admin) -->
    <div id="admin-login-lock" class="academic-card p-8 rounded border border-academic-border max-w-md mx-auto my-12 text-center shadow-sm">
      <div class="w-12 h-12 rounded-full bg-academic-navy/10 text-academic-navy flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-academic-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="text-lg font-serif font-bold text-academic-navy">
        Akses Khusus Dewan Redaksi
      </h2>
      <p class="text-xs sm:text-sm text-academic-ink-muted mt-1 mb-6">
        Masukkan kata sandi atau PIN untuk masuk ke panel administrasi redaksi.
      </p>

      <form id="admin-login-form" class="space-y-4 text-left">
        <div>
          <label for="admin-username" class="block text-sm font-semibold text-slate-800 mb-1">
            Nama Pengguna (Username)
          </label>
          <input
            type="text"
            id="admin-username"
            required
            autocomplete="username"
            placeholder="Masukkan username (cth: admin)"
            class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
          />
        </div>
        <div>
          <label for="admin-pin" class="block text-sm font-semibold text-slate-800 mb-1">
            Kata Sandi / PIN Redaksi
          </label>
          <input
            type="password"
            id="admin-pin"
            required
            autocomplete="current-password"
            placeholder="Masukkan kata sandi / PIN"
            class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
          />
        </div>
        <p id="login-error" class="text-xs text-rose-600 hidden">
          Nama pengguna atau kata sandi salah. Silakan coba lagi.
        </p>
        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded transition-colors shadow min-h-[44px]"
        >
          Masuk ke Panel Redaksi
        </button>
      </form>
    </div>

    <!-- Konten Dashboard Admin (Tersembunyi Sebelum Login) -->
    <div id="admin-dashboard-content" class="hidden space-y-8">
      <!-- Navigasi Tab Admin -->
      <div class="flex border-b border-academic-border text-xs sm:text-sm font-medium space-x-1 sm:space-x-3 overflow-x-auto pb-1" role="tablist">
        <button
          type="button"
          class="admin-tab active py-2.5 px-3.5 border-b-2 border-academic-navy text-academic-navy font-bold shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-add-article"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Terbitkan Naskah</span>
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-articles-list"
        >
          Naskah Terbit ({articles.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-editorial-settings"
        >
          Tim Redaksi ({editors.length + reviewers.length + 1})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-profile-settings"
        >
          Profil Jurnal
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-volume-settings"
        >
          Edisi & Terbitan ({issues.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-announcement-settings"
        >
          Pengumuman
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-journal-settings"
        >
          Kontak & Narahubung
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-indexing-settings"
        >
          Pengaturan Indexing ({indexing.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-gdrive-config"
        >
          Google Drive Index
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-security-settings"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Keamanan & PIN</span>
        </button>
      </div>

      <!-- TAB 1: FORM INPUT ARTIKEL BARU -->
      <div id="tab-add-article" class="tab-panel space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-sm">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Formulir Penerbitan Artikel Ilmiah
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Saat disimpan, naskah langsung masuk ke database dan tayang seketika pada halaman publik.
            </p>
          </div>

          <form id="form-new-article" class="space-y-5">
            <!-- Judul & Rumpun -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-8">
                <label for="art-title" class="block text-sm font-semibold text-slate-800 mb-1">
                  Judul Lengkap Artikel <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-title"
                  required
                  placeholder="Contoh: Analisis Kepatuhan Pajak atas Pemanfaatan Fasilitas Super Tax Deduction..."
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                />
              </div>

              <div class="md:col-span-4">
                <label for="art-subject" class="block text-sm font-semibold text-slate-800 mb-1">
                  Rumpun Keilmuan <span class="text-rose-600">*</span>
                </label>
                <select
                  id="art-subject"
                  required
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none bg-white min-h-[44px]"
                >
                  <option value="Akuntansi Keberlanjutan dan Pelaporan ESG (Sustainability Accounting and ESG)">Akuntansi Keberlanjutan dan Pelaporan ESG (Sustainability Accounting and ESG)</option>
                  <option value="Perpajakan dan Kebijakan Fiskal (Taxation and Fiscal Policy)">Perpajakan dan Kebijakan Fiskal (Taxation and Fiscal Policy)</option>
                  <option value="Auditing, Forensik, dan Tata Kelola (Auditing, Forensics, and Governance)">Auditing, Forensik, dan Tata Kelola (Auditing, Forensics, and Governance)</option>
                  <option value="Dinamika Ekonomi dan Bisnis Terapan (Applied Economics and Business Dynamics)">Dinamika Ekonomi dan Bisnis Terapan (Applied Economics and Business Dynamics)</option>
                </select>
              </div>
            </div>

            <!-- GENERATOR URL / SLUG ARTIKEL -->
            <div class="bg-blue-50/70 border border-blue-200 rounded-lg p-4 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <label for="art-slug" class="block text-xs font-bold text-academic-navy uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                    </svg>
                    <span>Generator URL & Slug Artikel</span>
                    <span class="text-rose-600">*</span>
                  </label>
                  <span class="text-xs text-slate-600">
                    Dihasilkan otomatis dari judul artikel untuk permalink publikasi yang SEO-friendly.
                  </span>
                </div>
                <button
                  type="button"
                  id="btn-generate-slug"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold rounded shadow-2xs transition-colors self-start sm:self-auto shrink-0"
                  title="Generate slug dari judul naskah"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>⚡ Generate URL / Slug</span>
                </button>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
                <div class="sm:col-span-8">
                  <input
                    type="text"
                    id="art-slug"
                    required
                    placeholder="contoh-judul-artikel-jurnal-ilmiah"
                    class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono bg-white"
                  />
                </div>
                <div class="sm:col-span-4 flex items-center gap-2">
                  <button
                    type="button"
                    id="btn-copy-url"
                    class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 rounded text-xs font-semibold transition-colors shadow-2xs min-h-[38px]"
                  >
                    <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                    </svg>
                    <span>Salin URL Artikel</span>
                  </button>
                </div>
              </div>

              <div class="text-xs text-slate-600 flex flex-wrap items-center gap-1.5 pt-1 border-t border-blue-100">
                <span class="font-semibold text-slate-700">Pratinjau URL Web:</span>
                <code id="preview-art-url" class="font-mono text-blue-900 bg-white px-2 py-0.5 rounded border border-blue-200 break-all">
                  /article/...
                </code>
              </div>
            </div>

            <!-- Panel Mandiri Penulis & Afiliasi -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 sm:p-5 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                <div>
                  <h3 class="text-sm font-bold text-academic-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-academic-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    Daftar Penulis & Afiliasi Naskah
                  </h3>
                  <p class="text-xs text-slate-600 mt-0.5">
                    Konfigurasi mandiri penulis. Anda dapat menambah penulis pendamping secara dinamis dengan informasi lengkap.
                  </p>
                </div>
                <button
                  type="button"
                  id="btn-add-author"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-academic-navy hover:bg-academic-navy-light text-white text-xs font-semibold rounded shadow-xs transition-colors self-start sm:self-auto"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  <span>+ Tambah Penulis</span>
                </button>
              </div>

              <!-- Container Baris Penulis Dinamis -->
              <div id="authors-container" class="space-y-3">
                <div class="author-row bg-white p-4 rounded border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-end shadow-2xs">
                  <div class="md:col-span-4">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Nama Penulis Utama <span class="text-rose-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="author_name"
                      required
                      placeholder="Contoh: Dr. Rahmat Hidayat, M.Ak."
                      class="author-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                    />
                  </div>
                  <div class="md:col-span-4">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Afiliasi / Universitas / Organisasi Riset <span class="text-rose-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="author_affiliation"
                      required
                      placeholder="Contoh: Universitas Indonesia"
                      class="author-affiliation-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                    />
                  </div>
                  <div class="md:col-span-3">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Email Korespondensi <span class="text-slate-400 font-normal">(Opsional)</span>
                    </label>
                    <input
                      type="email"
                      name="author_email"
                      placeholder="rahmat@ui.ac.id"
                      class="author-email-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
                    />
                  </div>
                  <div class="md:col-span-1 flex justify-end">
                    <button
                      type="button"
                      class="btn-remove-author p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors"
                      title="Hapus baris penulis ini"
                      disabled
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Abstrak & Kata Kunci -->
            <div>
              <label for="art-abstract" class="block text-sm font-semibold text-slate-800 mb-1">
                Teks Abstrak (Bahasa Indonesia atau Inggris) <span class="text-rose-600">*</span>
              </label>
              <textarea
                id="art-abstract"
                rows="4"
                required
                placeholder="Tuliskan latar belakang singkat, tujuan, metode penelitian, dan kesimpulan temuan utama..."
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
              ></textarea>
            </div>

            <div>
              <label for="art-references" class="block text-sm font-semibold text-slate-800 mb-1">
                Daftar Pustaka / Referensi Naskah (Opsional)
              </label>
              <textarea
                id="art-references"
                rows="4"
                placeholder="Tuliskan daftar pustaka atau referensi ilmiah (satu referensi per baris)..."
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-sans"
              ></textarea>
              <span class="text-xs text-slate-500 mt-1 block">
                Pisahkan tiap referensi dengan baris baru (Enter). Tautan URL / DOI otomatis terdeteksi.
              </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="art-keywords" class="block text-sm font-semibold text-slate-800 mb-1">
                  Kata Kunci (Keywords) <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-keywords"
                  required
                  placeholder="Contoh: Kepatuhan Pajak, Super Tax Deduction, Fiskal"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                />
                <span class="text-xs text-slate-500 mt-1 block">Pisahkan dengan koma (3-5 kata kunci).</span>
              </div>

              <div>
                <label for="art-pdffile" class="block text-sm font-semibold text-slate-800 mb-1">
                  Nama File PDF di Google Drive <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-pdffile"
                  required
                  placeholder="Contoh: jteba-v1n1-01-penulis.pdf"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
                />
                <span class="text-xs text-slate-500 mt-1 block">Nama file PDF naskah yang disimpan di Google Drive / Cloudflare R2.</span>
              </div>
            </div>

            <!-- Metadata Edisi, Halaman, & Generator DOI -->
            <div class="bg-amber-50/70 border border-amber-200 rounded-lg p-4 sm:p-5 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-amber-200">
                <div>
                  <h3 class="text-sm font-bold text-academic-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Metadata Edisi & Generator DOI Resmi</span>
                  </h3>
                  <p class="text-xs text-slate-600 mt-0.5">
                    Format DOI: <code class="font-mono text-amber-900 bg-white px-1.5 py-0.5 rounded border border-amber-200">https://doi.org/10.00000/jteba.v(vol)i(issue).(nomor urut terbit di web)</code>
                  </p>
                </div>
                <button
                  type="button"
                  id="btn-generate-doi"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-[#0f284e] hover:bg-[#183e6d] text-white text-xs font-semibold rounded shadow-2xs transition-colors self-start sm:self-auto shrink-0"
                  title="Generate nomor DOI otomatis sesuai urutan naskah"
                >
                  <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  <span>⚡ Generate DOI Otomatis</span>
                </button>
              </div>

              <!-- Grid Parameter DOI: Volume, Issue, Numerasi Artikel, Rentang Halaman -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs sm:text-sm">
                <div>
                  <label for="art-volume" class="block font-semibold text-slate-800 mb-1">
                    Volume <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="number"
                    id="art-volume"
                    value={journalConfig.currentIssue?.volume ?? 1}
                    min="1"
                    required
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none bg-white font-mono"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">v(volume)</span>
                </div>

                <div>
                  <label for="art-issue" class="block font-semibold text-slate-800 mb-1">
                    Nomor Issue <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="number"
                    id="art-issue"
                    value={journalConfig.currentIssue?.issue ?? 1}
                    min="1"
                    required
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none bg-white font-mono"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">i(issue)</span>
                </div>

                <div>
                  <label for="art-article-order" class="block font-semibold text-slate-800 mb-1">
                    No. Urut Terbit di Web <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="number"
                    id="art-article-order"
                    value={nextArticleOrder}
                    min="1"
                    required
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none bg-white font-mono"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">Artikel ke-{nextArticleOrder} di portal web</span>
                </div>

                <div>
                  <label for="art-pages" class="block font-semibold text-slate-800 mb-1">
                    Rentang Halaman <span class="text-rose-600">*</span>
                  </label>
                  <input
                    type="text"
                    id="art-pages"
                    value="45-58"
                    placeholder="Contoh: 45-58"
                    required
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none bg-white font-mono"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">Contoh: 1-14</span>
                </div>
              </div>

              <!-- Baris Prefix & Input DOI Akhir -->
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-end pt-2 border-t border-amber-200">
                <div class="sm:col-span-4">
                  <label for="art-doi-prefix" class="block text-xs font-semibold text-slate-800 mb-1">
                    Prefix DOI (Default: 10.00000)
                  </label>
                  <input
                    type="text"
                    id="art-doi-prefix"
                    value={defaultDoiPrefix}
                    class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none bg-white font-mono text-xs"
                  />
                </div>

                <div class="sm:col-span-8 space-y-1">
                  <div class="flex items-center justify-between mb-1">
                    <label for="art-doi" class="block text-xs font-bold text-academic-navy">
                      Hasil DOI Lengkap Naskah <span class="text-rose-600">*</span>
                    </label>
                    <button
                      type="button"
                      id="btn-copy-doi"
                      class="text-xs text-blue-700 hover:underline font-normal inline-flex items-center gap-1"
                    >
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                      </svg>
                      <span>Salin DOI</span>
                    </button>
                  </div>
                  <input
                    type="text"
                    id="art-doi"
                    required
                    value={`https://doi.org/${defaultDoiPrefix}/jteba.v${journalConfig.currentIssue?.volume ?? 1}i${journalConfig.currentIssue?.issue ?? 1}.${nextArticleOrder}`}
                    class="w-full px-3 py-2 text-sm border border-amber-300 bg-white rounded focus:border-academic-navy outline-none font-mono font-semibold text-blue-900"
                  />
                </div>
              </div>

              <!-- Live Preview DOI -->
              <div class="text-xs text-slate-700 flex flex-wrap items-center gap-1.5 pt-1">
                <span class="font-semibold">Pratinjau Tautan DOI:</span>
                <a
                  id="preview-art-doi"
                  href={`https://doi.org/${defaultDoiPrefix}/jteba.v${journalConfig.currentIssue?.volume ?? 1}i${journalConfig.currentIssue?.issue ?? 1}.${nextArticleOrder}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-blue-700 hover:underline bg-white px-2 py-0.5 rounded border border-amber-300 break-all"
                >
                  https://doi.org/{defaultDoiPrefix}/jteba.v{journalConfig.currentIssue?.volume ?? 1}i{journalConfig.currentIssue?.issue ?? 1}.{nextArticleOrder}
                </a>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                id="btn-submit-article"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan & Publikasikan ke Database</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 2: DAFTAR ARTIKEL TERBIT -->
      <div id="tab-articles-list" class="tab-panel hidden space-y-4">
        <div class="academic-card p-6 rounded border border-academic-border bg-white">
          <h2 class="text-lg font-serif font-bold text-academic-navy pb-3 border-b border-slate-200 mb-4">
            Daftar Artikel yang Sedang Aktif di Database ({articles.length})
          </h2>

          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-300">
                  <th class="p-3 font-semibold">Judul Artikel</th>
                  <th class="p-3 font-semibold">Penulis</th>
                  <th class="p-3 font-semibold">Bidang</th>
                  <th class="p-3 font-semibold">Edisi</th>
                  <th class="p-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
                {articles.length === 0 ? (
                  <tr>
                    <td colspan="5" class="p-8 text-center text-slate-500 italic bg-slate-50/50">
                      Belum ada naskah terbit di database. Tambahkan artikel baru melalui tab "Tambah Artikel" di atas.
                    </td>
                  </tr>
                ) : (
                  articles.map((item) => (
                    <tr class="hover:bg-slate-50 transition-colors">
                      <td class="p-3 font-medium text-academic-navy max-w-xs truncate">
                        {item.title}
                      </td>
                      <td class="p-3 text-slate-600">
                        {item.authors.map(a => a.name).join(', ')}
                      </td>
                      <td class="p-3">
                        <span class="academic-badge bg-slate-100 border text-slate-800">
                          {item.subject}
                        </span>
                      </td>
                      <td class="p-3 text-slate-600">
                        Vol. {item.volume} No. {item.issue}
                      </td>
                      <td class="p-3 text-right space-x-2">
                        <a
                          href={`/index/JTEBA/article/${item.slug}`}
                          target="_blank"
                          class="text-blue-700 hover:underline font-semibold"
                        >
                          Buka
                        </a>
                        <button
                          type="button"
                          class="btn-delete-article text-red-600 hover:text-red-800 font-semibold"
                          data-slug={item.slug}
                        >
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 3: PENGATURAN TIM REDAKSI (EDITORIAL TEAM SETUP) -->
      <div id="tab-editorial-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white space-y-6">
          <div class="border-b border-slate-200 pb-3 flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Kelola Dewan Redaksi & Mitra Bestari
              </h2>
              <p class="text-xs text-academic-ink-muted mt-0.5">
                Semua perubahan yang disimpan di sini langsung memperbarui halaman <code>/editorial-team</code> dan metadata publikasi.
              </p>
            </div>
            <a href="/index/JTEBA/editorial-team" target="_blank" class="text-xs font-semibold text-blue-700 hover:underline">
              Lihat Halaman Publik ↗
            </a>
          </div>

          <!-- Visibilitas Tab Tim Redaksi di Publik (Addon 1) -->
          <div class="bg-blue-50/80 border border-blue-200 rounded p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
            <div>
              <span class="font-bold text-academic-navy text-sm block">Visibilitas Publik Menu & Halaman Tim Redaksi:</span>
              <p class="text-slate-600 mt-0.5">
                Aktifkan opsi ini untuk menampilkan tab menu "Editorial Team" di bar navigasi utama, sidebar kanan OJS, serta kartu tautan publik JTEBA. Jika dinonaktifkan (misalnya struktur tim masih dalam tahap penataan), menu ini akan disembunyikan dari pengunjung publik.
              </p>
            </div>
            <label class="flex items-center gap-2 cursor-pointer shrink-0 bg-white px-3.5 py-2 rounded border border-blue-300 font-semibold text-slate-800 shadow-2xs hover:bg-slate-50 transition-colors">
              <input type="checkbox" id="toggle-editorial-team" checked={journalConfig.features.showEditorialTeam === true} class="rounded text-blue-600 w-4 h-4 cursor-pointer" />
              <span>Tampilkan di Publik</span>
            </label>
          </div>

          <!-- Section A: Pemimpin Redaksi (Editor-in-Chief) -->
          <div class="bg-slate-50 p-4 rounded border border-slate-200 space-y-3">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              1. Pemimpin Redaksi (Editor-in-Chief)
            </span>
            <form id="form-eic" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Lengkap & Gelar</label>
                <input type="text" id="eic-name" value={editorInChief.name} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white font-medium" />
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Afiliasi / Komunitas Riset</label>
                <input type="text" id="eic-affil" value={editorInChief.affiliation} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Email Redaksi</label>
                  <input type="email" id="eic-email" value={editorInChief.email} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white font-mono" />
                </div>
                <button type="submit" class="px-4 py-1.5 bg-[#1e4a7a] hover:bg-[#153457] text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  Simpan EIC
                </button>
              </div>
            </form>
          </div>

          <!-- Section B: Dewan Editor Bidang -->
          <div class="space-y-4">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              2. Dewan Editor Eksekutif ({editors.length} Anggota)
            </span>

            <!-- Form Tambah Editor -->
            <form id="form-add-editor" class="p-3 bg-slate-50 rounded border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Editor</label>
                <input type="text" id="new-ed-name" required placeholder="Nama & Gelar" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Peran / Bidang</label>
                <input type="text" id="new-ed-role" required placeholder="Contoh: Managing Editor" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Afiliasi</label>
                  <input type="text" id="new-ed-affil" required placeholder="Nama Universitas / Organisasi" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
                </div>
                <button type="submit" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  + Tambah
                </button>
              </div>
            </form>

            <div class="border border-slate-200 rounded overflow-hidden">
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-700 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Nama</th>
                    <th class="p-2.5">Peran / Bidang</th>
                    <th class="p-2.5">Afiliasi</th>
                    <th class="p-2.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  {editors.map((ed) => (
                    <tr class="hover:bg-slate-50">
                      <td class="p-2.5 font-bold text-slate-800">{ed.name}</td>
                      <td class="p-2.5 text-slate-600">{ed.role}</td>
                      <td class="p-2.5 text-slate-500">{ed.affiliation}</td>
                      <td class="p-2.5 text-right">
                        <button type="button" class="btn-delete-member text-red-600 hover:text-red-800 font-semibold" data-id={ed.id}>
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Section C: Mitra Bestari (Reviewers) -->
          <div class="space-y-4">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              3. Mitra Bestari / Peer Reviewers ({reviewers.length} Penelaah)
            </span>

            <!-- Form Tambah Reviewer -->
            <form id="form-add-reviewer" class="p-3 bg-slate-50 rounded border border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Reviewer</label>
                <input type="text" id="new-rev-name" required placeholder="Nama Lengkap & Gelar" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Afiliasi Universitas / Organisasi</label>
                  <input type="text" id="new-rev-affil" required placeholder="Nama Kampus / Organisasi Riset" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
                </div>
                <button type="submit" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  + Tambah
                </button>
              </div>
            </form>

            <div class="border border-slate-200 rounded overflow-hidden">
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-700 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Nama Reviewer</th>
                    <th class="p-2.5">Afiliasi Universitas / Organisasi</th>
                    <th class="p-2.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  {reviewers.map((rev) => (
                    <tr class="hover:bg-slate-50">
                      <td class="p-2.5 font-bold text-slate-800">{rev.name}</td>
                      <td class="p-2.5 text-slate-600">{rev.affiliation}</td>
                      <td class="p-2.5 text-right">
                        <button type="button" class="btn-delete-member text-red-600 hover:text-red-800 font-semibold" data-id={rev.id}>
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB: PROFIL & IDENTITAS JURNAL -->
      <div id="tab-profile-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Profil, Identitas & Akreditasi Jurnal
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Pengaturan nama jurnal, akreditasi, frekuensi penerbitan, lisensi, dan DOI langsung tersimpan ke Cloudflare D1.
            </p>
          </div>

          <form id="form-profile-settings" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="md:col-span-2">
                <label for="cfg-journal-name" class="block font-semibold text-academic-navy mb-1">
                  Nama Jurnal Lengkap (Bahasa Indonesia) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-journal-name"
                  value={journalConfig.name}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-serif text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-journal-name-en" class="block font-semibold text-academic-navy mb-1">
                  Nama Jurnal (Bahasa Inggris / English Title)
                </label>
                <input
                  type="text"
                  id="cfg-journal-name-en"
                  value={journalConfig.nameEn}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-journal-short" class="block font-semibold text-academic-navy mb-1">
                  Singkatan / Inisial Jurnal (Akronim) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-journal-short"
                  value={journalConfig.shortName}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div class="md:col-span-2">
                <label for="cfg-accredited" class="block font-semibold text-academic-navy mb-1">
                  Status & Keterangan Akreditasi (Tagline)
                </label>
                <input
                  type="text"
                  id="cfg-accredited"
                  value={journalConfig.accreditedText}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-frequency" class="block font-semibold text-academic-navy mb-1">
                  Frekuensi Terbitan
                </label>
                <input
                  type="text"
                  id="cfg-frequency"
                  value={journalConfig.publicationFrequency}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-doi-prefix" class="block font-semibold text-academic-navy mb-1">
                  Prefix DOI Resmi (Zenodo / Crossref)
                </label>
                <input
                  type="text"
                  id="cfg-doi-prefix"
                  value={journalConfig.doiPrefix}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-license" class="block font-semibold text-academic-navy mb-1">
                  Nama Lisensi Karya
                </label>
                <input
                  type="text"
                  id="cfg-license"
                  value={journalConfig.license}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-license-url" class="block font-semibold text-academic-navy mb-1">
                  Tautan URL Lisensi
                </label>
                <input
                  type="url"
                  id="cfg-license-url"
                  value={journalConfig.licenseUrl}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-similarity" class="block font-semibold text-academic-navy mb-1">
                  Batas Maksimal Similarity Turnitin (%)
                </label>
                <input
                  type="number"
                  id="cfg-similarity"
                  value={journalConfig.submission.turnitinMaxSimilarity}
                  min="5"
                  max="50"
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-review-time" class="block font-semibold text-academic-navy mb-1">
                  Estimasi Waktu Review Naskah
                </label>
                <input
                  type="text"
                  id="cfg-review-time"
                  value={journalConfig.submission.reviewTimeEstimate}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>
            </div>

            <!-- Organisasi, Penerbit & Legalitas ISSN (Addon 3: Dipindah ke Profil Jurnal) -->
            <div class="mt-6 pt-6 border-t border-slate-200">
              <div class="mb-3">
                <h3 class="text-sm font-bold text-academic-navy flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                  <span>Organisasi Penerbit, Afiliasi Riset & Legalitas ISSN</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  Informasi badan penerbit, alamat sekretariat, serta nomor identifikasi serial e-ISSN dan p-ISSN resmi.
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-50 p-4 rounded border border-slate-200">
                <div>
                  <label for="cfg-org-name" class="block font-semibold text-academic-navy mb-1">
                    Nama Organisasi / Komunitas Riset
                  </label>
                  <input
                    type="text"
                    id="cfg-org-name"
                    value={journalConfig.institution}
                    class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-medium"
                  />
                </div>

                <div>
                  <label for="cfg-pub-name" class="block font-semibold text-academic-navy mb-1">
                    Penerbit (Publisher Press)
                  </label>
                  <input
                    type="text"
                    id="cfg-pub-name"
                    value={journalConfig.publisher}
                    class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-medium"
                  />
                </div>

                <div class="sm:col-span-2">
                  <label for="cfg-address" class="block font-semibold text-academic-navy mb-1">
                    Alamat Sekretariat Redaksi
                  </label>
                  <input
                    type="text"
                    id="cfg-address"
                    value={journalConfig.address}
                    class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                  />
                </div>

                <div class="sm:col-span-2 bg-blue-50/70 border border-blue-200 rounded p-3 text-xs space-y-1.5">
                  <div class="font-bold text-academic-navy flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Kaidah Baku Numerasi ISSN (ISO 3297)</span>
                  </div>
                  <p class="text-slate-600 leading-relaxed text-xs">
                    Format baku: <strong>8 digit angka</strong> dipisahkan tanda strip (<code>XXXX-XXXX</code>). Digit ke-8 adalah <em>angka pemeriksa (check digit)</em> yang dihitung menggunakan algoritma <strong>Modulo 11 berbobot</strong> (dapat bernilai 0–9 atau huruf X).
                  </p>
                </div>

                <div>
                  <label for="cfg-eissn" class="block font-semibold text-academic-navy mb-1 flex items-center justify-between">
                    <span>Nomor e-ISSN (Online)</span>
                    <span id="eissn-status" class="text-xs text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-mono border border-emerald-200">ISO 3297 Valid</span>
                  </label>
                  <input
                    type="text"
                    id="cfg-eissn"
                    value={journalConfig.eIssn || '2999-7127'}
                    placeholder="2999-7127"
                    maxlength="9"
                    class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono font-bold text-slate-800 focus:border-academic-navy outline-none"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">Untuk publikasi versi online / e-journal.</span>
                </div>

                <div>
                  <label for="cfg-pissn" class="block font-semibold text-academic-navy mb-1 flex items-center justify-between">
                    <span>Nomor p-ISSN (Print)</span>
                    <span id="pissn-status" class="text-xs text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded font-mono border border-blue-200">ISO 3297 Valid</span>
                  </label>
                  <input
                    type="text"
                    id="cfg-pissn"
                    value={journalConfig.pIssn || '2999-7119'}
                    placeholder="2999-7119"
                    maxlength="9"
                    class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono font-bold text-slate-800 focus:border-academic-navy outline-none"
                  />
                  <span class="text-xs text-slate-500 mt-1 block">Untuk edisi cetak fisik & barcode EAN-13.</span>
                </div>
              </div>
            </div>

            <!-- Bagian Branding: Unggah Berkas Logo, Favicon & Template Manuskrip -->
            <div class="mt-6 pt-6 border-t border-slate-200">
              <div class="mb-4">
                <h3 class="text-sm font-bold text-academic-navy flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-academic-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Unggah Berkas Logo, Favicon & Template Manuskrip</span>
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  Unggah berkas langsung dari perangkat Anda tanpa perlu membuat tautan CDN. Berkas tersimpan mandiri di database Cloudflare D1.
                </p>
              </div>

              <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <!-- 1. Logo Jurnal -->
                  <div class="bg-slate-50 p-4 rounded border border-slate-200 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-academic-navy text-xs">Logo Jurnal (Header)</span>
                        <span id="status-logo-file" class="text-xs text-slate-500">
                          {journalConfig.branding?.logoUrl?.startsWith('data:') ? '✓ Menggunakan berkas custom' : 'Default sistem'}
                        </span>
                      </div>

                      <!-- Pratinjau Logo -->
                      <div class="h-20 bg-white border border-slate-200 rounded flex items-center justify-center p-2 mb-3 overflow-hidden">
                        <img
                          id="preview-logo-img"
                          src={journalConfig.branding?.logoUrl || '/images/logo-jteba.png'}
                          alt="Pratinjau Logo"
                          class="max-h-full max-w-full object-contain"
                          onerror="this.src='/images/logo-jteba.png'"
                        />
                      </div>
                    </div>

                    <div class="space-y-2">
                      <div class="flex items-center gap-2">
                        <input
                          type="file"
                          id="upload-logo-file"
                          accept="image/png,image/jpeg,image/webp,image/svg+xml"
                          class="hidden"
                        />
                        <label
                          for="upload-logo-file"
                          class="flex-1 cursor-pointer py-2 px-3 bg-white hover:bg-slate-100 border border-slate-300 rounded text-center text-xs font-semibold text-academic-navy shadow-2xs transition-colors flex items-center justify-center gap-1.5"
                        >
                          <svg class="w-3.5 h-3.5 text-academic-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                          </svg>
                          <span>Pilih Berkas Logo</span>
                        </label>
                        <button
                          type="button"
                          id="btn-reset-logo"
                          class="px-2.5 py-2 text-xs text-slate-500 hover:text-rose-600 bg-white border border-slate-300 rounded transition-colors"
                          title="Kembalikan ke logo bawaan"
                        >
                          Reset
                        </button>
                      </div>

                      <!-- Input tersimpan / manual -->
                      <details class="text-xs text-slate-500">
                        <summary class="cursor-pointer hover:underline text-slate-600">Opsi tautan manual / data URL</summary>
                        <input
                          type="text"
                          id="cfg-logo-url"
                          value={journalConfig.branding?.logoUrl || '/images/logo-jteba.png'}
                          class="w-full mt-1 px-2 py-1 border border-slate-300 rounded font-mono text-xs bg-white"
                        />
                      </details>
                    </div>
                  </div>

                  <!-- 2. Favicon Jurnal -->
                  <div class="bg-slate-50 p-4 rounded border border-slate-200 flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between mb-2">
                        <span class="font-bold text-academic-navy text-xs">Favicon Jurnal (Tab Browser)</span>
                        <span id="status-favicon-file" class="text-xs text-slate-500">
                          {journalConfig.branding?.faviconUrl?.startsWith('data:') ? '✓ Menggunakan berkas custom' : 'Default sistem'}
                        </span>
                      </div>

                      <!-- Pratinjau Favicon -->
                      <div class="h-20 bg-white border border-slate-200 rounded flex items-center justify-center p-2 mb-3">
                        <div class="w-12 h-12 bg-slate-100 rounded border border-slate-200 flex items-center justify-center overflow-hidden shadow-2xs">
                          <img
                            id="preview-favicon-img"
                            src={journalConfig.branding?.faviconUrl || '/favicon-jteba.png'}
                            alt="Pratinjau Favicon"
                            class="w-8 h-8 object-contain"
                            onerror="this.src='/favicon-jteba.png'"
                          />
                        </div>
                      </div>
                    </div>

                    <div class="space-y-2">
                      <div class="flex items-center gap-2">
                        <input
                          type="file"
                          id="upload-favicon-file"
                          accept="image/x-icon,image/png,image/svg+xml"
                          class="hidden"
                        />
                        <label
                          for="upload-favicon-file"
                          class="flex-1 cursor-pointer py-2 px-3 bg-white hover:bg-slate-100 border border-slate-300 rounded text-center text-xs font-semibold text-academic-navy shadow-2xs transition-colors flex items-center justify-center gap-1.5"
                        >
                          <svg class="w-3.5 h-3.5 text-academic-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                          </svg>
                          <span>Pilih Berkas Favicon</span>
                        </label>
                        <button
                          type="button"
                          id="btn-reset-fav"
                          class="px-2.5 py-2 text-xs text-slate-500 hover:text-rose-600 bg-white border border-slate-300 rounded transition-colors"
                          title="Kembalikan ke favicon bawaan"
                        >
                          Reset
                        </button>
                      </div>

                      <details class="text-xs text-slate-500">
                        <summary class="cursor-pointer hover:underline text-slate-600">Opsi tautan manual / data URL</summary>
                        <input
                          type="text"
                          id="cfg-favicon-url"
                          value={journalConfig.branding?.faviconUrl || '/favicon.png'}
                          class="w-full mt-1 px-2 py-1 border border-slate-300 rounded font-mono text-xs bg-white"
                        />
                      </details>
                    </div>
                  </div>
                </div>

                <!-- 3. Template Manuskrip Word (.docx) -->
                <div class="bg-slate-50 p-4 rounded border border-slate-200">
                  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200 mb-3">
                    <div class="flex items-center gap-3">
                      <div class="w-10 h-11 bg-white border border-slate-300 rounded flex flex-col items-center justify-between p-1 shrink-0 shadow-2xs">
                        <svg class="w-5 h-5 text-blue-700" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                        </svg>
                        <span class="text-xs font-bold font-mono text-blue-800 bg-blue-50 px-1 rounded-2xs">DOCX</span>
                      </div>
                      <div>
                        <span class="font-bold text-academic-navy text-sm block">
                          Berkas Template Manuskrip Word (.docx)
                        </span>
                        <span id="status-template-file" class="text-xs text-slate-600 block mt-0.5">
                          {journalConfig.branding?.templateUrl?.startsWith('data:') ? '✓ Berkas kustom tersimpan di database' : 'Berkas bawaan sistem (/template-jteba.docx)'}
                        </span>
                      </div>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                      <input
                        type="file"
                        id="upload-template-file"
                        accept=".docx,.doc"
                        class="hidden"
                      />
                      <label
                        for="upload-template-file"
                        class="cursor-pointer py-2 px-3.5 bg-academic-navy hover:bg-academic-navy-light text-white rounded text-xs font-bold shadow-2xs transition-colors flex items-center gap-1.5"
                      >
                        <svg class="w-4 h-4 text-academic-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                        </svg>
                        <span>Unggah File .docx Baru</span>
                      </label>
                      <a
                        id="preview-template-btn"
                        href="/api/template"
                        target="_blank"
                        class="py-2 px-3 bg-white hover:bg-slate-100 text-slate-700 rounded text-xs font-semibold border border-slate-300 shadow-2xs flex items-center gap-1.5 transition-colors"
                        title="Unduh dan uji berkas template aktif saat ini"
                      >
                        <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                        </svg>
                        <span>Unduh Berkas Aktif</span>
                      </a>
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-xs text-slate-500">
                    <p>
                      Berkas yang diunggah akan otomatis disimpan langsung di database dan disajikan saat pembaca mengklik tombol "Unduh Template (.docx)" di Sidebar, Guidelines, atau Submit.
                    </p>
                    <details class="text-xs text-slate-500 shrink-0 ml-4">
                      <summary class="cursor-pointer hover:underline text-slate-600">Tautan manual</summary>
                      <input
                        type="text"
                        id="cfg-template-url"
                        value={journalConfig.branding?.templateUrl || '/template-jteba.docx'}
                        class="mt-1 px-2 py-1 border border-slate-300 rounded font-mono text-xs bg-white w-64"
                      />
                    </details>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Profil Jurnal</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGATURAN EDISI & TERBITAN AKTIF (VOLUME / ISSUE) -->
      <div id="tab-volume-settings" class="tab-panel hidden space-y-6">
        <!-- Panel 1: Status Publikasi Jurnal (Call for Papers vs Terbitan Aktif) -->
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-200 pb-4 mb-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-academic-navy text-xs font-bold">1</span>
                <h2 class="text-lg font-serif font-bold text-academic-navy">
                  Status Publikasi Edisi Jurnal
                </h2>
              </div>
              <p class="text-xs text-academic-ink-muted mt-1">
                Atur apakah jurnal saat ini telah memiliki edisi terbitan resmi atau masih dalam masa Call for Papers menuju edisi perdana.
              </p>
            </div>

            <div class="flex items-center gap-3 shrink-0 bg-slate-50 p-2.5 rounded-lg border border-slate-200">
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  id="toggle-active-issue"
                  checked={journalConfig.features?.hasActiveIssue === true}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                <span id="active-issue-status-text" class="ml-3 text-xs font-bold text-slate-800">
                  {journalConfig.features?.hasActiveIssue ? 'Edisi Aktif Terpublikasi' : 'Mode Call for Papers (Menuju Edisi Perdana)'}
                </span>
              </label>
            </div>
          </div>

          <div class={`p-4 rounded border text-xs leading-relaxed ${journalConfig.features?.hasActiveIssue ? 'bg-emerald-50 border-emerald-200 text-emerald-900' : 'bg-amber-50 border-amber-200 text-amber-900'}`} id="active-issue-notice">
            {journalConfig.features?.hasActiveIssue ? (
              <p>
                <strong>Status Terbitan Aktif:</strong> Halaman Beranda JTEBA dan menu <em>Current Issue</em> saat ini menampilkan edisi resmi (Vol. {journalConfig.currentIssue?.volume ?? 1} No. {journalConfig.currentIssue?.issue ?? 1}) beserta daftar artikel naskah yang telah terbit.
              </p>
            ) : (
              <p>
                <strong>Status Call for Papers:</strong> Karena belum ada naskah yang diterbitkan, sistem menyajikan tampilan profesional <em>"Menuju Edisi Perdana / Call for Papers"</em> di seluruh halaman publik tanpa menampilkan volume rilis yang kosong.
              </p>
            )}
          </div>
        </div>

        <!-- Panel 2: Daftar Edisi & Terbitan (Issue Archives & Manager) -->
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-5 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-academic-navy text-xs font-bold">2</span>
                <h2 class="text-lg font-serif font-bold text-academic-navy">
                  Daftar Edisi & Terbitan ({issues.length})
                </h2>
              </div>
              <p class="text-xs text-academic-ink-muted mt-1">
                Kelola volume dan edisi jurnal. Anda dapat menambahkan terbitan baru atau menghapus edisi yang belum terisi.
              </p>
            </div>
            <a
              href="#form-add-new-issue"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 text-blue-800 hover:bg-blue-100 border border-blue-200 rounded text-xs font-semibold transition-colors self-start sm:self-auto"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              <span>Tambah Edisi Baru</span>
            </a>
          </div>

          {issues.length > 0 ? (
            <div class="overflow-x-auto border border-slate-200 rounded">
              <table class="w-full text-left border-collapse text-xs" id="table-issues">
                <thead class="bg-slate-100/75 border-b border-slate-200 font-semibold text-slate-700">
                  <tr>
                    <th class="p-3">Edisi / Terbitan</th>
                    <th class="p-3">Periode & Tahun</th>
                    <th class="p-3">Tema Khusus</th>
                    <th class="p-3 text-center">Status</th>
                    <th class="p-3 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 font-sans">
                  {issues.map((item) => (
                    <tr class="hover:bg-slate-50 transition-colors">
                      <td class="p-3 font-semibold text-slate-900">
                        <div class="flex items-center gap-2">
                          <span class="px-2 py-0.5 bg-slate-100 font-mono text-xs rounded border border-slate-200">
                            Vol. {item.volume} No. {item.issue}
                          </span>
                        </div>
                      </td>
                      <td class="p-3 text-slate-700">
                        {item.period || '-'} ({item.year})
                      </td>
                      <td class="p-3 text-slate-600 max-w-xs truncate" title={item.theme || ''}>
                        {item.theme || '<em class="text-slate-400">Tidak ada tema</em>'}
                      </td>
                      <td class="p-3 text-center">
                        {(item.isCurrent || item.is_current === 1) ? (
                          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            Terbitan Terkini
                          </span>
                        ) : (
                          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200">
                            Arsip
                          </span>
                        )}
                      </td>
                      <td class="p-3 text-right space-x-1 whitespace-nowrap">
                        {!(item.isCurrent || item.is_current === 1) && (
                          <button
                            type="button"
                            class="btn-set-current-issue px-2.5 py-1 text-xs font-medium text-blue-700 hover:text-blue-900 hover:bg-blue-50 border border-blue-200 rounded transition-colors"
                            data-id={item.id}
                            data-volume={item.volume}
                            data-issue={item.issue}
                            title="Jadikan edisi ini sebagai Terbitan Terkini"
                          >
                            Jadikan Terkini
                          </button>
                        )}
                        <button
                          type="button"
                          class="btn-delete-issue px-2.5 py-1 text-xs font-medium text-rose-600 hover:text-rose-800 hover:bg-rose-50 border border-rose-200 rounded transition-colors"
                          data-id={item.id}
                          data-label={`Vol. ${item.volume} No. ${item.issue}`}
                          title="Hapus edisi ini"
                        >
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="py-8 px-6 text-center border border-dashed border-slate-300 rounded bg-slate-50 text-slate-600 text-xs space-y-2">
              <p class="font-bold text-academic-navy">Belum ada Edisi / Volume yang Didaftarkan</p>
              <p class="text-slate-500 max-w-md mx-auto">
                Hal ini wajar karena jurnal belum memiliki paper yang rilis. Tambahkan edisi terbitan di bawah saat proses penyusunan volume naskah siap dimulai.
              </p>
            </div>
          )}
        </div>

        <!-- Panel 3: Tambah Edisi / Volume Baru -->
        <div id="form-add-new-issue" class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-5">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-academic-navy text-xs font-bold">3</span>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Tambah Edisi / Terbitan Baru
              </h2>
            </div>
            <p class="text-xs text-academic-ink-muted mt-1">
              Buat volume dan nomor terbitan baru untuk mengelompokkan naskah artikel yang akan terbit.
            </p>
          </div>

          <form id="form-add-issue" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50 p-4 rounded border border-slate-200">
              <div>
                <label for="new-issue-vol" class="block font-semibold text-slate-800 mb-1">
                  Volume <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="new-issue-vol"
                  min="1"
                  value={issues.length > 0 ? Math.max(...issues.map(i => i.volume)) : 1}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-xs bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="new-issue-num" class="block font-semibold text-slate-800 mb-1">
                  Nomor Issue <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="new-issue-num"
                  min="1"
                  value={issues.length > 0 ? (issues[issues.length - 1].issue + 1) : 1}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-xs bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="new-issue-year" class="block font-semibold text-slate-800 mb-1">
                  Tahun Terbit <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="new-issue-year"
                  min="2020"
                  max="2040"
                  value={new Date().getFullYear()}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-xs bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="new-issue-period" class="block font-semibold text-slate-800 mb-1">
                  Periode / Bulan Publikasi <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="new-issue-period"
                  placeholder="Contoh: Maret 2026 atau September 2026"
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="new-issue-theme" class="block font-semibold text-slate-800 mb-1">
                  Tema Khusus / Keterangan Edisi
                </label>
                <input
                  type="text"
                  id="new-issue-theme"
                  placeholder="Contoh: Tata Kelola Keberlanjutan & Transformasi Kebijakan Fiskal"
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="new-issue-cover" class="block font-semibold text-slate-800 mb-1">
                  URL Gambar Sampul (Cover Image Opsional)
                </label>
                <input
                  type="url"
                  id="new-issue-cover"
                  placeholder="https://cdn.example.com/cover-vol1.jpg atau kosongkan untuk mockup otomatis"
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3 flex items-center gap-2 pt-1">
                <input
                  type="checkbox"
                  id="new-issue-is-current"
                  class="rounded text-blue-600 w-4 h-4 cursor-pointer"
                  checked={issues.length === 0}
                />
                <label for="new-issue-is-current" class="text-xs font-semibold text-slate-800 cursor-pointer">
                  Jadikan langsung sebagai Terbitan Terkini (Current Issue)
                </label>
              </div>
            </div>

            <div class="flex justify-end pt-2">
              <button
                type="submit"
                class="px-5 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-xs transition-colors shadow flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Simpan Edisi Baru</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Panel 4: Rincian Edisi Aktif (Current Issue Settings) -->
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-100 text-academic-navy text-xs font-bold">4</span>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Rincian Informasi Terbitan Aktif (Current Issue)
              </h2>
            </div>
            <p class="text-xs text-academic-ink-muted mt-1">
              Atur detail teks dan tema edisi yang sedang tayang pada bagian "Current Issue" di beranda dan halaman terbitan terkini.
            </p>
          </div>

          <!-- Kartu Info Integrasi DOI per Volume -->
          <div class="bg-amber-50 border border-amber-200 rounded p-4 text-xs space-y-2 mb-5">
            <div class="font-bold text-academic-navy flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Format & Skema Penomoran DOI untuk Volume & Issue Ini:</span>
            </div>
            <p class="text-slate-700">
              Setiap naskah yang diterbitkan pada volume dan issue ini secara otomatis terhubung dengan formula DOI resmi jurnal:
            </p>
            <div class="font-mono text-amber-900 bg-white p-2.5 rounded border border-amber-300 font-semibold flex items-center justify-between flex-wrap gap-2">
              <span id="vol-doi-formula-preview">https://doi.org/{defaultDoiPrefix}/jteba.v{journalConfig.currentIssue?.volume ?? 1}i{journalConfig.currentIssue?.issue ?? 1}.[nomor_urut_artikel]</span>
              <span class="text-xs font-sans font-normal text-slate-500">Contoh Naskah #1: https://doi.org/{defaultDoiPrefix}/jteba.v{journalConfig.currentIssue?.volume ?? 1}i{journalConfig.currentIssue?.issue ?? 1}.1</span>
            </div>
          </div>

          <form id="form-volume-settings" class="space-y-4 text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50 p-4 sm:p-5 rounded border border-slate-200">
              <div>
                <label for="cfg-vol-num" class="block font-semibold text-slate-800 mb-1">
                  Volume Terbitan Aktif <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-vol-num"
                  value={journalConfig.currentIssue?.volume ?? 1}
                  min="1"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="cfg-issue-num" class="block font-semibold text-slate-800 mb-1">
                  Nomor Issue Terbitan Aktif <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-issue-num"
                  value={journalConfig.currentIssue?.issue ?? 1}
                  min="1"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="cfg-issue-year" class="block font-semibold text-slate-800 mb-1">
                  Tahun Terbitan <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-issue-year"
                  value={journalConfig.currentIssue?.year ?? 2026}
                  min="2020"
                  max="2040"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-period" class="block font-semibold text-slate-800 mb-1">
                  Periode / Bulan Publikasi Edisi <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-issue-period"
                  value={journalConfig.currentIssue?.period || 'Maret 2026'}
                  placeholder="Contoh: Maret 2026 atau Januari - Juni 2026"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-cover" class="block font-semibold text-slate-800 mb-1">
                  URL Gambar Sampul (Cover Image) Edisi
                </label>
                <input
                  type="url"
                  id="cfg-issue-cover"
                  value={journalConfig.currentIssue?.coverUrl || ''}
                  placeholder="https://cdn.example.com/one/cover-vol1.jpg atau kosongkan untuk mockup otomatis"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white font-mono outline-none focus:border-academic-navy"
                />
                <span class="text-xs text-slate-500 mt-1 block">
                  Kosongkan jika ingin menggunakan mockup kartu sampul bergaya OJS secara otomatis.
                </span>
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-theme" class="block font-semibold text-slate-800 mb-1">
                  Tema Khusus / Keterangan Edisi Ini
                </label>
                <textarea
                  id="cfg-issue-theme"
                  rows="2"
                  placeholder="Contoh: Edisi Perdana: Inovasi Audit, Akuntansi Keberlanjutan & Modernisasi Sistem Perpajakan"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white outline-none focus:border-academic-navy"
                >{journalConfig.currentIssue?.theme || ''}</textarea>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Detail Terbitan Aktif</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGUMUMAN / ANNOUNCEMENT -->
      <div id="tab-announcement-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengumuman Redaksi & Call for Papers
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Pengumuman ini tampil langsung pada kartu atas beranda jurnal dan dapat diaktifkan atau dinonaktifkan kapan saja.
            </p>
          </div>

          <form id="form-announcement-settings" class="space-y-4 text-xs">
            <div class="p-4 bg-amber-50/60 border border-amber-200 rounded space-y-4">
              <div class="flex items-center gap-2">
                <input
                  type="checkbox"
                  id="cfg-ann-active"
                  checked={journalConfig.announcement?.active}
                  class="w-4 h-4 rounded text-amber-700 cursor-pointer"
                />
                <label for="cfg-ann-active" class="font-bold text-amber-950 cursor-pointer text-xs">
                  Tampilkan Kotak Pengumuman ini di Beranda Jurnal
                </label>
              </div>

              <div>
                <label for="cfg-ann-title" class="block font-semibold text-slate-800 mb-1">
                  Judul Pengumuman <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-ann-title"
                  value={journalConfig.announcement?.title || ''}
                  placeholder="Contoh: Call for Papers: Volume 1 Nomor 1 (2026)"
                  class="w-full px-3 py-2 border border-slate-300 rounded font-serif text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-ann-date" class="block font-semibold text-slate-800 mb-1">
                  Tanggal Pengumuman (YYYY-MM-DD)
                </label>
                <input
                  type="text"
                  id="cfg-ann-date"
                  value={journalConfig.announcement?.date || ''}
                  placeholder="2026-03-01"
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-ann-content" class="block font-semibold text-slate-800 mb-1">
                  Isi Pengumuman Lengkap
                </label>
                <textarea
                  id="cfg-ann-content"
                  rows="4"
                  placeholder="Tuliskan isi pengumuman, ruang lingkup naskah, atau tanggal penting..."
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white leading-relaxed"
                >{journalConfig.announcement?.content || ''}</textarea>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Pengumuman ke Database</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGATURAN KONTAK WA, EMAIL & JURNAL -->
      <div id="tab-journal-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengaturan Narahubung Redaksi & Komunitas
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Data ini langsung tersimpan ke database dan mengupdate tombol WhatsApp, email, dan footer.
            </p>
          </div>

          <form id="form-contact-settings" class="space-y-4 text-xs">
            <!-- Kontak WhatsApp & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-emerald-50/50 p-4 rounded border border-emerald-200">
              <div>
                <label for="cfg-wa-num" class="block font-semibold text-emerald-950 mb-1">
                  Nomor WhatsApp API (Format: 628xxxxxxxxxx) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-wa-num"
                  value={journalConfig.submission.whatsappNumber}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-wa-display" class="block font-semibold text-emerald-950 mb-1">
                  Tampilan Nomor WhatsApp di Web <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-wa-display"
                  value={journalConfig.submission.whatsappDisplay}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="cfg-email" class="block font-semibold text-emerald-950 mb-1">
                  Alamat Email Resmi Redaksi <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="cfg-email"
                  value={journalConfig.submission.email}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="cfg-wa-msg" class="block font-semibold text-emerald-950 mb-1">
                  Pesan Pembuka Otomatis WhatsApp Penulis
                </label>
                <input
                  type="text"
                  id="cfg-wa-msg"
                  value={journalConfig.submission.whatsappDefaultMessage}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>
            </div>

            <!-- Fitur Sidebar Toggles -->
            <div class="p-4 bg-white border border-slate-200 rounded space-y-2">
              <span class="font-bold text-academic-navy block mb-2">Visibilitas Modul Sidebar Kanan:</span>
              <div class="flex flex-wrap gap-4 text-xs">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-idx" checked={journalConfig.features.showIndexingBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Kotak Indexed By</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-tools" checked={journalConfig.features.showToolsBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Recommended Tools</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-issn" checked={journalConfig.features.showIssnBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Barcode ISSN</span>
                </label>
              </div>
            </div>

            <div class="pt-2 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Pengaturan Kontak & Jurnal</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 5: PENGATURAN INDEXING & PENGINDEKS -->
      <div id="tab-indexing-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white">
          <div class="border-b border-slate-200 pb-3 mb-6 flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Kelola Pangkalan Data & Pengindeks Jurnal
              </h2>
              <p class="text-xs text-academic-ink-muted mt-1">
                Centang pada kolom "Di Sidebar" untuk langsung menampilkan atau menyembunyikan logo pengindeks di bilah kanan.
              </p>
            </div>
            <a
              href="/index/JTEBA/indexing"
              target="_blank"
              class="text-xs font-semibold text-blue-700 hover:underline"
            >
              Buka Halaman Indexing Publik ↗
            </a>
          </div>

          <!-- Tabel Status Pengindeks -->
          <div class="overflow-x-auto mb-6">
            <table id="table-indexing" class="w-full text-xs text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-300">
                  <th class="p-2.5 font-semibold">Nama Pengindeks</th>
                  <th class="p-2.5 font-semibold">Ikon</th>
                  <th class="p-2.5 font-semibold">Kategori</th>
                  <th class="p-2.5 font-semibold">Status</th>
                  <th class="p-2.5 font-semibold text-center">Tampil di Sidebar</th>
                  <th class="p-2.5 font-semibold">Tautan URL</th>
                  <th class="p-2.5 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {indexing.length === 0 ? (
                  <tr id="row-indexing-empty">
                    <td colspan="7" class="p-8 text-center text-slate-500 italic bg-slate-50/50">
                      Belum ada pangkalan data pengindeks di database. Gunakan formulir di bawah untuk menambahkan pengindeks baru.
                    </td>
                  </tr>
                ) : (
                  indexing.map((idx) => (
                    <tr class="hover:bg-slate-50">
                      <td class="p-2.5 font-bold text-slate-900">{idx.name}</td>
                      <td class="p-2.5">
                        <div class="flex items-center gap-1.5">
                          {idx.iconUrl ? (
                            <img src={idx.iconUrl} alt={idx.name} class="w-7 h-7 object-contain rounded border border-slate-200 bg-white p-0.5 shrink-0" />
                          ) : (
                            <span class="w-7 h-7 rounded border border-dashed border-slate-300 flex items-center justify-center text-xs text-slate-400 bg-slate-50 shrink-0">N/A</span>
                          )}
                          <label class="cursor-pointer text-xs text-blue-700 hover:underline shrink-0 font-medium">
                            Ubah
                            <input
                              type="file"
                              class="row-idx-icon-file hidden"
                              data-name={idx.name}
                              accept=".png,.jpg,.jpeg,.svg,.webp"
                            />
                          </label>
                        </div>
                      </td>
                      <td class="p-2.5 text-slate-600">{idx.category}</td>
                      <td class="p-2.5">
                        <span class={`text-xs font-bold px-2 py-0.5 rounded-xs uppercase ${
                          idx.status === 'Indexed'
                            ? 'bg-emerald-100 text-emerald-800'
                            : idx.status === 'In Process'
                            ? 'bg-blue-100 text-blue-800'
                            : 'bg-amber-100 text-amber-800'
                        }`}>
                          {idx.status}
                        </span>
                      </td>
                      <td class="p-2.5 text-center">
                        <input
                          type="checkbox"
                          class="toggle-index-sidebar cursor-pointer"
                          data-name={idx.name}
                          checked={idx.showInSidebar}
                        />
                      </td>
                      <td class="p-2.5">
                        <div class="flex items-center gap-1.5 min-w-[260px]">
                          <input
                            type="url"
                            value={idx.url}
                            class="input-index-url w-full px-2.5 py-1 text-xs font-mono border border-slate-300 rounded focus:border-blue-600 outline-none"
                            data-name={idx.name}
                            placeholder="https://..."
                          />
                          <button
                            type="button"
                            class="btn-save-index-url shrink-0 px-3 py-1 bg-slate-700 hover:bg-slate-800 text-white text-xs font-semibold rounded transition-colors"
                            data-name={idx.name}
                          >
                            Simpan
                          </button>
                        </div>
                      </td>
                      <td class="p-2.5 text-right">
                        <button
                          type="button"
                          class="btn-delete-indexing text-red-600 hover:text-red-800 font-semibold text-xs px-2.5 py-1 rounded hover:bg-red-50 transition-colors"
                          data-name={idx.name}
                        >
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>

          <!-- Formulir Tambah Pangkalan Pengindeks Baru -->
          <div class="pt-6 border-t border-slate-200">
            <h3 class="text-sm font-bold text-academic-navy mb-1 flex items-center gap-2">
              <span class="inline-block w-2.5 h-2.5 rounded-full bg-academic-gold"></span>
              Tambah Pangkalan Pengindeks Baru
            </h3>
            <p class="text-xs text-slate-500 mb-4">
              Daftarkan pengindeks baru (misal: Google Scholar, Garuda, SINTA, Crossref, DOAJ, Scopus, Dimension, BASE, Scilit).
            </p>

            <form id="form-add-indexing" class="space-y-4 bg-slate-50 p-4 rounded border border-slate-200">
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Pengindeks *</label>
                  <input
                    type="text"
                    id="new-idx-name"
                    required
                    placeholder="Contoh: Google Scholar"
                    class="w-full px-3 py-2 text-xs border border-slate-300 rounded focus:border-academic-navy outline-none bg-white"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori *</label>
                  <select
                    id="new-idx-category"
                    class="w-full px-3 py-2 text-xs border border-slate-300 rounded focus:border-academic-navy outline-none bg-white"
                  >
                    <option value="International">International</option>
                    <option value="National">National</option>
                    <option value="Institutional">Institutional</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Status Akreditasi / Indeks *</label>
                  <select
                    id="new-idx-status"
                    class="w-full px-3 py-2 text-xs border border-slate-300 rounded focus:border-academic-navy outline-none bg-white"
                  >
                    <option value="Indexed">Indexed (Terindeks)</option>
                    <option value="In Process">In Process (Dalam Proses)</option>
                    <option value="Evaluation">Evaluation (Tahap Evaluasi)</option>
                  </select>
                </div>
              </div>

              <!-- Input Unggah Ikon Pengindeks -->
              <div class="p-3 bg-white border border-slate-300 rounded space-y-2">
                <label class="block text-xs font-semibold text-slate-700">
                  Unggah Ikon / Logo Pengindeks (.png, .jpg, .svg, .webp)
                </label>
                <div class="flex flex-wrap items-center gap-3">
                  <div id="new-idx-icon-preview" class="w-10 h-10 rounded border border-dashed border-slate-300 flex items-center justify-center bg-slate-50 text-slate-400 shrink-0 overflow-hidden">
                    <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-[200px]">
                    <input
                      type="file"
                      id="new-idx-icon-file"
                      accept=".png,.jpg,.jpeg,.svg,.webp"
                      class="block w-full text-xs text-slate-500 file:mr-2.5 file:py-1 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer"
                    />
                    <input type="hidden" id="new-idx-icon-url" value="" />
                    <p id="new-idx-icon-status" class="text-xs text-slate-500 mt-1">Opsional. Logo akan tampil di Sidebar & halaman /indexing (maks. 500 KB).</p>
                  </div>
                </div>
              </div>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Tautan URL Resmi Pengindeks *</label>
                  <input
                    type="url"
                    id="new-idx-url"
                    required
                    placeholder="https://scholar.google.com/citations?user=..."
                    class="w-full px-3 py-2 text-xs font-mono border border-slate-300 rounded focus:border-academic-navy outline-none bg-white"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Singkat Pengindeks</label>
                  <input
                    type="text"
                    id="new-idx-desc"
                    placeholder="Contoh: Pangkalan data rujukan sitasi ilmiah internasional terbesar."
                    class="w-full px-3 py-2 text-xs border border-slate-300 rounded focus:border-academic-navy outline-none bg-white"
                  />
