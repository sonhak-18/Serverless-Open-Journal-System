        <div class="sm:col-span-2">
          <span class="text-slate-500 font-semibold block text-[11px] mb-1">Berkas Manuskrip:</span>
          <div class="p-2.5 bg-white border border-slate-200 rounded flex items-start gap-2">
            <svg class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
            <div class="flex-1 min-w-0">
              <span id="sub-detail-file" class="font-mono text-slate-800 break-all select-all block text-xs font-medium"></span>
              <span id="sub-detail-supp" class="font-mono text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded border border-purple-200 text-[10px] break-all select-all inline-block mt-1 hidden"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Abstract Section -->
      <div>
        <label class="block text-xs font-bold text-academic-navy mb-1 uppercase tracking-wider">
          Abstrak Manuskrip
        </label>
        <div id="sub-detail-abstract" class="p-3.5 bg-white border border-slate-200 rounded text-xs text-slate-700 leading-relaxed max-h-60 overflow-y-auto whitespace-pre-wrap font-sans">
        </div>
      </div>

      <!-- Modal Actions -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-3 border-t border-slate-200">
        <div class="flex items-center gap-2">
          <a
            id="sub-detail-wa-btn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 text-xs font-semibold rounded bg-emerald-600 hover:bg-emerald-700 text-white transition-colors inline-flex items-center gap-1.5"
          >
            <span>Hubungi WhatsApp</span>
          </a>
          <a
            id="sub-detail-mail-btn"
            href="#"
            class="px-3 py-1.5 text-xs font-semibold rounded bg-blue-600 hover:bg-blue-700 text-white transition-colors inline-flex items-center gap-1.5"
          >
            <span>Kirim Surel</span>
          </a>
        </div>
        <div class="flex items-center gap-2">
          <button
            type="button"
            id="sub-detail-publish-btn"
            class="px-3.5 py-1.5 text-xs font-bold rounded bg-academic-navy hover:bg-academic-navy-light text-white transition-colors"
          >
            Salin ke Form Publikasi
          </button>
          <button
            type="button"
            id="btn-close-sub-modal-footer"
            class="px-3 py-1.5 text-xs font-semibold rounded bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors"
