  <!-- Modal Konfirmasi Hapus Kustom (Indah, Bersih, Akademik) -->
  <div id="confirm-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded border border-slate-200 shadow-2xl max-w-md w-full p-6 space-y-4 animate-in fade-in zoom-in-95">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-full bg-red-50 text-red-700 flex items-center justify-center shrink-0 border border-red-200">
          <svg class="w-5 h-5 text-rose-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </div>
        <div>
          <h3 id="confirm-modal-title" class="text-base font-serif font-bold text-academic-navy leading-snug">
            Konfirmasi Penghapusan
          </h3>
          <p id="confirm-modal-desc" class="text-xs text-slate-600 mt-1 leading-relaxed">
            Apakah Anda yakin ingin menghapus data ini dari database? Tindakan ini bersifat permanen.
          </p>
        </div>
      </div>

      <div id="confirm-modal-item" class="p-3 bg-slate-50 border border-slate-200 rounded text-xs font-mono text-slate-800 break-all">
        <!-- Item detail -->
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button
          type="button"
          id="btn-cancel-modal"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded transition-colors"
        >
          Batal
        </button>
        <button
          type="button"
          id="btn-confirm-delete"
          class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded shadow-xs transition-colors"
        >
          Ya, Hapus Sekarang
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Keamanan: Bersihkan token repositori yang pernah tersimpan di localStorage
  try {
    localStorage.removeItem('repo_admin_token');
  } catch (_) {}

  // Simpan token otorisasi repositori hanya di memori sesi aktif (tidak persisten di disk/localStorage)
  let memoryWorkerAdminToken: string | null = null;

  let toastTimeout: any = null;

  function hideToast() {
    const toast = document.getElementById('admin-toast');
    if (!toast) return;
    toast.classList.remove('translate-y-0', 'opacity-100');
    toast.classList.add('-translate-y-4', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 300);
  }

  function showToast(msg: string, isError = false) {
    const toast = document.getElementById('admin-toast');
    const toastMsg = document.getElementById('admin-toast-msg');
    const toastIcon = document.getElementById('admin-toast-icon');
    if (!toast || !toastMsg) return;

    if (toastTimeout) {
      clearTimeout(toastTimeout);
      toastTimeout = null;
    }

    const cleanMsg = msg.replace(/^[✓✕⚡⚠\s]+/, '').trim();
    toastMsg.innerText = cleanMsg;

    if (toastIcon) {
      if (isError) {
        toastIcon.innerHTML = '<svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>';
      } else {
        toastIcon.innerHTML = '<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
      }
    }

    toast.className = `pointer-events-auto transform transition-all duration-300 ease-out bg-white rounded-lg border shadow-xl p-3.5 text-xs sm:text-sm font-medium flex items-start justify-between gap-3 ${
      isError
        ? 'border-rose-300 text-rose-900 bg-rose-50/95 shadow-rose-900/10'
        : 'border-emerald-300 text-emerald-950 bg-emerald-50/95 shadow-emerald-900/10'
    }`;

    toast.classList.remove('hidden');
    requestAnimationFrame(() => {
      toast.classList.remove('-translate-y-4', 'opacity-0');
      toast.classList.add('translate-y-0', 'opacity-100');
    });

    toastTimeout = setTimeout(() => {
      hideToast();
    }, 4000);
  }

  document.getElementById('btn-close-toast')?.addEventListener('click', hideToast);

  // Login & Logout Check
  const loginForm = document.getElementById('admin-login-form');
  const loginLock = document.getElementById('admin-login-lock');
  const dashboardContent = document.getElementById('admin-dashboard-content');
  const loginError = document.getElementById('login-error');
  const adminUsernameInput = document.getElementById('admin-username') as HTMLInputElement | null;
  const adminPinInput = document.getElementById('admin-pin') as HTMLInputElement | null;
  const logoutBtn = document.getElementById('btn-admin-logout');

  logoutBtn?.addEventListener('click', async () => {
    try {
      localStorage.removeItem('repo_admin_token');
      sessionStorage.removeItem('jteba_admin_auth');
      memoryWorkerAdminToken = null;
      await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'logout' }),
      });
    } catch (_) {}
    window.location.reload();
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = adminUsernameInput?.value.trim();
    const pin = adminPinInput?.value.trim();
    if (!username || !pin) return;

    const submitBtn = document.getElementById('login-submit-btn') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Memverifikasi...';
    }

    try {
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'verify', username, pin }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        loginError?.classList.remove('hidden');
        if (loginError && data.error) loginError.textContent = data.error;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Masuk ke Panel Redaksi';
        }
      }
    } catch (err: any) {
      loginError?.classList.remove('hidden');
      if (loginError) loginError.textContent = 'Gagal memverifikasi: ' + err.message;
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Masuk ke Panel Redaksi';
      }
    }
  });

  // Custom Confirmation Modal Helper
  let pendingDeleteAction: (() => Promise<void>) | null = null;
  const confirmModal = document.getElementById('confirm-modal');
  const confirmTitle = document.getElementById('confirm-modal-title');
  const confirmDesc = document.getElementById('confirm-modal-desc');
  const confirmItem = document.getElementById('confirm-modal-item');
  const cancelBtn = document.getElementById('btn-cancel-modal');
  const confirmBtn = document.getElementById('btn-confirm-delete');

  function openConfirmModal(options: {
    title: string;
    message: string;
    item: string;
    onConfirm: () => Promise<void>;
  }) {
    if (confirmTitle) confirmTitle.textContent = options.title;
    if (confirmDesc) confirmDesc.textContent = options.message;
    if (confirmItem) confirmItem.textContent = options.item;
    pendingDeleteAction = options.onConfirm;
    confirmModal?.classList.remove('hidden');
  }

  function closeConfirmModal() {
    confirmModal?.classList.add('hidden');
    pendingDeleteAction = null;
  }

  cancelBtn?.addEventListener('click', closeConfirmModal);
  confirmModal?.addEventListener('click', (e) => {
    if (e.target === confirmModal) closeConfirmModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !confirmModal?.classList.contains('hidden')) {
      closeConfirmModal();
    }
  });

  confirmBtn?.addEventListener('click', async () => {
    if (pendingDeleteAction) {
      const action = pendingDeleteAction;
      closeConfirmModal();
      await action();
    }
  });

  // Tab switching with persistence
  const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tab');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  function switchTab(targetId: string) {
    sessionStorage.setItem('jteba_active_tab', targetId);
    tabs.forEach((t) => {
      if (t.getAttribute('data-tab') === targetId) {
        t.classList.remove('border-transparent', 'text-slate-600');
        t.classList.add('border-academic-navy', 'text-academic-navy', 'font-bold');
      } else {
        t.classList.remove('border-academic-navy', 'text-academic-navy', 'font-bold');
        t.classList.add('border-transparent', 'text-slate-600');
      }
    });

    panels.forEach((p) => {
      if (p.id === targetId) {
        p.classList.remove('hidden');
      } else {
        p.classList.add('hidden');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');
      if (targetId) switchTab(targetId);
    });
  });

  // Restore active tab with URL hash support
  if (window.location.hash === '#form-add-new-issue' || window.location.hash === '#tab-volume-settings') {
    switchTab('tab-volume-settings');
  } else {
    const savedTab = sessionStorage.getItem('jteba_active_tab') || sessionStorage.getItem('sektansia_active_tab');
    if (savedTab && document.getElementById(savedTab)) {
      switchTab(savedTab);
    }
  }

  // Intercept anchor link to #form-add-new-issue so it activates tab-volume-settings
  document.querySelectorAll('a[href="#form-add-new-issue"]').forEach((link) => {
    link.addEventListener('click', () => {
      switchTab('tab-volume-settings');
    });
  });

  // Dynamic Authors Builder Logic
  const authorsContainer = document.getElementById('authors-container');
  const btnAddAuthor = document.getElementById('btn-add-author');

  function updateRemoveButtonsState() {
    if (!authorsContainer) return;
    const rows = authorsContainer.querySelectorAll('.author-row');
    rows.forEach((row) => {
      const btnRemove = row.querySelector('.btn-remove-author') as HTMLButtonElement | null;
      if (btnRemove) {
        btnRemove.disabled = rows.length <= 1;
        if (rows.length <= 1) {
          btnRemove.classList.add('opacity-30', 'cursor-not-allowed');
        } else {
          btnRemove.classList.remove('opacity-30', 'cursor-not-allowed');
        }
      }
    });
  }

  function bindRemoveEvent(btn: HTMLButtonElement) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const rows = authorsContainer?.querySelectorAll('.author-row') || [];
      if (rows.length > 1) {
        const row = btn.closest('.author-row');
        row?.remove();
        updateRemoveButtonsState();
      }
    });
  }

  // Bind initial row's remove button
  const initialRemoveBtn = authorsContainer?.querySelector('.btn-remove-author') as HTMLButtonElement | null;
  if (initialRemoveBtn) {
    bindRemoveEvent(initialRemoveBtn);
  }
  updateRemoveButtonsState();

  btnAddAuthor?.addEventListener('click', () => {
    if (!authorsContainer) return;
    const currentCount = authorsContainer.querySelectorAll('.author-row').length + 1;
    const newRow = document.createElement('div');
    newRow.className = 'author-row bg-white p-4 rounded border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-end shadow-2xs animate-fadeIn';
    newRow.innerHTML = `
      <div class="md:col-span-4">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Nama Penulis #${currentCount} <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="author_name"
          required
          placeholder="Contoh: Nama Penulis Pendamping"
          class="author-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
        />
      </div>
      <div class="md:col-span-4">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Afiliasi / Universitas / Organisasi Riset <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="author_affiliation"
          required
          placeholder="Contoh: Universitas Gadjah Mada"
          class="author-affiliation-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
        />
      </div>
      <div class="md:col-span-3">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Email Korespondensi <span class="text-slate-400 font-normal">(Opsional)</span>
        </label>
        <input
          type="email"
          name="author_email"
          placeholder="penulis@ugm.ac.id"
          class="author-email-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
        />
      </div>
      <div class="md:col-span-1 flex justify-end">
        <button
          type="button"
          class="btn-remove-author p-2 text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors"
          title="Hapus baris penulis ini"
        >
          <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
        </button>
      </div>
    `;

    const btnRemove = newRow.querySelector('.btn-remove-author') as HTMLButtonElement | null;
    if (btnRemove) {
      bindRemoveEvent(btnRemove);
    }

    authorsContainer.appendChild(newRow);
    updateRemoveButtonsState();
  });

  // Otomatisasi URL slug dan DOI naskah
  const artTitleInput = document.getElementById('art-title') as HTMLInputElement | null;
  const artSlugInput = document.getElementById('art-slug') as HTMLInputElement | null;
  const btnGenerateSlug = document.getElementById('btn-generate-slug');
  const btnCopyUrl = document.getElementById('btn-copy-url');
  const previewArtUrl = document.getElementById('preview-art-url');

  const artVolumeInput = document.getElementById('art-volume') as HTMLInputElement | null;
  const artIssueInput = document.getElementById('art-issue') as HTMLInputElement | null;
  const artOrderInput = document.getElementById('art-article-order') as HTMLInputElement | null;
  const artDoiPrefixInput = document.getElementById('art-doi-prefix') as HTMLInputElement | null;
  const artDoiInput = document.getElementById('art-doi') as HTMLInputElement | null;
  const btnGenerateDoi = document.getElementById('btn-generate-doi');
  const btnCopyDoi = document.getElementById('btn-copy-doi');
  const previewArtDoi = document.getElementById('preview-art-doi') as HTMLAnchorElement | null;

  let isSlugManuallyEdited = false;

  function slugify(text: string): string {
    return text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9\s-]/g, '')
      .trim()
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .slice(0, 100);
  }

  function updateSlugPreview() {
    if (!artSlugInput || !previewArtUrl) return;
    const currentOrigin = window.location.origin;
    const slug = artSlugInput.value.trim();
    previewArtUrl.textContent = slug ? `${currentOrigin}/article/${slug}` : `${currentOrigin}/article/...`;
  }

  artTitleInput?.addEventListener('input', () => {
    if (!isSlugManuallyEdited && artSlugInput) {
      artSlugInput.value = slugify(artTitleInput.value);
      updateSlugPreview();
    }
  });

  artSlugInput?.addEventListener('input', () => {
    isSlugManuallyEdited = true;
    updateSlugPreview();
  });

  btnGenerateSlug?.addEventListener('click', () => {
    if (!artTitleInput || !artSlugInput) return;
    if (!artTitleInput.value.trim()) {
      showToast('Silakan isi judul naskah artikel terlebih dahulu!', true);
      artTitleInput.focus();
      return;
    }
    artSlugInput.value = slugify(artTitleInput.value);
    isSlugManuallyEdited = false;
    updateSlugPreview();
    showToast('URL / Slug artikel berhasil digenerate dari judul!');
  });

  btnCopyUrl?.addEventListener('click', () => {
    const slug = artSlugInput?.value.trim();
    if (!slug) {
      showToast('Slug artikel masih kosong!', true);
      return;
    }
    const currentOrigin = window.location.origin;
    const url = `${currentOrigin}/article/${slug}`;
    navigator.clipboard.writeText(url).then(() => {
      showToast('Tautan artikel berhasil disalin: ' + url);
    }).catch(() => {
      showToast('Gagal menyalin tautan', true);
    });
  });

  // Generator DOI Sesuai Format Pengguna:
  // "https://doi.org/10.00000/jteba.v(volume)i(issue).(numerasi artikel keberapa yang terbit di web)"
  function computeDoi(): string {
    const prefix = (artDoiPrefixInput?.value || '10.00000').trim().replace(/^https?:\/\/doi\.org\//i, '').replace(/\/$/, '');
    const vol = Number(artVolumeInput?.value) || 1;
    const iss = Number(artIssueInput?.value) || 1;
    const order = Number(artOrderInput?.value) || 1;
    return `https://doi.org/${prefix}/jteba.v${vol}i${iss}.${order}`;
  }

  function updateDoiPreview() {
    if (!artDoiInput) return;
    const doiVal = artDoiInput.value.trim();
    if (previewArtDoi) {
      previewArtDoi.href = doiVal.startsWith('http') ? doiVal : `https://doi.org/${doiVal}`;
      previewArtDoi.textContent = doiVal;
    }
  }

  function syncDoiFields() {
    if (!artDoiInput) return;
    artDoiInput.value = computeDoi();
    updateDoiPreview();
  }

  [artVolumeInput, artIssueInput, artOrderInput, artDoiPrefixInput].forEach((input) => {
    input?.addEventListener('input', () => {
      syncDoiFields();
    });
  });

  artDoiInput?.addEventListener('input', () => {
    updateDoiPreview();
  });

  btnGenerateDoi?.addEventListener('click', () => {
    syncDoiFields();
    showToast('Nomor DOI berhasil digenerate otomatis!');
  });

  btnCopyDoi?.addEventListener('click', () => {
    const doiVal = artDoiInput?.value.trim();
    if (!doiVal) {
      showToast('DOI naskah masih kosong!', true);
      return;
    }
    navigator.clipboard.writeText(doiVal).then(() => {
      showToast('DOI naskah berhasil disalin: ' + doiVal);
    }).catch(() => {
      showToast('Gagal menyalin DOI', true);
    });
  });

  // Sync Volume Settings tab with DOI preview
  const cfgVolNum = document.getElementById('cfg-vol-num') as HTMLInputElement | null;
  const cfgIssueNum = document.getElementById('cfg-issue-num') as HTMLInputElement | null;
  const volDoiFormulaPreview = document.getElementById('vol-doi-formula-preview');

  function updateVolDoiFormulaPreview() {
    if (!volDoiFormulaPreview) return;
    const prefix = (artDoiPrefixInput?.value || '10.00000').trim().replace(/^https?:\/\/doi\.org\//i, '').replace(/\/$/, '');
    const vol = cfgVolNum ? Number(cfgVolNum.value) || 1 : 1;
    const iss = cfgIssueNum ? Number(cfgIssueNum.value) || 1 : 1;
    volDoiFormulaPreview.textContent = `https://doi.org/${prefix}/jteba.v${vol}i${iss}.[nomor_urut_artikel]`;
  }

  cfgVolNum?.addEventListener('input', updateVolDoiFormulaPreview);
  cfgIssueNum?.addEventListener('input', updateVolDoiFormulaPreview);

  // Pengiriman naskah baru
  const articleForm = document.getElementById('form-new-article');
  articleForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = (document.getElementById('art-title') as HTMLInputElement).value.trim();
    const subject = (document.getElementById('art-subject') as HTMLSelectElement).value;
    let slug = (document.getElementById('art-slug') as HTMLInputElement)?.value.trim();
    if (!slug) {
      slug = slugify(title);
      if (artSlugInput) artSlugInput.value = slug;
    }
    const abstract = (document.getElementById('art-abstract') as HTMLTextAreaElement).value.trim();
    const keywordsRaw = (document.getElementById('art-keywords') as HTMLInputElement).value.trim();
    const pdfFile = (document.getElementById('art-pdffile') as HTMLInputElement).value.trim();
    const volume = Number((document.getElementById('art-volume') as HTMLInputElement).value) || 1;
    const issue = Number((document.getElementById('art-issue') as HTMLInputElement).value) || 1;
    const pages = (document.getElementById('art-pages') as HTMLInputElement).value.trim() || '1-10';
    let doi = (document.getElementById('art-doi') as HTMLInputElement)?.value.trim();
    if (!doi) {
      doi = computeDoi();
      if (artDoiInput) artDoiInput.value = doi;
    }

    // Kumpulkan penulis dari konfigurasi panel mandiri
    const authorRows = authorsContainer ? authorsContainer.querySelectorAll('.author-row') : [];
    const authorsList: { name: string; affiliation: string; email?: string }[] = [];

    authorRows.forEach((row) => {
      const nameInput = row.querySelector('.author-name-input') as HTMLInputElement | null;
      const affInput = row.querySelector('.author-affiliation-input') as HTMLInputElement | null;
      const emailInput = row.querySelector('.author-email-input') as HTMLInputElement | null;

      if (nameInput && nameInput.value.trim()) {
        const item: { name: string; affiliation: string; email?: string } = {
          name: nameInput.value.trim(),
          affiliation: affInput ? affInput.value.trim() : '',
        };
        if (emailInput && emailInput.value.trim()) {
          item.email = emailInput.value.trim();
        }
        authorsList.push(item);
      }
    });

    if (authorsList.length === 0) {
      showToast('Harap masukkan minimal satu nama penulis naskah!', true);
      return;
    }

    const keywordsList = keywordsRaw.split(',').map((k) => k.trim());
    const [firstP, lastP] = pages.split('-').map((p) => Number(p.trim()) || 1);
    const today = new Date().toISOString().split('T')[0];
    const referencesRaw = (document.getElementById('art-references') as HTMLTextAreaElement)?.value || '';
    const referencesList = referencesRaw.split('\n').map((r) => r.trim()).filter(Boolean);

    const articleData = {
      slug,
      title,
      authors: authorsList,
      abstract,
      keywords: keywordsList,
      volume,
      issue,
      year: new Date().getFullYear(),
      pages,
      firstPage: firstP,
      lastPage: lastP || firstP + 10,
      publishDate: today,
      receivedDate: today,
      acceptedDate: today,
      doi,
      pdfFileName: pdfFile,
      fileSizeBytes: 450000,
      subject,
      references: referencesList,
    };

    try {
      const res = await fetch('/api/articles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add', article: articleData }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('Artikel berhasil diterbitkan dan tersimpan di database!');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('Gagal menyimpan artikel: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Terjadi kesalahan jaringan: ' + err.message, true);
    }
  });

  // Hapus Artikel (Modal Kustom & Hapus Baris Tanpa Reload)
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-article').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      if (!slug) return;
      const row = btn.closest('tr');
      const title = row?.querySelector('td')?.textContent?.trim() || slug;

      openConfirmModal({
        title: 'Hapus Naskah Artikel',
        message: 'Naskah artikel ini akan dihapus secara permanen dari database Cloudflare D1. Tindakan ini tidak dapat dibatalkan.',
        item: `Judul: "${title}" (Slug: ${slug})`,
        onConfirm: async () => {
          try {
            const res = await fetch('/api/articles', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', slug }),
            });
            const json = await res.json();
            if (json.success) {
              if (row) {
                row.style.transition = 'all 0.3s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => row.remove(), 300);
              }
              const tabArt = document.querySelector('[data-tab="tab-articles-list"]');
              if (tabArt) {
                const currentRows = document.querySelectorAll('#tab-articles-list tbody tr').length - 1;
                tabArt.textContent = `Naskah Terbit (${Math.max(0, currentRows)})`;
              }
              showToast(`Artikel "${slug}" berhasil dihapus dari database!`);
            } else {
              showToast('Gagal menghapus: ' + json.error, true);
            }
          } catch (err: any) {
            showToast('Gagal menghapus: ' + err.message, true);
          }
        },
      });
    });
  });

  // Pengelolaan Naskah Masuk (Submissions)
  const subModal = document.getElementById('submission-detail-modal');
  const subDetailReg = document.getElementById('sub-detail-reg');
  const subDetailTitle = document.getElementById('sub-detail-title');
  const subDetailAuthor = document.getElementById('sub-detail-author');
  const subDetailAffil = document.getElementById('sub-detail-affiliation');
  const subDetailEmail = document.getElementById('sub-detail-email');
  const subDetailPhone = document.getElementById('sub-detail-phone');
  const subDetailScope = document.getElementById('sub-detail-scope');
  const subDetailFile = document.getElementById('sub-detail-file');
  const subDetailAbstract = document.getElementById('sub-detail-abstract');
  const subDetailWaBtn = document.getElementById('sub-detail-wa-btn') as HTMLAnchorElement | null;
  const subDetailMailBtn = document.getElementById('sub-detail-mail-btn') as HTMLAnchorElement | null;
  const subDetailPublishBtn = document.getElementById('sub-detail-publish-btn') as HTMLButtonElement | null;
  let currentActiveSubmission: any = null;

  function closeSubDetailModal() {
    subModal?.classList.add('hidden');
    currentActiveSubmission = null;
  }

  document.getElementById('btn-close-sub-modal')?.addEventListener('click', closeSubDetailModal);
  document.getElementById('btn-close-sub-modal-footer')?.addEventListener('click', closeSubDetailModal);
  subModal?.addEventListener('click', (e) => {
    if (e.target === subModal) closeSubDetailModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !subModal?.classList.contains('hidden')) {
      closeSubDetailModal();
    }
  });

  function formatBytesClient(bytes: number): string {
    if (!bytes || bytes <= 0) return '0 B';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  function openSubDetail(sub: any) {
    currentActiveSubmission = sub;
    const authorName = `${sub.firstName} ${sub.lastName}`.trim();
    if (subDetailReg) subDetailReg.textContent = sub.regNumber;
    if (subDetailTitle) subDetailTitle.textContent = sub.title;
    if (subDetailAuthor) subDetailAuthor.textContent = authorName;
    if (subDetailAffil) {
      const loc = [sub.city, sub.country].filter(Boolean).join(', ');
      subDetailAffil.textContent = sub.affiliation + (loc ? ` (${loc})` : '');
    }
    if (subDetailEmail) subDetailEmail.textContent = sub.email;
    if (subDetailPhone) subDetailPhone.textContent = sub.phone || '-';
    if (subDetailScope) subDetailScope.textContent = sub.scopeCluster;
    if (subDetailFile) {
      subDetailFile.textContent = `${sub.fileName} (${formatBytesClient(sub.fileSize)})`;
    }
    const subDetailSupp = document.getElementById('sub-detail-supp');
    if (subDetailSupp) {
      if (sub.supplementaryFileName) {
        subDetailSupp.textContent = `Lampiran Tambahan: ${sub.supplementaryFileName}`;
        subDetailSupp.classList.remove('hidden');
      } else {
        subDetailSupp.classList.add('hidden');
      }
    }
    if (subDetailAbstract) subDetailAbstract.textContent = sub.abstract;

    if (subDetailWaBtn) {
      const waClean = sub.phone ? sub.phone.replace(/[^0-9]/g, '') : '';
      if (waClean) {
        const fullWa = waClean.startsWith('0') ? '62' + waClean.substring(1) : waClean;
        subDetailWaBtn.href = `https://wa.me/${fullWa}?text=${encodeURIComponent(`Halo Bapak/Ibu ${authorName},\n\nKami dari Dewan Redaksi JTEBA (Jurnal Terbuka Ekonomi, Bisnis, dan Akuntabilitas) mengonfirmasi perihal manuskrip naskah Anda:\n\nNo. Registrasi: ${sub.regNumber}\nJudul: "${sub.title}"\n\n`)}`;
        subDetailWaBtn.style.display = '';
      } else {
        subDetailWaBtn.style.display = 'none';
      }
    }

    if (subDetailMailBtn) {
      subDetailMailBtn.href = `mailto:${sub.email}?subject=${encodeURIComponent(`[JTEBA] Konfirmasi Naskah ${sub.regNumber}: ${sub.title}`)}`;
    }

    subModal?.classList.remove('hidden');
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-view-submission').forEach((btn) => {
    btn.addEventListener('click', () => {
      try {
        const raw = btn.getAttribute('data-submission');
        if (raw) {
          const parsed = JSON.parse(raw);
          openSubDetail(parsed);
        }
      } catch (e) {
        console.error('Failed to parse submission json', e);
      }
    });
  });

  function transferSubmissionToPublish(sub: { title: string; author: string; affiliation: string; email?: string; subject: string; abstract: string; regNumber?: string }) {
    if (artTitleInput) {
      artTitleInput.value = sub.title;
      if (artSlugInput) {
        artSlugInput.value = slugify(sub.title);
        updateSlugPreview();
      }
    }
    const abstractInput = document.getElementById('art-abstract') as HTMLTextAreaElement | null;
    if (abstractInput) {
      abstractInput.value = sub.abstract;
    }
    const authorNameInput = document.querySelector<HTMLInputElement>('.author-name-input');
    const authorAffilInput = document.querySelector<HTMLInputElement>('.author-affiliation-input');
    const authorEmailInput = document.querySelector<HTMLInputElement>('.author-email-input');
    if (authorNameInput) authorNameInput.value = sub.author;
    if (authorAffilInput) authorAffilInput.value = sub.affiliation;
    if (authorEmailInput && sub.email) authorEmailInput.value = sub.email;

    const subjectSelect = document.getElementById('art-subject') as HTMLSelectElement | null;
    if (subjectSelect && sub.subject) {
      for (let i = 0; i < subjectSelect.options.length; i++) {
        if (subjectSelect.options[i].value === sub.subject || subjectSelect.options[i].text.includes(sub.subject)) {
          subjectSelect.selectedIndex = i;
          break;
        }
      }
    }

    closeSubDetailModal();
    switchTab('tab-add-article');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    showToast(`Data naskah ${sub.regNumber || ''} berhasil disalin ke formulir publikasi! Silakan lengkapi berkas dan terbitkan.`);
  }

  document.querySelectorAll<HTMLButtonElement>('.btn-publish-submission').forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-title') || '';
      const author = btn.getAttribute('data-author') || '';
      const affiliation = btn.getAttribute('data-affiliation') || '';
      const email = btn.getAttribute('data-email') || '';
      const subject = btn.getAttribute('data-subject') || '';
      const abstract = btn.getAttribute('data-abstract') || '';
      transferSubmissionToPublish({ title, author, affiliation, email, subject, abstract });
    });
  });

  subDetailPublishBtn?.addEventListener('click', () => {
    if (currentActiveSubmission) {
      const author = `${currentActiveSubmission.firstName} ${currentActiveSubmission.lastName}`.trim();
      transferSubmissionToPublish({
        title: currentActiveSubmission.title,
        author,
        affiliation: currentActiveSubmission.affiliation,
        email: currentActiveSubmission.email,
        subject: currentActiveSubmission.scopeCluster,
        abstract: currentActiveSubmission.abstract,
        regNumber: currentActiveSubmission.regNumber,
      });
    }
  });

  // Helper pewarnaan status dropdown naskah
  function applyStatusSelectStyle(sel: HTMLSelectElement) {
    const st = sel.value;
    sel.classList.remove(
      'bg-blue-50', 'text-blue-800', 'border-blue-300',
      'bg-amber-50', 'text-amber-800', 'border-amber-300',
      'bg-orange-50', 'text-orange-800', 'border-orange-300',
      'bg-emerald-50', 'text-emerald-800', 'border-emerald-300',
      'bg-rose-50', 'text-rose-800', 'border-rose-300'
    );
    if (st === 'submitted') {
      sel.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-300');
    } else if (st === 'under_review') {
      sel.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-300');
    } else if (st === 'revision') {
      sel.classList.add('bg-orange-50', 'text-orange-800', 'border-orange-300');
    } else if (st === 'accepted') {
      sel.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-300');
    } else if (st === 'declined') {
      sel.classList.add('bg-rose-50', 'text-rose-800', 'border-rose-300');
    }
  }

  // Reactive state grouping & filter naskah
  let currentSubmissionFilter = 'all';

  function updateSubmissionFilterCounts() {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.submission-row'));
    const total = rows.length;
    const counts: Record<string, number> = {
      all: total,
      submitted: 0,
      under_review: 0,
      revision: 0,
      accepted: 0,
      declined: 0,
    };

    rows.forEach((r) => {
      const st = r.getAttribute('data-status') || 'submitted';
      if (counts[st] !== undefined) {
        counts[st]++;
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.filter-submission-btn').forEach((btn) => {
      const f = btn.getAttribute('data-filter') || 'all';
      const labelMap: Record<string, string> = {
        all: `Semua (${counts.all})`,
        submitted: `Baru (${counts.submitted})`,
        under_review: `Review (${counts.under_review})`,
        revision: `Revisi (${counts.revision})`,
        accepted: `Diterima (${counts.accepted})`,
        declined: `Ditolak (${counts.declined})`,
      };
      if (labelMap[f]) {
        btn.textContent = labelMap[f];
      }
    });

    // Perbarui counter tab di sidebar / header admin jika tersedia
    const tabSub = document.querySelector('[data-tab="tab-submissions-list"] span:last-child');
    if (tabSub) {
      tabSub.textContent = `Naskah Masuk (${total})`;
    }
  }

  function applySubmissionFiltering() {
    const q = (document.getElementById('search-submission-input') as HTMLInputElement)?.value.toLowerCase().trim() || '';
    const rows = document.querySelectorAll<HTMLElement>('.submission-row');
    let visibleCount = 0;

    rows.forEach((r) => {
      const rowStatus = r.getAttribute('data-status') || '';
      const searchKey = r.getAttribute('data-search') || '';

      const matchesFilter = currentSubmissionFilter === 'all' || rowStatus === currentSubmissionFilter;
      const matchesSearch = !q || searchKey.includes(q);

      if (matchesFilter && matchesSearch) {
        r.style.display = '';
        visibleCount++;
      } else {
        r.style.display = 'none';
      }
    });

    const showingText = document.getElementById('submission-showing-counter');
    if (showingText) {
      showingText.textContent = `Menampilkan ${visibleCount} dari ${rows.length} naskah di database D1`;
    }

    const tableBody = document.getElementById('submission-table-body');
    let noMatchRow = document.getElementById('submission-no-match-row');
    if (visibleCount === 0 && rows.length > 0) {
      if (!noMatchRow && tableBody) {
        noMatchRow = document.createElement('tr');
        noMatchRow.id = 'submission-no-match-row';
        noMatchRow.innerHTML = `
          <td colspan="5" class="p-8 text-center text-slate-500 italic bg-slate-50/50">
            <p class="text-xs text-slate-600 font-medium">Tidak ada naskah yang cocok dengan filter atau kata kunci pencarian.</p>
          </td>
        `;
        tableBody.appendChild(noMatchRow);
      } else if (noMatchRow) {
        noMatchRow.style.display = '';
      }
    } else if (noMatchRow) {
      noMatchRow.style.display = 'none';
    }
  }

  // Inisialisasi awal select styles & status counter
  document.querySelectorAll<HTMLSelectElement>('.submission-status-select').forEach(applyStatusSelectStyle);
  updateSubmissionFilterCounts();

  // Pembaruan Status Naskah Masuk
  document.querySelectorAll<HTMLSelectElement>('.submission-status-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const regNumber = sel.getAttribute('data-reg');
      const status = sel.value;
      if (!regNumber) return;

      const syncLabel = sel.parentElement?.querySelector('.status-sync-indicator');
      if (syncLabel) {
        syncLabel.textContent = 'Menyimpan...';
        syncLabel.className = 'text-[10px] text-blue-600 mt-1 status-sync-indicator';
      }

      try {
        const res = await fetch('/api/submissions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'update-status', regNumber, status }),
        });
        const data = await res.json();
        if (data.success) {
          if (syncLabel) {
            syncLabel.textContent = 'Tersimpan di D1';
            syncLabel.className = 'text-[10px] text-emerald-600 font-semibold mt-1 status-sync-indicator';
          }
          const row = sel.closest('.submission-row') as HTMLElement | null;
          if (row) {
            row.setAttribute('data-status', status);
            const viewBtn = row.querySelector('.btn-view-submission');
            if (viewBtn) {
              try {
                const currentSub = JSON.parse(viewBtn.getAttribute('data-submission') || '{}');
                currentSub.status = status;
                viewBtn.setAttribute('data-submission', JSON.stringify(currentSub));
              } catch (_) {}
            }
          }
          applyStatusSelectStyle(sel);
          updateSubmissionFilterCounts();
          applySubmissionFiltering();
          showToast(`Status naskah ${regNumber} berhasil diperbarui.`);
        } else {
          if (syncLabel) {
            syncLabel.textContent = 'Gagal menyimpan';
            syncLabel.className = 'text-[10px] text-rose-600 font-semibold mt-1 status-sync-indicator';
          }
          showToast(data.error || 'Gagal memperbarui status naskah.', true);
        }
      } catch (err: any) {
        if (syncLabel) {
          syncLabel.textContent = 'Gangguan koneksi';
          syncLabel.className = 'text-[10px] text-rose-600 font-semibold mt-1 status-sync-indicator';
        }
        showToast('Gangguan koneksi saat memperbarui status: ' + err.message, true);
      }
    });
  });

  // Filter Status Naskah Masuk
  document.querySelectorAll<HTMLButtonElement>('.filter-submission-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter') || 'all';
      currentSubmissionFilter = filter;
      document.querySelectorAll('.filter-submission-btn').forEach((b) => {
        b.classList.remove('bg-academic-navy', 'text-white');
        b.classList.add('bg-slate-100', 'text-slate-700');
      });
      btn.classList.remove('bg-slate-100', 'text-slate-700');
      btn.classList.add('bg-academic-navy', 'text-white');

      applySubmissionFiltering();
    });
  });

  // Live Search Naskah Masuk
  const searchSubInput = document.getElementById('search-submission-input') as HTMLInputElement | null;
  searchSubInput?.addEventListener('input', () => {
    applySubmissionFiltering();
  });

  // Hapus Naskah Masuk (Modal Kustom & Hapus Baris)
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-submission').forEach((btn) => {
    btn.addEventListener('click', () => {
      sessionStorage.setItem('jteba_active_tab', 'tab-submissions-list');
      const reg = btn.getAttribute('data-reg');
      const title = btn.getAttribute('data-title') || reg;
      if (!reg) return;

      const row = btn.closest('tr');

      openConfirmModal({
        title: 'Hapus Naskah Masuk',
        message: 'Data registrasi naskah ini akan dihapus secara permanen dari database Cloudflare D1. Tindakan ini tidak dapat dibatalkan.',
        item: `No. Registrasi: ${reg} ("${title}")`,
        onConfirm: async () => {
          try {
            const res = await fetch('/api/submissions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', regNumber: reg }),
            });
            const json = await res.json();
            if (json.success) {
              if (row) {
                row.style.transition = 'all 0.3s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => {
                  row.remove();
                  updateSubmissionFilterCounts();
                  applySubmissionFiltering();
                }, 300);
              }
              showToast(`Naskah registrasi "${reg}" berhasil dihapus dari database.`);
            } else {
              showToast('Gagal menghapus naskah: ' + json.error, true);
            }
          } catch (err: any) {
            showToast('Gagal menghapus naskah: ' + err.message, true);
          }
        },
      });
    });
  });

  // Pembaruan data editor-in-chief
  const formEic = document.getElementById('form-eic');
  formEic?.addEventListener('submit', async (e) => {
