---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { getDbSettings, getDbArticles, getDbEditorial, getDbIndexing, getDbIssues, getDbSubmissions } from '../../../lib/db';
import { verifySession } from '../../../lib/auth';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const kv = (Astro.locals as any)?.runtime?.env?.KV;
const session = await verifySession(Astro.request, kv);
const isAuthenticated = !!session;

const journalConfig = await getDbSettings(d1);
// Hanya ambil data administrasi jika sesi terotentikasi di level server
const articles = isAuthenticated ? await getDbArticles(d1) : [];
const editorial = isAuthenticated ? await getDbEditorial(d1) : { editorInChief: { name: '', affiliation: '', email: '' }, editors: [], reviewers: [] };
const indexing = isAuthenticated ? await getDbIndexing(d1) : [];
const issues = isAuthenticated ? await getDbIssues(d1) : [];
const submissions = isAuthenticated ? await getDbSubmissions(d1) : [];

const { editorInChief, editors, reviewers } = editorial;

const totalArticlesCount = articles.length;
const nextArticleOrder = totalArticlesCount + 1;
const defaultDoiPrefix = journalConfig.doiPrefix && journalConfig.doiPrefix.startsWith('10.') && !journalConfig.doiPrefix.includes('zenodo')
  ? journalConfig.doiPrefix
  : '10.00000';

function formatSubmissionDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr || '-';
    return d.toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }) + ' WIB';
  } catch (_) {
    return dateStr || '-';
  }
}

function formatFileSize(bytes: number): string {
  if (!bytes || bytes <= 0) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
}
---

<Layout title="Panel Redaksi & Admin Jurnal" description={`Halaman pengelolaan dan publikasi naskah ${journalConfig.name}`}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header Admin -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-academic-border pb-5 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="academic-badge bg-academic-navy text-white">Editorial Studio (GUI)</span>
          <span class="text-xs text-academic-ink-subtle">Sistem Pengelolaan Publikasi Mandiri Terintegrasi Database</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-1">
          Panel Administrasi & Redaksi JTEBA
        </h1>
        <p class="text-xs text-academic-ink-muted mt-1">
          Semua pengaturan, penambahan artikel, kontak narahubung, dan dewan redaksi dapat dikelola langsung lewat antarmuka grafis (GUI) di bawah ini.
        </p>
      </div>

      <!-- Status Database & Tombol Logout -->
      <div class="flex flex-wrap items-center gap-2.5 self-start sm:self-center">
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-300 text-xs font-semibold transition-colors"
          title="Buka Panel Admin Portal Open Gate"
        >
          <svg class="w-3.5 h-3.5 text-amber-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
          <span>Admin Portal Open Gate</span>
        </a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Database Terhubung (D1 / SQLite)</span>
        </span>
        <button
          type="button"
          id="btn-admin-logout"
          class={isAuthenticated ? "px-3.5 py-1.5 bg-rose-700 hover:bg-rose-800 text-white text-xs font-semibold rounded transition-colors shadow-2xs flex items-center gap-1.5" : "hidden"}
          title="Keluar dari Panel Admin"
        >
          <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
          <span>Keluar</span>
        </button>
      </div>
    </div>

    <!-- Floating Toast Notification (Fluid Popup) -->
    <div id="admin-toast-container" class="fixed top-6 right-6 z-50 pointer-events-none max-w-sm sm:max-w-md w-full px-4 sm:px-0">
      <div
        id="admin-toast"
        class="pointer-events-auto transform transition-all duration-300 ease-out -translate-y-4 opacity-0 hidden bg-white rounded-lg border shadow-xl p-3.5 text-xs sm:text-sm font-medium flex items-start justify-between gap-3"
      >
        <div class="flex items-start gap-2.5 min-w-0">
          <span id="admin-toast-icon" class="shrink-0 mt-0.5 flex items-center"></span>
          <span id="admin-toast-msg" class="leading-snug break-words"></span>
        </div>
        <button
          type="button"
          id="btn-close-toast"
          aria-label="Tutup notifikasi"
          class="text-slate-400 hover:text-slate-600 shrink-0 p-1 rounded hover:bg-slate-100 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    {!isAuthenticated ? (
      <!-- Area Login Sederhana (Gerbang Admin) -->
      <div id="admin-login-lock" class="academic-card p-8 rounded border border-academic-border max-w-md mx-auto my-12 text-center shadow-sm">
        <div class="w-12 h-12 rounded-full bg-academic-navy/10 text-academic-navy flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-academic-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <h2 class="text-lg font-serif font-bold text-academic-navy">
          Akses Khusus Dewan Redaksi
        </h2>
        <p class="text-xs sm:text-sm text-academic-ink-muted mt-1 mb-6">
          Masukkan kata sandi atau PIN untuk masuk ke panel administrasi redaksi.
        </p>

        <form id="admin-login-form" class="space-y-4 text-left">
          <div>
            <label for="admin-username" class="block text-sm font-semibold text-slate-800 mb-1">
              Nama Pengguna (Username)
            </label>
            <input
              type="text"
              id="admin-username"
              required
              autocomplete="username"
              placeholder="Masukkan username (cth: admin)"
              class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
            />
          </div>
          <div>
            <label for="admin-pin" class="block text-sm font-semibold text-slate-800 mb-1">
              Kata Sandi / PIN Redaksi
            </label>
            <input
              type="password"
              id="admin-pin"
              required
              autocomplete="current-password"
              placeholder="Masukkan kata sandi / PIN"
              class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
            />
          </div>
          <p id="login-error" class="text-xs text-rose-600 hidden">
            Nama pengguna atau kata sandi salah. Silakan coba lagi.
          </p>
          <button
            type="submit"
            id="login-submit-btn"
            class="w-full py-2.5 px-4 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded transition-colors shadow min-h-[44px]"
          >
            Masuk ke Panel Redaksi
          </button>
        </form>
      </div>
    ) : (
      <!-- Konten Dashboard Admin (Hanya Dirender di Server Jika Terotentikasi) -->
      <div id="admin-dashboard-content" class="space-y-8">
      <!-- Navigasi Tab Admin -->
      <div class="flex border-b border-academic-border text-xs sm:text-sm font-medium space-x-1 sm:space-x-3 overflow-x-auto pb-1 scroll-smooth [-webkit-overflow-scrolling:touch] whitespace-nowrap" role="tablist">
        <button
          type="button"
          class="admin-tab active py-2.5 px-3.5 border-b-2 border-academic-navy text-academic-navy font-bold shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-add-article"
        >
          <svg class="w-3.5 h-3.5 text-academic-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <span>Terbitkan Naskah</span>
        </button>
                <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-submissions-list"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>Naskah Masuk ({submissions.length})</span>
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-articles-list"
        >
          Naskah Terbit ({articles.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-editorial-settings"
        >
          Tim Redaksi ({editors.length + reviewers.length + 1})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-profile-settings"
        >
          Profil Jurnal
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-volume-settings"
        >
          Edisi & Terbitan ({issues.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-announcement-settings"
        >
          Pengumuman
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-journal-settings"
        >
          Kontak & Narahubung
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-indexing-settings"
        >
          Pengaturan Indexing ({indexing.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-gdrive-config"
        >
          Google Drive Index
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-security-settings"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          <span>Keamanan & PIN</span>
        </button>
      </div>

      <!-- TAB 1: FORM INPUT ARTIKEL BARU -->
      <div id="tab-add-article" class="tab-panel space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-sm">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Formulir Penerbitan Artikel Ilmiah
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Saat disimpan, naskah langsung masuk ke database dan tayang seketika pada halaman publik.
            </p>
          </div>

          <form id="form-new-article" class="space-y-5">
            <!-- Judul & Rumpun -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-8">
                <label for="art-title" class="block text-sm font-semibold text-slate-800 mb-1">
                  Judul Lengkap Artikel <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-title"
                  required
                  placeholder="Contoh: Analisis Kepatuhan Pajak atas Pemanfaatan Fasilitas Super Tax Deduction..."
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                />
              </div>

              <div class="md:col-span-4">
                <label for="art-subject" class="block text-sm font-semibold text-slate-800 mb-1">
                  Rumpun Keilmuan <span class="text-rose-600">*</span>
                </label>
                <select
                  id="art-subject"
                  required
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none bg-white min-h-[44px]"
                >
                  <option value="Akuntansi Keberlanjutan dan Pelaporan ESG (Sustainability Accounting and ESG)">Akuntansi Keberlanjutan dan Pelaporan ESG (Sustainability Accounting and ESG)</option>
                  <option value="Perpajakan dan Kebijakan Fiskal (Taxation and Fiscal Policy)">Perpajakan dan Kebijakan Fiskal (Taxation and Fiscal Policy)</option>
                  <option value="Auditing, Forensik, dan Tata Kelola (Auditing, Forensics, and Governance)">Auditing, Forensik, dan Tata Kelola (Auditing, Forensics, and Governance)</option>
                  <option value="Dinamika Ekonomi dan Bisnis Terapan (Applied Economics and Business Dynamics)">Dinamika Ekonomi dan Bisnis Terapan (Applied Economics and Business Dynamics)</option>
                </select>
              </div>
            </div>

            <!-- GENERATOR URL / SLUG ARTIKEL -->
            <div class="bg-blue-50/70 border border-blue-200 rounded-lg p-4 space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <label for="art-slug" class="block text-xs font-bold text-academic-navy uppercase tracking-wider flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                    </svg>
                    <span>Generator URL & Slug Artikel</span>
                    <span class="text-rose-600">*</span>
                  </label>
                  <span class="text-xs text-slate-600">
                    Dihasilkan otomatis dari judul artikel untuk permalink publikasi yang SEO-friendly.
                  </span>
                </div>
                <button
                  type="button"
                  id="btn-generate-slug"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold rounded shadow-2xs transition-colors self-start sm:self-auto shrink-0 min-h-[38px]"
