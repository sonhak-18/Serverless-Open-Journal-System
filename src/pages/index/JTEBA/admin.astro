              </span>
            </div>

            <div class="p-3.5 bg-slate-50 border border-slate-200 rounded text-xs space-y-1.5">
              <span class="font-bold text-slate-700 block">Simulasi Format Tautan PDF Tombol Unduh / Baca:</span>
              <p id="preview-pdf-link" class="font-mono text-academic-navy break-all bg-white p-2 border border-slate-200 rounded text-xs">
                {journalConfig.storage.gdriveIndexBaseUrl}/{journalConfig.storage.pdfDirectoryPath ? `${journalConfig.storage.pdfDirectoryPath}/` : ''}JTEBA_V1N1_01_artikel-penelitian.pdf
              </p>
            </div>

            <div class="flex justify-end pt-2">
              <button
                type="submit"
