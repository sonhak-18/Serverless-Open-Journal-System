  // Validasi Real-time ISSN ISO 3297 Modulo 11
  function checkIssnInput(inputEl: HTMLInputElement | null, statusEl: HTMLElement | null, type: 'e-ISSN' | 'p-ISSN') {
    if (!inputEl || !statusEl) return;
    const val = inputEl.value.trim().toUpperCase().replace(/[^0-9X-]/g, '');
    if (!val) {
      statusEl.textContent = 'Kosong';
      statusEl.className = 'text-xs text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded font-mono';
      return;
    }

    const clean = val.replace(/-/g, '');
    if (clean.length === 8) {
      let sum = 0;
      for (let i = 0; i < 7; i++) sum += (8 - i) * parseInt(clean[i], 10);
      const rem = sum % 11;
      const expected = rem === 0 ? '0' : (11 - rem === 10 ? 'X' : String(11 - rem));
      const actual = clean[7];
      if (expected === actual) {
        statusEl.textContent = `✓ ${type} Valid (ISO 3297)`;
        statusEl.className = 'text-xs text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded font-mono border border-emerald-200';
      } else {
        statusEl.textContent = `⚠ Check Digit Salah! Seharusnya ${expected}`;
        statusEl.className = 'text-xs text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded font-mono border border-rose-200 font-bold';
      }
    } else {
      statusEl.textContent = `${clean.length}/8 digit`;
      statusEl.className = 'text-xs text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded font-mono border border-amber-200';
    }
  }

