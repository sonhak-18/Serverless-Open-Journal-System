---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import SidebarOJS from '../../../components/SidebarOJS.astro';
import { getDbSettings, getDbEditorial } from '../../../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const { editorInChief, editors, reviewers } = await getDbEditorial(d1);
---

<Layout title="Editorial Team & Reviewers" description={`Dewan Redaksi dan Mitra Bestari ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Dewan Redaksi (~68%) -->
      <main class="lg:col-span-8 space-y-8">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/index/JTEBA" class="hover:underline">Home</a> &gt; <span>Editorial Team</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-academic-navy">
            Editorial Team
          </h1>
        </div>

        {journalConfig.features?.showEditorialTeam === false ? (
          <div class="p-8 border border-dashed border-slate-300 bg-slate-50 rounded text-center space-y-3">
            <h2 class="text-xl font-bold text-slate-800">
              Informasi Tim Redaksi Sedang Dalam Penataan
            </h2>
            <p class="text-sm text-slate-600 max-w-md mx-auto">
              Susunan dewan redaksi dan mitra bestari saat ini sedang dalam proses konsolidasi berkala oleh sekretariat jurnal. Penulis dan akademisi dapat menghubungi narahubung redaksi melalui kanal resmi.
            </p>
            <div class="pt-2">
              <a href="/index/JTEBA" class="inline-flex items-center gap-1.5 px-4 py-2 bg-[#0f2c59] text-white text-xs font-semibold rounded hover:bg-[#183e6d]">
                Kembali ke Beranda
              </a>
            </div>
          </div>
        ) : (
        <>
        <!-- Editor in Chief -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-academic-navy border-b-2 border-slate-200 pb-2">
            Editor-in-Chief
          </h2>
          {editorInChief && editorInChief.name ? (
            <div class="p-6 bg-white border border-slate-200 rounded shadow-2xs space-y-1.5">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900">
                {editorInChief.name}
              </h3>
              <p class="text-base text-slate-700">
                {editorInChief.affiliation}
              </p>
              {editorInChief.email && (
                <p class="text-sm text-slate-600 font-mono pt-1">
                  Email: <!--email_off--><a href={`mailto:${editorInChief.email}`} class="text-academic-teal hover:underline font-semibold">{editorInChief.email}</a><!--/email_off-->
                </p>
              )}
            </div>
          ) : (
            <div class="p-6 bg-slate-50 border border-dashed border-slate-300 rounded text-sm text-slate-500 italic">
              Data Editor-in-Chief belum diatur. Dewan redaksi dapat dikonfigurasi melalui panel admin.
            </div>
          )}
        </div>

        <!-- Managing & Associate Editors -->
        <div class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-academic-navy border-b-2 border-slate-200 pb-2">
            Managing & Section Editors
          </h2>
          {editors.length > 0 ? (
            <div class="space-y-3.5">
              {editors.map((editor) => (
                <div class="p-5 bg-white border border-slate-200 rounded shadow-2xs space-y-1">
                  <h3 class="text-base sm:text-lg font-bold text-slate-900">
                    {editor.name}
                  </h3>
                  <p class="text-sm sm:text-base text-academic-teal font-semibold">
                    {editor.role}
                  </p>
                  <p class="text-base text-slate-700">
                    {editor.affiliation}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-6 bg-slate-50 border border-dashed border-slate-300 rounded text-sm text-slate-500 italic">
              Belum ada managing atau section editor yang didaftarkan.
            </div>
          )}
        </div>

        <!-- Peer Reviewers / Mitra Bestari -->
        <div id="reviewers" class="space-y-4">
          <h2 class="text-xl sm:text-2xl font-serif font-bold text-academic-navy border-b-2 border-slate-200 pb-2">
            Peer Reviewers (Mitra Bestari)
          </h2>
          {reviewers.length > 0 ? (
            <div class="space-y-3.5">
              {reviewers.map((reviewer) => (
                <div class="p-5 bg-slate-50 border border-slate-200 rounded space-y-1">
                  <h3 class="text-base sm:text-lg font-bold text-slate-900">
                    {reviewer.name}
                  </h3>
                  <p class="text-base text-slate-700">
                    {reviewer.affiliation}
                  </p>
                </div>
              ))}
            </div>
          ) : (
            <div class="p-6 bg-slate-50 border border-dashed border-slate-300 rounded text-sm text-slate-500 italic">
              Belum ada mitra bestari (peer reviewers) yang didaftarkan.
            </div>
          )}
        </div>
        </>
        )}
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
