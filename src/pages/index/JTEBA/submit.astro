---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import SidebarOJS from '../../../components/SidebarOJS.astro';
import { getWhatsAppSubmissionUrl, getEmailSubmissionUrl } from '../../../config/journal';
import { getDbSettings } from '../../../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const templateUrl = journalConfig.branding?.templateUrl || '/template-jteba.docx';
const isExternalTemplate = templateUrl.startsWith('http://') || templateUrl.startsWith('https://');

const waUrl = getWhatsAppSubmissionUrl(
  undefined,
  journalConfig.submission?.whatsappNumber || journalConfig.submission?.whatsappDisplay,
  journalConfig.submission?.whatsappDefaultMessage
);
const emailUrl = getEmailSubmissionUrl(undefined, journalConfig.submission?.email);
---

<Layout title="Online Submission" description={`Petunjuk penyerahan naskah artikel ilmiah ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Penyerahan Naskah (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/index/JTEBA" class="hover:underline">Home</a> &gt; <span>Submissions</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-academic-navy">
            Submissions (Penyerahan Naskah)
          </h1>
        </div>

        <p class="text-base sm:text-lg text-slate-800 leading-relaxed">
          {journalConfig.name} ({journalConfig.shortName}) menerima naskah hasil penelitian empiris dan telaah literatur kritis di bidang akuntansi keberlanjutan & ESG, perpajakan & kebijakan fiskal, auditing & tata kelola, serta dinamika ekonomi dan bisnis terapan. Untuk mempercepat dan mempermudah proses korespondensi, calon penulis dapat menyerahkan manuskrip langsung ke narahubung redaksi melalui dua jalur resmi di bawah ini.
        </p>

        <!-- Pilihan Jalur Penyerahan Naskah -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- WhatsApp Redaksi -->
          <div class="p-6 border border-slate-300 bg-white rounded shadow-2xs space-y-4">
            <h2 class="text-lg sm:text-xl font-bold text-academic-navy flex items-center gap-2">
              <svg class="w-5 h-5 text-emerald-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
              </svg>
              <span>1. Pengajuan via WhatsApp Redaksi</span>
            </h2>
            <p class="text-base text-slate-700 leading-relaxed">
              Kirimkan berkas naskah (.docx) ke nomor WhatsApp resmi sekretariat redaksi untuk konfirmasi penerimaan dan pengecekan kelengkapan awal.
            </p>
            <div class="text-sm text-slate-800 bg-slate-50 p-3 rounded border border-slate-200">
              <span class="block text-slate-500 text-xs font-semibold mb-0.5">Narahubung Redaksi:</span>
              <span class="font-bold font-mono text-base text-academic-navy">{journalConfig.submission.whatsappDisplay}</span>
            </div>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-center py-3 px-4 bg-emerald-700 hover:bg-emerald-800 text-white text-base font-bold rounded shadow-xs transition-colors"
            >
              Hubungi WhatsApp Redaksi
            </a>
          </div>

          <!-- Email Sekretariat -->
          <div class="p-6 border border-slate-300 bg-white rounded shadow-2xs space-y-4">
            <h2 class="text-lg sm:text-xl font-bold text-academic-navy flex items-center gap-2">
              <svg class="w-5 h-5 text-academic-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <span>2. Pengajuan via Surat Elektronik (Email)</span>
            </h2>
            <p class="text-base text-slate-700 leading-relaxed">
              Kirimkan berkas naskah lengkap beserta identitas seluruh penulis dan surat pengantar ke alamat email resmi redaksi.
            </p>
            <div class="text-sm text-slate-800 bg-slate-50 p-3 rounded border border-slate-200">
              <span class="block text-slate-500 text-xs font-semibold mb-0.5">Alamat Email Resmi:</span>
              <span class="font-bold font-mono text-base text-academic-navy">{journalConfig.submission.email}</span>
            </div>
            <a
              href={emailUrl}
              class="block text-center py-3 px-4 bg-academic-navy hover:bg-academic-navy-light text-white text-base font-bold rounded shadow-xs transition-colors"
            >
              Kirim via Email Redaksi
            </a>
          </div>
        </div>

        <!-- Submission Preparation Checklist -->
        <div class="p-6 border border-slate-200 bg-slate-50 rounded space-y-4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 border-b-2 border-slate-200 pb-2">
            Submission Preparation Checklist
          </h2>
          <p class="text-base sm:text-lg text-slate-800">
            Sebelum mengirimkan naskah, pastikan poin-poin berikut telah terpenuhi oleh penulis:
          </p>
          <ul class="text-base sm:text-lg text-slate-800 space-y-3 leading-relaxed">
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Naskah belum pernah dipublikasikan sebelumnya dan tidak sedang dalam pertimbangan di jurnal ilmiah lain.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>
                Format berkas manuskrip wajib menggunakan format resmi Microsoft Word (.docx).
                <a
                  href="/api/template"
                  download={`Template_Naskah_${journalConfig.shortName}.docx`}
                  class="text-blue-700 hover:underline font-semibold inline-flex items-center gap-1 ml-1"
                >
                  (Unduh Template .docx)
                </a>
              </span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Teks mematuhi pedoman format penulisan dan sitasi APA 7th Edition yang tercantum dalam Author Guidelines.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-emerald-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>Hasil pemeriksaan orisinalitas Turnitin tidak melebihi ambang batas toleransi {journalConfig.submission.turnitinMaxSimilarity}%.</span>
            </li>
          </ul>

          <div class="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <span class="text-sm text-slate-600">Gunakan format resmi sebelum melakukan pengajuan manuskrip:</span>
            <a
              href="/api/template"
              download={`Template_Naskah_${journalConfig.shortName}.docx`}
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0f284e] hover:bg-[#183e6d] text-white text-sm font-bold rounded shadow-2xs transition-colors"
            >
              <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>Unduh Berkas Template (.docx)</span>
            </a>
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
