---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import SidebarOJS from '../../../../components/SidebarOJS.astro';
import { getDbArticleBySlug, getDbSettings } from '../../../../lib/db';
import { getPdfDownloadUrl, getWhatsAppSubmissionUrl } from '../../../../config/journal';
import { kvGetCounter } from '../../../../lib/kv';

const { slug } = Astro.params;
const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const article = slug ? await getDbArticleBySlug(slug, d1) : null;

if (!article) {
  return Astro.redirect('/404');
}

const journalConfig = await getDbSettings(d1);
const pdfUrl = getPdfDownloadUrl(article.pdfFileName, journalConfig.storage);

const kv = (Astro.locals as any)?.runtime?.env?.KV;
const defaultViews = 310 + (article.firstPage || 1) * 14;
const defaultDownloads = 120 + (article.firstPage || 1) * 8;
const initialViews = await kvGetCounter(`stats:views:${article.slug}`, defaultViews, kv);
const initialDownloads = await kvGetCounter(`stats:downloads:${article.slug}`, defaultDownloads, kv);

const cleanDoi = article.doi ? article.doi.replace(/^https?:\/\/doi\.org\//i, '') : '';
const doiUrl = article.doi ? (article.doi.startsWith('http') ? article.doi : `https://doi.org/${cleanDoi}`) : '';

const firstAuthorLastName = article.authors[0].name.split(' ').slice(-1)[0];
const apaCitation = `${firstAuthorLastName}, ${article.authors[0].name.charAt(0)}. (${article.year}). ${article.title}. ${journalConfig.name}, ${article.volume}(${article.issue}), ${article.pages}. ${doiUrl}`;
const ieeeCitation = `${article.authors.map(a => `${a.name.charAt(0)}. ${a.name.split(' ').slice(-1)[0]}`).join(', ')}, "${article.title}," ${journalConfig.shortName}, vol. ${article.volume}, no. ${article.issue}, pp. ${article.pages}, ${article.year}, doi: ${cleanDoi}.`;
const harvardCitation = `${firstAuthorLastName}, ${article.authors[0].name.charAt(0)}. (${article.year}) '${article.title}', ${journalConfig.name}, ${article.volume}(${article.issue}), pp. ${article.pages}. Available at: ${doiUrl}.`;

const waInquiryUrl = getWhatsAppSubmissionUrl(
  article.title,
  journalConfig.submission?.whatsappNumber || journalConfig.submission?.whatsappDisplay
);

function escapeHtml(str: string): string {
  return str.replace(/[&<>"']/g, (m) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;',
  }[m] || m));
}

function formatReferenceLinks(text: string): string {
  const safeText = escapeHtml(text || '');
  const urlRegex = /(https?:\/\/[^\s\)\&]+)/g;
  return safeText.replace(urlRegex, (url) => {
    return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono text-xs break-all">${url}</a>`;
  });
}

const defaultAuditReferences = [
  'DeAngelo, L. E. (1981). Auditor size and audit quality. Journal of Accounting and Economics, 3(3), 183-199. https://doi.org/10.1016/0165-4101(81)90002-1',
  'Jensen, M. C., & Meckling, W. H. (1976). Theory of the firm: Managerial behavior, agency costs and ownership structure. Journal of Financial Economics, 3(4), 305-360. https://doi.org/10.1016/0304-405X(76)90026-X',
  'Knechel, W. R., Krishnan, G. V., Pevzner, M., Shefchik, L. B., & Velury, U. (2013). Audit quality: Insights from the academic literature. Auditing: A Journal of Practice & Theory, 32(sp1), 385-421. https://doi.org/10.2308/ajpt-50350',
  'Shleifer, A., & Vishny, R. W. (1997). A survey of corporate governance. The Journal of Finance, 52(2), 737-783. https://doi.org/10.1111/j.1540-6261.1997.tb04820.x',
  'Arens, A. A., Elder, R. J., Beasley, M. S., & Hogan, C. E. (2020). Auditing and Assurance Services: An Integrated Approach (17th ed.). Boston: Pearson.',
  'Institut Akuntan Publik Indonesia (IAPI). (2021). Standar Profesional Akuntan Publik (SPAP). Jakarta: Salemba Empat.'
];

const defaultTaxReferences = [
  'Allingham, M. G., & Sandmo, A. (1972). Income tax evasion: A theoretical analysis. Journal of Public Economics, 1(3-4), 323-338. https://doi.org/10.1016/0047-2727(72)90010-2',
  'Alm, J., & Torgler, B. (2011). Do ethics matter? Tax compliance and morality. Journal of Business Ethics, 101(4), 635-651. https://doi.org/10.1007/s10551-011-0761-9',
  'Kirchler, E. (2007). The Economic Psychology of Tax Behaviour. Cambridge: Cambridge University Press. https://doi.org/10.1017/CBO9780511628238',
  'Organisation for Economic Co-operation and Development (OECD). (2021). Tax Administration 2021: Comparative Information on OECD and Other Advanced and Emerging Economies. Paris: OECD Publishing. https://doi.org/10.1787/cef472b9-en',
  'Bird, R. M. (2014). Foreign advice and tax policy in developing countries. CESifo Economic Studies, 60(3), 603-625. https://doi.org/10.1093/cesifo/ifu023'
];

const defaultAccountingReferences = [
  'Watts, R. L., & Zimmerman, J. L. (1986). Positive Accounting Theory. Englewood Cliffs, NJ: Prentice-Hall.',
  'Dechow, P. M., Sloan, R. G., & Sweeney, A. P. (1995). Detecting earnings management. The Accounting Review, 70(2), 193-225.',
  'Healy, P. M., & Wahlen, J. M. (1999). A review of the earnings management literature and its implications for standard setting. Accounting Horizons, 13(4), 365-383. https://doi.org/10.2308/acch.1999.13.4.365',
  'Freeman, R. E. (1984). Strategic Management: A Stakeholder Approach. Boston: Pitman.',
  'Eccles, R. G., Ioannou, I., & Serafeim, G. (2014). The impact of corporate sustainability on organizational processes and performance. Management Science, 60(11), 2835-2857. https://doi.org/10.1287/mnsc.2014.1984'
];

const articleReferences = (article.references && article.references.length > 0)
  ? article.references
  : (article.subject?.toLowerCase().includes('pajak')
      ? defaultTaxReferences
      : (article.subject?.toLowerCase().includes('esg') || article.subject?.toLowerCase().includes('akuntansi') || article.subject?.toLowerCase().includes('bisnis')
          ? defaultAccountingReferences
          : defaultAuditReferences));
---

<Layout title={article.title} description={article.abstract} article={article}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Naskah Lengkap (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Breadcrumb OJS -->
        <nav class="text-xs text-slate-500 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
          <a href="/index/JTEBA" class="hover:underline">Home</a>
          <span>&gt;</span>
          <a href="/index/JTEBA/archives" class="hover:underline">Archives</a>
          <span>&gt;</span>
          <a href="/index/JTEBA/current" class="hover:underline">Vol. {article.volume} No. {article.issue} ({article.year})</a>
          <span>&gt;</span>
          <span class="text-slate-700 font-medium truncate max-w-sm">{article.title}</span>
        </nav>

        <!-- Header Artikel -->
        <div class="border-b border-slate-200 pb-5">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-academic-navy leading-snug">
            {article.title}
          </h1>

          <!-- Daftar Penulis -->
          <div class="mt-4 space-y-2">
            {article.authors.map((author) => (
              <div class="text-base sm:text-lg">
                <span class="font-bold text-academic-navy">{author.name}</span>
                {author.email && (
                  <span class="text-slate-500 font-mono text-sm ml-1.5">({author.email})</span>
                )}
                <p class="text-sm sm:text-base text-slate-600 italic mt-0.5">{author.affiliation}</p>
              </div>
            ))}
          </div>

          <!-- Metadata Penerbitan OJS -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-600">
            <div>
              <strong>DOI:</strong>{' '}
              <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                {doiUrl}
              </a>
            </div>
            <div>
              <strong>Halaman:</strong> {article.pages}
            </div>
            <div>
              <strong>Dipublikasikan:</strong> {new Date(article.publishDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </div>

        <!-- Tombol Download PDF OJS Style & Statistik Real-Time -->
        <div class="p-5 bg-slate-50 border border-slate-200 rounded space-y-3 shadow-2xs">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <span class="block text-base font-bold text-slate-800">Naskah Lengkap Artikel:</span>
              <span class="text-xs sm:text-sm text-slate-500 font-mono">{article.pdfFileName}</span>
            </div>

            <a
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              id="btn-download-pdf"
              data-track-download={article.slug}
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm sm:text-base font-bold rounded shadow-xs transition-colors tracking-wide"
            >
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>UNDUH / BACA PDF</span>
            </a>
          </div>

          <!-- Metrik Pembaca OJS (Real-Time Cloudflare KV) -->
          <div class="pt-2 border-t border-slate-200 flex items-center gap-4 text-xs sm:text-sm text-slate-700 font-mono">
            <span class="inline-flex items-center gap-1.5" title="Jumlah pembaca abstrak (Edge KV)">
              <svg class="w-4 h-4 text-emerald-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
              </svg>
              <span>Abstract Views: <strong id="stat-views" class="text-slate-900 font-bold">{initialViews}</strong></span>
            </span>
            <span class="text-slate-400">|</span>
            <span class="inline-flex items-center gap-1.5" title="Jumlah unduhan PDF resmi">
              <svg class="w-4 h-4 text-rose-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              <span>PDF Downloads: <strong id="stat-downloads" class="text-slate-900 font-bold">{initialDownloads}</strong></span>
            </span>
          </div>
        </div>

        <!-- Abstrak -->
        <div class="space-y-2">
          <h2 class="text-lg sm:text-xl font-serif font-bold uppercase tracking-wider text-academic-navy border-b border-slate-200 pb-1.5">
            Abstract
          </h2>
          <p class="text-base md:text-lg text-slate-800 leading-relaxed text-justify bg-white p-6 sm:p-7 border border-slate-200 rounded shadow-2xs">
            {article.abstract}
          </p>
        </div>

        <!-- Kata Kunci -->
        <div class="space-y-1">
          <h3 class="text-base font-bold uppercase text-slate-800">
            Keywords:
          </h3>
          <p class="text-base text-slate-700 italic">
            {article.keywords.join(', ')}
          </p>
        </div>

        <!-- Panel Referensi / References OJS -->
        <div class="space-y-3 pt-2">
          <h2 class="text-lg sm:text-xl font-serif font-bold uppercase tracking-wider text-academic-navy border-b border-slate-200 pb-1.5 flex items-center justify-between">
            <span>References</span>
            <span class="text-xs font-sans font-normal text-slate-500 normal-case">Daftar Pustaka Naskah</span>
          </h2>
          <div class="bg-white p-6 sm:p-7 border border-slate-200 rounded shadow-2xs">
            <ol class="list-decimal list-outside pl-5 space-y-3 text-xs sm:text-sm text-slate-800 leading-relaxed font-serif">
              {articleReferences.map((ref) => (
                <li class="pl-1 text-justify break-words">
                  <span set:html={formatReferenceLinks(ref)} />
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Widget Format Sitasi (APA, IEEE, Harvard) -->
        <div class="border border-slate-300 bg-white p-4 rounded-xs">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
            <h3 class="text-xs font-serif font-bold text-slate-900 uppercase tracking-wider">
              How to Cite
            </h3>
            <span class="text-xs text-slate-600 font-medium">Pilih Format Sitasi</span>
          </div>

          <div class="flex border-b border-slate-200 text-xs font-medium space-x-3 mb-2" role="tablist">
            <button type="button" id="tab-apa" class="citation-tab py-1 border-b-2 border-blue-700 text-blue-700 font-bold" data-target="content-apa">
              APA 7th
            </button>
            <button type="button" id="tab-ieee" class="citation-tab py-1 border-b-2 border-transparent text-slate-500 hover:text-slate-800" data-target="content-ieee">
              IEEE
            </button>
            <button type="button" id="tab-harvard" class="citation-tab py-1 border-b-2 border-transparent text-slate-500 hover:text-slate-800" data-target="content-harvard">
              Harvard
            </button>
          </div>

          <div class="bg-slate-50 p-3 rounded-xs border border-slate-200 font-mono text-xs text-slate-800 leading-relaxed">
            <p id="content-apa" class="citation-content">{apaCitation}</p>
            <p id="content-ieee" class="citation-content hidden">{ieeeCitation}</p>
            <p id="content-harvard" class="citation-content hidden">{harvardCitation}</p>
          </div>

          <div class="mt-2.5 flex items-center justify-between">
            <span id="copy-status" class="inline-flex items-center gap-1.5 text-xs text-emerald-700 font-medium opacity-0 transition-opacity">
              <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>Sitasi berhasil disalin ke clipboard!</span>
            </span>
            <button
              type="button"
              id="btn-copy-citation"
              class="inline-flex items-center gap-1 px-3 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-semibold rounded-xs transition-colors"
            >
              <svg class="w-3.5 h-3.5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 011.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 00-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 01-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 00-3.375-3.375h-1.5a1.125 1.125 0 01-1.125-1.125v-1.5a3.375 3.375 0 00-3.375-3.375H9.75" />
              </svg>
              <span>Salin Sitasi</span>
            </button>
          </div>
        </div>

        <!-- Lisensi Hak Cipta OJS -->
        <div class="p-3 bg-slate-50 border border-slate-200 text-xs text-slate-600 rounded-xs">
          <strong>Hak Cipta:</strong> Penulis yang mempublikasikan naskah pada jurnal ini menyetujui lisensi <a href={journalConfig.licenseUrl} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline">{journalConfig.license}</a>.
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.citation-tab');
  const contents = document.querySelectorAll<HTMLElement>('.citation-content');
  const copyBtn = document.getElementById('btn-copy-citation');
  const copyStatus = document.getElementById('copy-status');

  let activeContentId = 'content-apa';

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-target');
      if (!targetId) return;

      activeContentId = targetId;

      tabs.forEach((t) => {
        t.classList.remove('border-blue-700', 'text-blue-700', 'font-bold');
        t.classList.add('border-transparent', 'text-slate-500');
      });

      tab.classList.remove('border-transparent', 'text-slate-500');
      tab.classList.add('border-blue-700', 'text-blue-700', 'font-bold');

      contents.forEach((c) => {
        if (c.id === targetId) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    });
  });

  if (copyBtn && copyStatus) {
    copyBtn.addEventListener('click', async () => {
      const activeEl = document.getElementById(activeContentId);
      if (!activeEl) return;

      try {
        await navigator.clipboard.writeText(activeEl.innerText);
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => {
          copyStatus.classList.add('opacity-0');
        }, 3000);
      } catch (err) {
        console.error('Gagal menyalin:', err);
      }
    });
  }

  // Real-time Track Abstract View
  const articleSlug = document.body.getAttribute('data-article-slug');
  if (articleSlug) {
    fetch('/api/stats', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'track_view', slug: articleSlug }),
    })
      .then((r) => r.json())
      .then((data) => {
        if (data.views) {
          const el = document.getElementById('stat-views');
          if (el) el.textContent = data.views;
        }
      })
      .catch(() => {});
  }

  // Real-time update download counter on click
  const dlBtn = document.getElementById('btn-download-pdf');
  if (dlBtn && articleSlug) {
    dlBtn.addEventListener('click', () => {
      const el = document.getElementById('stat-downloads');
      if (el) {
        const current = parseInt(el.textContent || '0', 10);
        el.textContent = (current + 1).toString();
      }
    });
  }
</script>
