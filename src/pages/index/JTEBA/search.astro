---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import SidebarOJS from '../../../components/SidebarOJS.astro';
import ArticleItemOJS from '../../../components/ArticleItemOJS.astro';
import { getDbSettings, getDbArticles } from '../../../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const allArticles = await getDbArticles(d1);

// URL Search Params
const url = Astro.url;
const query = (url.searchParams.get('query') || '').trim();
const authors = (url.searchParams.get('authors') || '').trim();

const yearFrom = url.searchParams.get('yearFrom') || '';
const monthFrom = url.searchParams.get('monthFrom') || '';
const dayFrom = url.searchParams.get('dayFrom') || '';

const yearTo = url.searchParams.get('yearTo') || '';
const monthTo = url.searchParams.get('monthTo') || '';
const dayTo = url.searchParams.get('dayTo') || '';

const hasSearched = url.searchParams.has('query') || 
                    url.searchParams.has('authors') || 
                    url.searchParams.has('yearFrom') || 
                    url.searchParams.has('yearTo') ||
                    url.searchParams.has('monthFrom') ||
                    url.searchParams.has('monthTo');

// Filter Articles
let results = allArticles;

if (hasSearched) {
  if (query) {
    const qLower = query.toLowerCase();
    results = results.filter((art) => {
      const titleMatch = art.title.toLowerCase().includes(qLower);
      const abstractMatch = art.abstract?.toLowerCase().includes(qLower);
      const keywordMatch = art.keywords?.some((k) => k.toLowerCase().includes(qLower));
      const authorMatch = art.authors?.some((a) => a.name.toLowerCase().includes(qLower));
      return titleMatch || abstractMatch || keywordMatch || authorMatch;
    });
  }

  if (authors) {
    const aLower = authors.toLowerCase();
    results = results.filter((art) => {
      return art.authors?.some((a) => 
        a.name.toLowerCase().includes(aLower) || 
        a.affiliation?.toLowerCase().includes(aLower)
      );
    });
  }

  if (yearFrom) {
    const m = monthFrom ? monthFrom.padStart(2, '0') : '01';
    const d = dayFrom ? dayFrom.padStart(2, '0') : '01';
    const fromDateStr = `${yearFrom}-${m}-${d}`;
    results = results.filter((art) => (art.publishDate || '') >= fromDateStr);
  }

  if (yearTo) {
    const m = monthTo ? monthTo.padStart(2, '0') : '12';
    const d = dayTo ? dayTo.padStart(2, '0') : '31';
    const toDateStr = `${yearTo}-${m}-${d}`;
    results = results.filter((art) => (art.publishDate || '') <= toDateStr);
  }
} else {
  // Bila belum melakukan pencarian, tampilkan state default (0 hasil) sesuai spesifikasi OJS 3
  results = [];
}

// Generate dropdown items
const currentYear = new Date().getFullYear();
const yearOptions = [];
for (let y = currentYear; y >= 2020; y--) {
  yearOptions.push(y);
}

const months = [
  { val: '01', label: 'Januari' },
  { val: '02', label: 'Februari' },
  { val: '03', label: 'Maret' },
  { val: '04', label: 'April' },
  { val: '05', label: 'Mei' },
  { val: '06', label: 'Juni' },
  { val: '07', label: 'Juli' },
  { val: '08', label: 'Agustus' },
  { val: '09', label: 'September' },
  { val: '10', label: 'Oktober' },
  { val: '11', label: 'November' },
  { val: '12', label: 'Desember' }
];

const days = Array.from({ length: 31 }, (_, i) => String(i + 1).padStart(2, '0'));
---

<Layout 
  title="Cari" 
  exactTitle={false} 
  description={`Pencarian artikel ilmiah ${journalConfig.name} (${journalConfig.shortName})`}
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Utama: Halaman Pencarian (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Breadcrumb Sesuai Tampilan OJS 3 -->
        <nav class="text-xs uppercase tracking-wider text-slate-500 font-semibold" aria-label="Breadcrumb">
          <a href="/index/JTEBA" class="text-[#16707a] hover:underline font-bold">BERANDA</a>
          <span class="mx-1 text-slate-400">/</span>
          <span class="text-slate-600">Cari</span>
        </nav>

        <!-- Heading Halaman -->
        <div>
          <h1 class="text-3xl sm:text-4xl font-serif font-bold text-academic-navy">
            Cari
          </h1>
        </div>

        <!-- Form Pencarian OJS 3 -->
        <form method="GET" action="/index/JTEBA/search" class="space-y-6">
          <!-- Input Utama Pencarian -->
          <div>
            <label for="search-query" class="sr-only">Kata Kunci Pencarian</label>
            <input
              type="text"
              id="search-query"
              name="query"
              value={query}
              placeholder="Cari"
              class="w-full px-3.5 py-2.5 text-sm sm:text-base border border-slate-300 rounded shadow-2xs text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-[#16707a] focus:ring-1 focus:ring-[#16707a] bg-white transition-colors"
            />
          </div>

          <!-- Fieldset Filter Lanjutan -->
          <fieldset class="border border-slate-300 rounded-md p-5 sm:p-6 bg-white relative">
            <legend class="text-xs font-bold uppercase tracking-wider text-slate-900 px-2 font-sans">
              FILTER LANJUTAN
            </legend>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start pt-1">
              <!-- Kolom Kiri: Tanggal Terbit -->
              <div class="space-y-4">
                <!-- Diterbitkan Setelah -->
                <div>
                  <label class="block text-xs font-semibold text-slate-800 mb-1.5">
                    Diterbitkan Setelah
                  </label>
                  <div class="grid grid-cols-3 gap-2">
                    <select
                      name="yearFrom"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Tahun Mulai"
                    >
                      <option value="">Tahun</option>
                      {yearOptions.map((y) => (
                        <option value={y} selected={yearFrom === String(y)}>{y}</option>
                      ))}
                    </select>

                    <select
                      name="monthFrom"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Bulan Mulai"
                    >
                      <option value="">Bulan</option>
                      {months.map((m) => (
                        <option value={m.val} selected={monthFrom === m.val}>{m.label}</option>
                      ))}
                    </select>

                    <select
                      name="dayFrom"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Tanggal Mulai"
                    >
                      <option value="">Tgl</option>
                      {days.map((d) => (
                        <option value={d} selected={dayFrom === d}>{d}</option>
                      ))}
                    </select>
                  </div>
                </div>

                <!-- Diterbitkan Sebelum -->
                <div>
                  <label class="block text-xs font-semibold text-slate-800 mb-1.5">
                    Diterbitkan Sebelum
                  </label>
                  <div class="grid grid-cols-3 gap-2">
                    <select
                      name="yearTo"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Tahun Selesai"
                    >
                      <option value="">Tahun</option>
                      {yearOptions.map((y) => (
                        <option value={y} selected={yearTo === String(y)}>{y}</option>
                      ))}
                    </select>

                    <select
                      name="monthTo"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Bulan Selesai"
                    >
                      <option value="">Bulan</option>
                      {months.map((m) => (
                        <option value={m.val} selected={monthTo === m.val}>{m.label}</option>
                      ))}
                    </select>

                    <select
                      name="dayTo"
                      class="px-2 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a]"
                      aria-label="Tanggal Selesai"
                    >
                      <option value="">Tgl</option>
                      {days.map((d) => (
                        <option value={d} selected={dayTo === d}>{d}</option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>

              <!-- Kolom Kanan: Penulis -->
              <div>
                <label for="search-authors" class="block text-xs font-semibold text-slate-800 mb-1.5">
                  Penulis
                </label>
                <input
                  type="text"
                  id="search-authors"
                  name="authors"
                  value={authors}
                  placeholder="Nama penulis atau afiliasi"
                  class="w-full px-3 py-1.5 text-xs sm:text-sm border border-slate-300 rounded bg-white text-slate-800 focus:outline-none focus:border-[#16707a] focus:ring-1 focus:ring-[#16707a]"
                />
              </div>
            </div>
          </fieldset>

          <!-- Tombol Aksi Cari Sesuai OJS 3 -->
          <div class="flex items-center justify-between pt-1">
            {hasSearched && (
              <a 
                href="/index/JTEBA/search" 
                class="text-xs text-slate-500 hover:text-slate-800 underline"
              >
                Reset Filter
              </a>
            )}
            <div class="ml-auto">
              <button
                type="submit"
                class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#204969] hover:bg-[#16354d] text-white text-sm font-semibold rounded shadow-xs transition-colors"
              >
                <svg class="w-4 h-4 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <span>Cari</span>
              </button>
            </div>
          </div>
        </form>

        <!-- Hasil Pencarian -->
        <div class="pt-6">
          {results.length > 0 ? (
            <div class="space-y-4">
              <div class="text-xs text-slate-600 font-mono pb-2 border-b border-slate-200 flex justify-between items-center">
                <span>Ditemukan <strong>{results.length}</strong> naskah artikel</span>
                {query && <span class="italic text-slate-500">Kata kunci: "{query}"</span>}
              </div>
              <div class="divide-y divide-slate-100">
                {results.map((article) => (
                  <ArticleItemOJS article={article} storage={journalConfig.storage} />
                ))}
              </div>
            </div>
          ) : (
            <!-- Kotak Panggilan 'Tidak ada hasil' Khas OJS 3 -->
            <div class="p-4 border-l-4 border-[#16707a] bg-slate-50 text-slate-700 text-sm font-sans rounded-r">
              Tidak ada hasil
            </div>
          )}
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
