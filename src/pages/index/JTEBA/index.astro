---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import SidebarOJS from '../../../components/SidebarOJS.astro';
import ArticleItemOJS from '../../../components/ArticleItemOJS.astro';
import { getDbSettings, getDbArticles } from '../../../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const allArticles = await getDbArticles(d1);

const curVolume = journalConfig.currentIssue?.volume ?? 1;
const curIssue = journalConfig.currentIssue?.issue ?? 1;
const curYear = journalConfig.currentIssue?.year ?? 2026;
const curPeriod = journalConfig.currentIssue?.period || 'Maret 2026';
const curTheme = journalConfig.currentIssue?.theme || 'Edisi Perdana: Inovasi Audit, Akuntansi Keberlanjutan & Modernisasi Sistem Perpajakan';
const curCoverUrl = journalConfig.currentIssue?.coverUrl || '';

const cleanPeriod = curPeriod.replace(new RegExp(`\\s*\\(?${curYear}\\)?`, 'g'), '').trim();
const displayPeriodWithYear = cleanPeriod ? `${cleanPeriod} ${curYear}` : String(curYear);

const currentArticles = allArticles.filter(a => a.volume === curVolume && a.issue === curIssue);
const displayArticles = currentArticles.length > 0 ? currentArticles : allArticles;

const rawPrefix = (journalConfig.doiPrefix || '10.00000').trim().replace(/^https?:\/\/doi\.org\//i, '').replace(/\/$/, '');
const cleanPrefix = (rawPrefix.includes('zenodo') || !rawPrefix.startsWith('10.')) ? '10.00000' : rawPrefix;
const issueDoiUrl = cleanPrefix.includes(`/${journalConfig.shortName.toLowerCase()}`) 
  ? `https://doi.org/${cleanPrefix}.v${curVolume}i${curIssue}`
  : `https://doi.org/${cleanPrefix}/${journalConfig.shortName.toLowerCase()}.v${curVolume}i${curIssue}`;
---

<Layout title="Beranda JTEBA" exactTitle={false} description={`Beranda resmi ${journalConfig.name} (${journalConfig.shortName}). Jurnal ilmiah akses terbuka telaah sejawat bidang Akuntansi Keberlanjutan & ESG, Perpajakan, Auditing, dan Dinamika Bisnis.`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Konten Utama Jurnal (~68%) -->
      <main class="lg:col-span-8 space-y-6">

        <!-- Pengumuman Redaksi dari Database -->
        {journalConfig.announcement?.active && (
          <div class="p-5 sm:p-6 bg-amber-50/70 border border-amber-200/80 rounded space-y-2 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-900 bg-amber-100 px-2.5 py-0.5 rounded">
                Pengumuman Redaksi
              </span>
              <span class="text-xs text-slate-500 font-mono">
                {journalConfig.announcement.date}
              </span>
            </div>
            <h2 class="text-lg sm:text-xl font-serif font-bold text-academic-navy pt-0.5">
              {journalConfig.announcement.title}
            </h2>
            <p class="text-base sm:text-lg text-slate-800 leading-relaxed pt-1">
              {journalConfig.announcement.content}
            </p>
          </div>
        )}

        <!-- Bagian Terbitan Terkini (Current Issue Preview) / Call for Papers Mode -->
        {journalConfig.features?.hasActiveIssue ? (
          <div class="space-y-4">
            <div class="border-b-2 border-academic-gold pb-2 flex justify-between items-baseline">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
                  Terbitan Terkini (Current Issue)
                </span>
                <h2 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-0.5">
                  Vol. {curVolume} No. {curIssue} ({curYear}): {curPeriod}
                </h2>
              </div>
              <a href="/index/JTEBA/current" class="text-xs text-blue-700 hover:underline font-semibold hidden sm:inline-block">
                Halaman Terbitan Terkini →
              </a>
            </div>
            {curTheme && (
              <p class="text-base text-slate-700 italic mt-1">
                Tema: {curTheme}
              </p>
            )}

            <!-- Cover Jurnal & Metadata Terbitan -->
            <div class="p-6 border border-slate-200 bg-white rounded flex flex-col sm:flex-row gap-6 items-start shadow-2xs">
              {curCoverUrl ? (
                <img
                  src={curCoverUrl}
                  alt={`Cover ${journalConfig.shortName} Vol. ${curVolume} No. ${curIssue}`}
                  class="w-36 sm:w-40 shrink-0 border border-slate-300 shadow-xs aspect-[3/4] object-cover rounded"
                />
              ) : (
                <!-- Cover Mockup Jurnal (Academic Navy & Gold) -->
                <div class="w-36 sm:w-40 shrink-0 border border-slate-300 shadow-xs bg-[#0f284e] text-white p-4 flex flex-col justify-between aspect-[3/4] text-center rounded">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-widest block text-[#c89b3c]">{journalConfig.shortName}</span>
                    <span class="text-xs font-bold mt-2.5 block leading-tight">
                      {journalConfig.name.toUpperCase()}
                    </span>
                  </div>
                  <div class="text-xs text-slate-300 border-t border-[#c89b3c]/40 pt-1 font-mono">
                    Vol. {curVolume} No. {curIssue} ({curYear})
                  </div>
                </div>
              )}

              <!-- Deskripsi & Info Resmi Terbitan -->
              <div class="text-base text-slate-800 space-y-3 leading-relaxed">
                <p>
                  <strong>{journalConfig.name} ({journalConfig.shortName})</strong> adalah jurnal ilmiah telaah sejawat (<em>peer-reviewed</em>) yang mempublikasikan hasil riset empiris dan telaah literatur kritis di bidang akuntansi keberlanjutan & ESG, perpajakan & kebijakan fiskal, auditing & tata kelola, serta dinamika ekonomi dan bisnis terapan.
                </p>
                <p class="text-slate-700">
                  {curTheme}
                </p>
                <div class="pt-3 text-sm text-slate-600 border-t border-slate-100 space-y-1.5">
                  <div>
                    <strong>DOI Edisi:</strong>{' '}
                    <a href={issueDoiUrl} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                      {issueDoiUrl}
                    </a>
                  </div>
                  <div>
                    <strong>Periode Publikasi:</strong> {curPeriod} ({curYear})
                  </div>
                </div>
              </div>
            </div>

            <!-- Daftar Artikel Terbitan -->
            <div class="mt-8 space-y-3">
              <div class="border-b-2 border-academic-gold pb-1.5 flex justify-between items-baseline">
                <h2 class="text-lg font-serif font-bold text-academic-navy">
                  Articles
                </h2>
                <span class="text-xs sm:text-sm text-slate-500 font-medium">
                  {displayArticles.length} Naskah Terbit
                </span>
              </div>

              {displayArticles.length > 0 ? (
                <div class="divide-y divide-slate-200">
                  {displayArticles.map((article) => (
                    <ArticleItemOJS article={article} storage={journalConfig.storage} />
                  ))}
                </div>
              ) : (
                <div class="py-10 px-6 text-center border border-dashed border-slate-300 rounded bg-slate-50 text-slate-600 font-sans text-sm space-y-2">
                  <p class="font-medium text-academic-navy">Belum ada naskah terbit pada edisi ini.</p>
                  <p class="text-xs text-slate-500">Naskah yang telah disetujui akan tampil di bagian ini.</p>
                </div>
              )}
            </div>
          </div>
        ) : (
          <div class="space-y-6">
            <div class="border-b-2 border-academic-gold pb-2 flex justify-between items-baseline flex-wrap gap-2">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded border border-emerald-200">
                  Call for Papers & Naskah Ilmiah
                </span>
                <h2 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-1.5">
                  Menuju Edisi Perdana (Inaugural Issue)
                </h2>
              </div>
              <span class="text-xs font-mono text-slate-500 font-semibold bg-slate-50 px-2.5 py-1 rounded border border-slate-200">
                Target Terbit: {displayPeriodWithYear}
              </span>
            </div>

            <!-- Kartu Undangan Naskah Terhubung Admin -->
            <div class="p-6 border border-slate-200 bg-white rounded flex flex-col sm:flex-row gap-6 items-start shadow-2xs">
              <!-- Cover Gambar Edisi (Dinamis dari Input Admin) / Mockup Elegan -->
              {curCoverUrl ? (
                <img
                  src={curCoverUrl}
                  alt={`Cover Edisi Perdana ${journalConfig.shortName} Vol. ${curVolume} No. ${curIssue}`}
                  class="w-36 sm:w-44 shrink-0 border border-slate-300 shadow-xs aspect-[3/4] object-cover rounded"
                />
              ) : (
                <div class="w-36 sm:w-44 shrink-0 border border-slate-300 shadow-xs bg-[#0f284e] text-white p-4 flex flex-col justify-between aspect-[3/4] text-center rounded">
                  <div>
                    <span class="text-xs font-bold uppercase tracking-widest block text-[#c89b3c]">{journalConfig.shortName}</span>
                    <span class="text-xs font-bold mt-2 block leading-snug">
                      {journalConfig.name.toUpperCase()}
                    </span>
                  </div>
                  <div class="py-3 border-y border-[#c89b3c]/30 my-2">
                    <span class="text-xs font-bold text-amber-300 block uppercase tracking-wider">Call for Papers</span>
                    <span class="text-xs text-slate-200 block mt-0.5">Vol. {curVolume} No. {curIssue}</span>
                  </div>
                  <div class="text-xs text-slate-200 font-mono">
                    {displayPeriodWithYear}
                  </div>
                </div>
              )}

              <!-- Deskripsi & Rincian dari Pengaturan Admin -->
              <div class="text-sm text-slate-800 space-y-3 leading-relaxed flex-1">
                <p>
                  <strong>{journalConfig.name} ({journalConfig.shortName})</strong> saat ini membuka penerimaan naskah ilmiah (<em>Call for Papers</em>) untuk diterbitkan pada <strong>Edisi Perdana (Vol. {curVolume} No. {curIssue})</strong> periode <strong>{displayPeriodWithYear}</strong>.
                </p>

                <!-- Tema Edisi (Dinamis dari Input Admin: cfg-issue-theme) -->
                {curTheme && (
                  <div class="p-3.5 bg-amber-50/80 border border-amber-200 rounded text-sm text-amber-950 font-medium space-y-1">
                    <span class="font-bold text-amber-900 block text-xs uppercase tracking-wider">
                      Tema Khusus Edisi Perdana:
                    </span>
                    <p class="leading-relaxed italic">
                      "{curTheme}"
                    </p>
                  </div>
                )}

                <!-- Teks Pengumuman / Ruang Lingkup (Dinamis jika diisi di Tab Pengumuman Admin) -->
                {journalConfig.announcement?.active && journalConfig.announcement.content ? (
                  <div class="p-3.5 bg-slate-50 border border-slate-200 rounded text-xs text-slate-700 leading-relaxed">
                    <strong class="text-academic-navy block mb-1">{journalConfig.announcement.title || 'Informasi Redaksi & Submisi'}:</strong>
                    <p>{journalConfig.announcement.content}</p>
                  </div>
                ) : (
                  <p class="text-slate-600 text-xs sm:text-sm">
                    Kami mengundang para peneliti, akademisi, dosen, dan praktisi untuk mengirimkan hasil riset empiris bermutu tinggi yang orisinal dan belum pernah dipublikasikan di media lain.
                  </p>
                )}

                <!-- Ketentuan Penulisan Dinamis dari Admin -->
                <div class="bg-slate-50 p-3.5 rounded border border-slate-200 text-xs space-y-1.5">
                  <div class="font-semibold text-academic-navy">Fokus & Ketentuan Penulisan:</div>
                  <ul class="list-disc list-inside text-slate-600 space-y-0.5">
                    <li>Akuntansi Berkelanjutan & ESG, Kebijakan Perpajakan, Auditing & Tata Kelola, serta Dinamika Bisnis.</li>
                    <li>Tingkat kemiripan (similarity) maksimal <strong>{journalConfig.submission?.turnitinMaxSimilarity || 20}%</strong> melalui Turnitin.</li>
                    <li>Estimasi waktu review redaksi: <strong>{journalConfig.submission?.reviewTimeEstimate || '3 sampai 7 Hari Kerja'}</strong>.</li>
                    <li>Naskah wajib disusun sesuai pedoman dan template resmi jurnal (.docx).</li>
                  </ul>
                </div>

                <div class="pt-2 flex flex-wrap items-center gap-3">
                  <a
                    href="/index/JTEBA/submit"
                    class="px-4 py-2 bg-academic-navy hover:bg-academic-navy-light text-white text-xs font-bold rounded shadow-xs transition-colors flex items-center gap-1.5"
                  >
                    <span>Kirim Naskah (Submit Paper)</span>
                    <svg class="w-3.5 h-3.5 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                  <a
                    href={journalConfig.branding?.templateUrl || '/template-jteba.docx'}
                    download
                    class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded border border-slate-300 transition-colors flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                    </svg>
                    <span>Unduh Template Naskah</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Bagian Naskah Terbit Mode Call for Papers -->
            <div class="mt-8 space-y-3">
              <div class="border-b-2 border-academic-gold pb-1.5 flex justify-between items-baseline">
                <h2 class="text-lg font-serif font-bold text-academic-navy">
                  Articles
                </h2>
                <span class="text-xs text-slate-500 font-medium">
                  Menuju Edisi Perdana
                </span>
              </div>
              <div class="py-10 px-6 text-center border border-dashed border-slate-300 rounded bg-slate-50 text-slate-600 font-sans text-xs space-y-2">
                <p class="font-bold text-academic-navy text-sm">Penerimaan Naskah Sedang Berlangsung</p>
                <p class="text-slate-500 max-w-lg mx-auto">
                  Naskah yang telah lolos tahap <em>Double-Blind Peer Review</em> akan segera dipublikasikan pada Edisi Perdana (Vol. {curVolume} No. {curIssue}). Silakan submit naskah Anda melalui menu Pengajuan Naskah.
                </p>
              </div>
            </div>
          </div>
        )}
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi Jurnal (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
