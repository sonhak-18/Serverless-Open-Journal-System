---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getDbPortalSettings, getDbPortalAdminCredentials } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const kv = (Astro.locals as any)?.runtime?.env?.KV;
const portal = await getDbPortalSettings(d1);
const creds = await getDbPortalAdminCredentials(kv);

// Cek autentikasi sesi via cookie praniti_portal_session
const cookieHeader = Astro.request.headers.get('cookie') || '';
const isAuthenticated = cookieHeader.includes('praniti_portal_session=');
---

<Layout
  title="Panel Admin Portal Open Gate - Praniti"
  exactTitle={true}
  showHeader={false}
  showFooter={false}
  faviconUrl={portal.faviconUrl}
>
  <div class="min-h-screen bg-slate-900 text-slate-100 font-sans">
    {!isAuthenticated ? (
      <!-- LOGIN FORM UNTUK OPEN GATE -->
      <div class="min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
          <div class="text-center space-y-3">
            <div class="inline-flex p-3 bg-white/5 rounded-2xl border border-white/10 mb-2">
              <img
                src={portal.logoUrl || '/images/logo-praniti.png'}
                alt="Logo Praniti"
                class="h-12 w-auto object-contain"
              />
            </div>
            <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
              Admin Portal Open Gate
            </h1>
            <p class="text-xs text-slate-400">
              Masuk dengan akun terotorisasi untuk mengelola aset, identitas organisasi, dan kartu jurnal
            </p>
          </div>

          <form id="portal-login-form" class="space-y-4">
            <div id="login-error-box" class="hidden p-3 bg-red-950/80 border border-red-800 rounded-lg text-xs text-red-200"></div>

            <div>
              <label for="login-username" class="block text-xs font-semibold text-slate-300 mb-1">
                Nama Pengguna (Username)
              </label>
              <input
                type="text"
                id="login-username"
                required
                autocomplete="username"
                placeholder="admin"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#c89b3c]"
              />
            </div>

            <div>
              <label for="login-pin" class="block text-xs font-semibold text-slate-300 mb-1">
                Kata Sandi / Password Keamanan
              </label>
              <input
                type="password"
                id="login-pin"
                required
                autocomplete="current-password"
                placeholder="••••••••"
                class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white placeholder-slate-500 focus:outline-none focus:border-[#c89b3c]"
              />
            </div>

            <button
              type="submit"
              id="login-submit-btn"
              class="w-full py-2.5 px-4 bg-[#c89b3c] hover:bg-[#b0842b] text-slate-950 font-bold text-sm rounded-lg shadow-md transition-colors flex items-center justify-center gap-2"
            >
              <span>Masuk ke Panel Portal</span>
              <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </button>
          </form>

          <div class="text-center pt-2 border-t border-slate-700/60 flex items-center justify-between text-xs text-slate-400">
            <a href="/" class="hover:text-white transition-colors">
              ← Ke Beranda Portal
            </a>
            <span class="text-slate-600">•</span>
            <a href="/index/JTEBA" class="hover:text-amber-300 transition-colors">
              Portal JTEBA →
            </a>
          </div>
        </div>
      </div>
    ) : (
      <!-- AUTHENTICATED ADMIN DASHBOARD -->
      <div class="pb-28">
        <!-- TOP NAVIGATION BAR -->
        <header class="bg-slate-800/95 backdrop-blur-md border-b border-slate-700/80 sticky top-0 z-40 px-4 py-3 shadow-md">
          <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-3">
            <div class="flex items-center gap-3">
              <a href="/" class="flex items-center gap-2" title="Lihat Beranda Open Gate">
                <img
                  src={portal.logoUrl || '/images/logo-praniti.png'}
                  alt="Logo Praniti"
                  class="h-8 w-auto object-contain"
                />
              </a>
              <div class="border-l border-slate-700 pl-3">
                <h1 class="text-sm font-bold text-white flex items-center gap-2">
                  <span>Panel Admin Portal Open Gate</span>
                  <span class="px-2 py-0.5 bg-emerald-950 text-emerald-400 border border-emerald-800 rounded-full text-xs font-mono">D1 Connected</span>
                </h1>
                <p class="text-xs text-slate-400">Pengaturan Organisasi, Aset Visual & Kartu Jurnal</p>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-2 text-xs">
              <a
                href="/"
                target="_blank"
                class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 font-semibold rounded transition-colors flex items-center gap-1.5"
              >
                <span>Buka Portal</span>
                <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
              <a
                href="/index/JTEBA/admin"
                class="px-3 py-1.5 bg-[#0f2c59] hover:bg-[#183e6d] text-amber-300 font-semibold rounded transition-colors flex items-center gap-1.5 border border-amber-500/30"
              >
                <span>Kelola JTEBA</span>
                <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <button
                type="button"
                id="portal-logout-btn"
                class="px-3 py-1.5 bg-red-950/70 hover:bg-red-900 text-red-200 border border-red-800 rounded font-semibold transition-colors"
              >
                Keluar
              </button>
            </div>
          </div>
        </header>

        <!-- MAIN DASHBOARD CONTENT -->
        <main class="max-w-6xl mx-auto px-4 py-8 space-y-8">
          <form id="portal-settings-form" class="space-y-8">
            <!-- 1. IDENTITAS & PROFIL ORGANISASI -->
            <section class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="border-b border-slate-700 pb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#c89b3c]">Identitas Resmi</span>
                <h2 class="text-lg font-bold text-white mt-0.5">Profil & Nama Organisasi</h2>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Nama Organisasi (Bahasa Indonesia) *
                  </label>
                  <input
                    type="text"
                    name="orgName"
                    value={portal.orgName}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                  <p class="text-xs text-slate-400 mt-1">Muncul pada judul halaman, navbar, dan footer.</p>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Nama Organisasi (Bahasa Inggris / Internasional) *
                  </label>
                  <input
                    type="text"
                    name="orgNameEn"
                    value={portal.orgNameEn}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                  <p class="text-xs text-slate-400 mt-1">Muncul pada sub-judul banner dan sitasi metadata.</p>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Slogan / Tagline Resmi (Bahasa Indonesia) *
                  </label>
                  <input
                    type="text"
                    name="sloganId"
                    value={portal.sloganId}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Slogan / Tagline Resmi (Bahasa Inggris) *
                  </label>
                  <input
                    type="text"
                    name="sloganEn"
                    value={portal.sloganEn}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Domain Operasional Resmi *
                  </label>
                  <input
                    type="text"
                    name="domainDisplay"
                    value={portal.domainDisplay}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm font-mono text-emerald-400 focus:outline-none focus:border-[#c89b3c]"
                  />
                  <p class="text-xs text-slate-400 mt-1">Domain Cloudflare: misal ejournal.praniti.or.id</p>
                </div>

                <div class="md:col-span-2">
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Deskripsi Ringkas Organisasi & Landasan Filosofis *
                  </label>
                  <textarea
                    name="description"
                    rows="3"
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c] leading-relaxed"
                  >{portal.description}</textarea>
                </div>
              </div>
            </section>

            <!-- 2. ASET VISUAL & BRANDING (DENGAN DIRECT FILE UPLOAD) -->
            <section class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="border-b border-slate-700 pb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#c89b3c]">Branding Visual</span>
                <h2 class="text-lg font-bold text-white mt-0.5">Upload Logo & Favicon Organisasi</h2>
                <p class="text-xs text-slate-400 mt-0.5">
                  Anda dapat langsung mengunggah file gambar (PNG, JPG, SVG, WebP, ICO) dari komputer Anda. Berkas akan dikonversi dan disimpan secara permanen di database.
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- A. Upload Logo Praniti -->
                <div class="p-5 bg-slate-900/80 border border-slate-700 rounded-xl space-y-4">
                  <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold text-white">
                      Logo Resmi Praniti (Publisher)
                    </label>
                    <span class="text-xs text-slate-400 font-mono">Header & Footer</span>
                  </div>

                  <!-- Live Preview Box -->
                  <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center min-h-[110px] relative">
                    <img
                      id="preview-logo-img"
                      src={portal.logoUrl || '/images/logo-praniti.png'}
                      alt="Preview Logo Praniti"
                      class="max-h-16 w-auto object-contain"
                    />
                  </div>

                  <!-- File Upload Input -->
                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">
                      Unggah File Logo dari Komputer:
                    </label>
                    <input
                      type="file"
                      id="upload-logo-file"
                      accept="image/png,image/jpeg,image/webp,image/svg+xml"
                      class="block w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-[#c89b3c] file:text-slate-950 hover:file:bg-[#b0842b] cursor-pointer"
                    />
                  </div>

                  <!-- URL / Data Input Fallback -->
                  <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1">
                      Atau Masukkan Path / URL Gambar:
                    </label>
                    <input
                      type="text"
                      id="input-logo-url"
                      name="logoUrl"
                      value={portal.logoUrl}
                      required
                      class="w-full px-3 py-1.5 bg-slate-950 border border-slate-700 rounded text-xs font-mono text-slate-300 focus:outline-none focus:border-[#c89b3c]"
                    />
                  </div>
                </div>

                <!-- B. Upload Favicon Praniti -->
                <div class="p-5 bg-slate-900/80 border border-slate-700 rounded-xl space-y-4">
                  <div class="flex items-center justify-between">
                    <label class="block text-xs font-bold text-white">
                      Favicon Praniti (Publisher)
                    </label>
                    <span class="text-xs text-slate-400 font-mono">Tab Ikon Browser</span>
                  </div>

                  <!-- Live Preview Box -->
                  <div class="p-4 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center min-h-[110px]">
                    <img
                      id="preview-favicon-img"
                      src={portal.faviconUrl || '/favicon.png'}
                      alt="Preview Favicon Praniti"
                      class="w-12 h-12 object-contain rounded p-1 bg-white/10"
                    />
                  </div>

                  <!-- File Upload Input -->
                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">
                      Unggah File Favicon dari Komputer:
                    </label>
                    <input
                      type="file"
                      id="upload-favicon-file"
                      accept="image/png,image/x-icon,image/svg+xml,image/webp"
                      class="block w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-[#c89b3c] file:text-slate-950 hover:file:bg-[#b0842b] cursor-pointer"
                    />
                  </div>

                  <!-- URL / Data Input Fallback -->
                  <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1">
                      Atau Masukkan Path / URL Favicon:
                    </label>
                    <input
                      type="text"
                      id="input-favicon-url"
                      name="faviconUrl"
                      value={portal.faviconUrl}
                      required
                      class="w-full px-3 py-1.5 bg-slate-950 border border-slate-700 rounded text-xs font-mono text-slate-300 focus:outline-none focus:border-[#c89b3c]"
                    />
                  </div>
                </div>
              </div>
            </section>

            <!-- 3. NARAHUBUNG & SEKRETARIAT -->
            <section class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="border-b border-slate-700 pb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#c89b3c]">Komunikasi</span>
                <h2 class="text-lg font-bold text-white mt-0.5">Kontak Resmi & Alamat Organisasi</h2>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Email Resmi Sekretariat *
                  </label>
                  <input
                    type="email"
                    name="email"
                    value={portal.email}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm font-mono text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    WhatsApp Narahubung / Hotline *
                  </label>
                  <input
                    type="text"
                    name="whatsapp"
                    value={portal.whatsapp}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm font-mono text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Alamat / Wilayah Sekretariat *
                  </label>
                  <input
                    type="text"
                    name="address"
                    value={portal.address}
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>
              </div>
            </section>

            <!-- 4. DAFTAR JURNAL & 5 MISI (TERMASUK SETUP EMBLEM JTEBA) -->
            <section class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="border-b border-slate-700 pb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#c89b3c]">Daftar Jurnal & Misi</span>
                <h2 class="text-lg font-bold text-white mt-0.5">Kartu Jurnal Unggulan & 5 Misi Organisasi</h2>
                <p class="text-xs text-slate-400 mt-0.5">
                  Konfigurasikan emblem resmi jurnal, nama publikasi, dan butir misi organisasi.
                </p>
              </div>

              <div class="space-y-6">
                <!-- Setup Emblem / Logo Kartu Jurnal JTEBA -->
                <div class="p-5 bg-slate-900/80 border border-slate-700 rounded-xl space-y-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <strong class="text-sm font-bold text-white block">
                        Emblem / Ikon Logo Kartu JTEBA
                      </strong>
                      <span class="text-xs text-slate-400">
                        Muncul di kartu jurnal JTEBA pada halaman depan Open Gate
                      </span>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
                    <!-- Preview Box -->
                    <div class="md:col-span-3 p-3 bg-slate-950 border border-slate-800 rounded-xl flex items-center justify-center">
                      <img
                        id="preview-emblem-img"
                        src={portal.flagshipJournalEmblemUrl || '/favicon-jteba.png'}
                        alt="Emblem JTEBA"
                        class="w-16 h-16 rounded-xl border border-slate-700 object-contain p-1.5 bg-[#0f284e]"
                      />
                    </div>

                    <!-- Upload & Path Options -->
                    <div class="md:col-span-9 space-y-3">
                      <div>
                        <label class="block text-xs font-semibold text-slate-300 mb-1.5">
                          Unggah File Emblem JTEBA (PNG, SVG, JPG, WebP):
                        </label>
                        <input
                          type="file"
                          id="upload-emblem-file"
                          accept="image/png,image/jpeg,image/webp,image/svg+xml"
                          class="block w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-[#c89b3c] file:text-slate-950 hover:file:bg-[#b0842b] cursor-pointer"
                        />
                      </div>
                      <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">
                          Path / URL Emblem:
                        </label>
                        <input
                          type="text"
                          id="input-emblem-url"
                          name="flagshipJournalEmblemUrl"
                          value={portal.flagshipJournalEmblemUrl || '/favicon-jteba.png'}
                          required
                          class="w-full px-3 py-1.5 bg-slate-950 border border-slate-700 rounded text-xs font-mono text-slate-300 focus:outline-none focus:border-[#c89b3c]"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">
                      Nama Kartu Jurnal Unggulan
                    </label>
                    <input
                      type="text"
                      name="flagshipJournalName"
                      value={portal.flagshipJournalName}
                      required
                      class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                    />
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">
                      Nama Internasional (EN)
                    </label>
                    <input
                      type="text"
                      name="flagshipJournalEn"
                      value={portal.flagshipJournalEn}
                      required
                      class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                    />
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">
                      Rute Tautan Jurnal
                    </label>
                    <input
                      type="text"
                      name="flagshipJournalUrl"
                      value={portal.flagshipJournalUrl}
                      required
                      class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm font-mono text-emerald-400 focus:outline-none focus:border-[#c89b3c]"
                    />
                  </div>

                  <div class="flex items-center gap-3 pt-6">
                    <label class="relative inline-flex items-center cursor-pointer">
                      <input
                        type="checkbox"
                        name="callForPapersActive"
                        class="sr-only peer"
                        checked={portal.callForPapersActive}
                      />
                      <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
                      <span class="ml-3 text-xs font-semibold text-slate-300">
                        Badge Status "Call for Papers" Aktif
                      </span>
                    </label>
                  </div>
                </div>

                <!-- 5 Misi Organisasi Textarea -->
                <div class="pt-4 border-t border-slate-700">
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    5 Butir Misi Utama Organisasi (1 butir per baris)
                  </label>
                  <textarea
                    id="portal-missions-input"
                    rows="6"
                    required
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white font-mono leading-relaxed focus:outline-none focus:border-[#c89b3c]"
                  >{portal.missions.join('\n')}</textarea>
                  <p class="text-xs text-slate-400 mt-1">
                    Format: <code class="text-amber-300">Judul Misi: Uraian misi</code> per baris.
                  </p>
                </div>
              </div>
            </section>

            <!-- 5. KEAMANAN AKUN ADMIN PORTAL -->
            <section class="bg-slate-800 border border-slate-700 rounded-2xl p-6 sm:p-8 space-y-6 shadow-sm">
              <div class="border-b border-slate-700 pb-4">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-rose-400">Security Credentials</span>
                <h2 class="text-lg font-bold text-white mt-0.5">Keamanan Akun Admin Portal</h2>
                <p class="text-xs text-slate-400 mt-0.5">
                  Ubah nama pengguna atau kata sandi admin portal Open Gate.
                </p>
              </div>

              <div id="cred-status-box" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Password / PIN Saat Ini *
                  </label>
                  <input
                    type="password"
                    id="cred-current-pin"
                    placeholder="••••••••"
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Nama Pengguna Baru
                  </label>
                  <input
                    type="text"
                    id="cred-new-username"
                    placeholder={creds.username}
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>

                <div>
                  <label class="block text-xs font-semibold text-slate-300 mb-1">
                    Password / PIN Baru (min. 6 kar.)
                  </label>
                  <input
                    type="password"
                    id="cred-new-pin"
                    placeholder="Minimal 6 karakter"
                    class="w-full px-3.5 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-white focus:outline-none focus:border-[#c89b3c]"
                  />
                </div>
              </div>

              <div>
                <button
                  type="button"
                  id="btn-update-credentials"
                  class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white font-semibold text-xs rounded-lg transition-colors"
                >
                  Perbarui Kata Sandi Admin
                </button>
              </div>
            </section>

            <!-- FLOATING ACTION SAVE BAR -->
            <div class="sticky bottom-4 z-40 bg-slate-900/95 backdrop-blur-md border border-slate-700 rounded-xl p-4 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-3">
              <div id="save-status-msg" class="text-xs text-slate-300 font-medium">
                Perubahan dan berkas gambar tersimpan langsung ke Cloudflare D1 database.
              </div>
              <div class="flex items-center gap-3 w-full sm:w-auto">
                <button
                  type="submit"
                  id="save-submit-btn"
                  class="w-full sm:w-auto px-6 py-2.5 bg-[#c89b3c] hover:bg-[#b0842b] text-slate-950 font-bold text-sm rounded-lg shadow-md transition-all flex items-center justify-center gap-2"
                >
                  <svg class="w-4 h-4 text-slate-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span>Simpan Perubahan Portal</span>
                </button>
              </div>
            </div>
          </form>
        </main>
      </div>
    )}
  </div>

  <script is:inline>
    // Helper function untuk membaca dan mengoptimalkan gambar ke Base64 Data URL
    function handleImageFileUpload(fileInputId, targetUrlInputId, previewImgId, maxDim = 800) {
      const fileInput = document.getElementById(fileInputId);
      const urlInput = document.getElementById(targetUrlInputId);
      const previewImg = document.getElementById(previewImgId);

      if (!fileInput || !urlInput || !previewImg) return;

      fileInput.addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;

        // Jika SVG, baca langsung sebagai Data URL
        if (file.type === 'image/svg+xml') {
          const reader = new FileReader();
          reader.onload = (event) => {
            const dataUrl = event.target.result;
            urlInput.value = dataUrl;
            previewImg.src = dataUrl;
          };
          reader.readAsDataURL(file);
          return;
        }

        // Untuk PNG, JPG, WebP: optimalkan ukuran via Canvas
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            let width = img.width;
            let height = img.height;

            if (width > maxDim || height > maxDim) {
              if (width > height) {
                height = Math.round((height * maxDim) / width);
                width = maxDim;
              } else {
                width = Math.round((width * maxDim) / height);
                height = maxDim;
              }
            }

            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);

            const format = file.type === 'image/jpeg' ? 'image/jpeg' : 'image/png';
            const compressedDataUrl = canvas.toDataURL(format, 0.92);

            urlInput.value = compressedDataUrl;
            previewImg.src = compressedDataUrl;
          };
          img.src = event.target.result;
        };
        reader.readAsDataURL(file);
      });

      // Update preview jika input teks URL diubah manual
      urlInput.addEventListener('input', () => {
        previewImg.src = urlInput.value || '';
      });
    }

    // Inisialisasi Upload Berkas untuk 3 Aset
    handleImageFileUpload('upload-logo-file', 'input-logo-url', 'preview-logo-img', 800);
    handleImageFileUpload('upload-favicon-file', 'input-favicon-url', 'preview-favicon-img', 256);
    handleImageFileUpload('upload-emblem-file', 'input-emblem-url', 'preview-emblem-img', 256);

    // 1. Client-Side Login Handling via /api/portal-auth
    const loginForm = document.getElementById('portal-login-form');
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('login-username').value;
        const pin = document.getElementById('login-pin').value;
        const errBox = document.getElementById('login-error-box');
        const submitBtn = document.getElementById('login-submit-btn');

        submitBtn.disabled = true;
        submitBtn.innerText = 'Memverifikasi...';
        errBox.classList.add('hidden');

        try {
          const res = await fetch('/api/portal-auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'verify', username, pin }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.reload();
          } else {
            errBox.innerText = data.error || 'Autentikasi gagal. Silakan periksa kembali.';
            errBox.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Masuk ke Panel Portal';
          }
        } catch (err) {
          errBox.innerText = 'Terjadi kesalahan jaringan: ' + err.message;
          errBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerText = 'Masuk ke Panel Portal';
        }
      });
    }

    // 2. Client-Side Logout
    const logoutBtn = document.getElementById('portal-logout-btn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async () => {
        if (confirm('Apakah Anda yakin ingin keluar dari panel admin portal?')) {
          await fetch('/api/portal-auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'logout' }),
          });
          window.location.reload();
        }
      });
    }

    // 3. Update Admin Credentials
    const updateCredBtn = document.getElementById('btn-update-credentials');
    if (updateCredBtn) {
      updateCredBtn.addEventListener('click', async () => {
        const currentPin = document.getElementById('cred-current-pin').value;
        const newUsername = document.getElementById('cred-new-username').value;
        const newPin = document.getElementById('cred-new-pin').value;
        const statusBox = document.getElementById('cred-status-box');

        if (!currentPin) {
          alert('Mohon masukkan kata sandi saat ini.');
          return;
        }

        updateCredBtn.disabled = true;
        updateCredBtn.innerText = 'Memproses...';

        try {
          const res = await fetch('/api/portal-auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'change_credentials',
              currentPin,
              newUsername,
              newPin,
            }),
          });
          const data = await res.json();
          statusBox.classList.remove('hidden');
          if (data.success) {
            statusBox.className = 'p-3 rounded-lg text-xs font-semibold bg-emerald-950/80 border border-emerald-800 text-emerald-200';
            statusBox.innerText = '✓ ' + data.message;
            document.getElementById('cred-current-pin').value = '';
            document.getElementById('cred-new-pin').value = '';
          } else {
            statusBox.className = 'p-3 rounded-lg text-xs font-semibold bg-red-950/80 border border-red-800 text-red-200';
            statusBox.innerText = '✕ ' + data.error;
          }
        } catch (err) {
          alert('Terjadi kesalahan jaringan: ' + err.message);
        } finally {
          updateCredBtn.disabled = false;
          updateCredBtn.innerText = 'Perbarui Kata Sandi Admin';
        }
      });
    }

    // 4. Save Form Handling
    const settingsForm = document.getElementById('portal-settings-form');
    if (settingsForm) {
      settingsForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('save-submit-btn');
        const statusMsg = document.getElementById('save-status-msg');

        const formData = new FormData(settingsForm);
        const missionsRaw = document.getElementById('portal-missions-input').value;
        const missions = missionsRaw
          .split('\n')
          .map((m) => m.trim())
          .filter(Boolean);

        const payload = {
          orgName: formData.get('orgName'),
          orgNameEn: formData.get('orgNameEn'),
          sloganId: formData.get('sloganId'),
          sloganEn: formData.get('sloganEn'),
          domainDisplay: formData.get('domainDisplay'),
          description: formData.get('description'),
          logoUrl: formData.get('logoUrl'),
          faviconUrl: formData.get('faviconUrl'),
          email: formData.get('email'),
          whatsapp: formData.get('whatsapp'),
          address: formData.get('address'),
          flagshipJournalName: formData.get('flagshipJournalName'),
          flagshipJournalEn: formData.get('flagshipJournalEn'),
          flagshipJournalUrl: formData.get('flagshipJournalUrl'),
          flagshipJournalEmblemUrl: formData.get('flagshipJournalEmblemUrl'),
          callForPapersActive: formData.get('callForPapersActive') === 'on',
          missions,
        };

        saveBtn.disabled = true;
        saveBtn.innerText = 'Menyimpan ke D1...';

        try {
          const res = await fetch('/api/portal-settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            statusMsg.innerHTML = '<span class="text-emerald-400 font-bold">✓ Sukses! Pengaturan dan aset gambar berhasil disimpan ke database D1.</span>';
          } else {
            statusMsg.innerHTML = '<span class="text-red-400 font-bold">✕ Gagal: ' + (data.error || 'Terjadi kesalahan') + '</span>';
          }
        } catch (err) {
          statusMsg.innerHTML = '<span class="text-red-400 font-bold">✕ Error: ' + err.message + '</span>';
        } finally {
          saveBtn.disabled = false;
          saveBtn.innerText = 'Simpan Perubahan Portal';
          setTimeout(() => {
            statusMsg.innerText = 'Perubahan dan berkas gambar tersimpan langsung ke Cloudflare D1 database.';
          }, 6000);
        }
      });
    }
  </script>
</Layout>
