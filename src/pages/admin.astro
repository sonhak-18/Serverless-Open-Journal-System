---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getDbSettings, getDbArticles, getDbEditorial, getDbIndexing } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const articles = await getDbArticles(d1);
const editorial = await getDbEditorial(d1);
const indexing = await getDbIndexing(d1);

const { editorInChief, editors, reviewers } = editorial;
---

<Layout title="Panel Redaksi & Admin Jurnal" description={`Halaman pengelolaan dan publikasi naskah ${journalConfig.name}`}>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Header Admin -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-academic-border pb-5 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="academic-badge bg-academic-navy text-white">Editorial Studio (GUI)</span>
          <span class="text-xs text-academic-ink-subtle">Sistem Pengelolaan Publikasi Mandiri Terintegrasi Database</span>
        </div>
        <h1 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy mt-1">
          Panel Administrasi & Redaksi JTAAP
        </h1>
        <p class="text-xs text-academic-ink-muted mt-1">
          Semua pengaturan, penambahan artikel, kontak narahubung, dan dewan redaksi dapat dikelola langsung lewat antarmuka grafis (GUI) di bawah ini.
        </p>
      </div>

      <!-- Status Database & Tombol Logout -->
      <div class="flex items-center gap-2.5 self-start sm:self-center">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span>Database Terhubung (D1 / SQLite)</span>
        </span>
        <button
          type="button"
          id="btn-admin-logout"
          class="hidden px-3.5 py-1.5 bg-rose-700 hover:bg-rose-800 text-white text-xs font-semibold rounded transition-colors shadow-2xs flex items-center gap-1.5"
          title="Keluar dari Panel Admin"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Keluar</span>
        </button>
      </div>
    </div>

    <!-- Alert Notifikasi Global -->
    <div id="admin-toast" class="hidden mb-6 p-4 rounded border text-xs sm:text-sm font-semibold flex items-center justify-between transition-all">
      <span id="admin-toast-msg"></span>
      <button type="button" aria-label="Tutup notifikasi" onclick="document.getElementById('admin-toast').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 ml-4 p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Area Login Sederhana (Gerbang Admin) -->
    <div id="admin-login-lock" class="academic-card p-8 rounded border border-academic-border max-w-md mx-auto my-12 text-center shadow-sm">
      <div class="w-12 h-12 rounded-full bg-academic-navy/10 text-academic-navy flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-academic-navy" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="text-lg font-serif font-bold text-academic-navy">
        Akses Khusus Dewan Redaksi
      </h2>
      <p class="text-xs sm:text-sm text-academic-ink-muted mt-1 mb-6">
        Masukkan kata sandi atau PIN untuk masuk ke panel administrasi redaksi.
      </p>

      <form id="admin-login-form" class="space-y-4 text-left">
        <div>
          <label for="admin-pin" class="block text-sm font-semibold text-slate-800 mb-1">
            Kata Sandi / PIN Redaksi
          </label>
          <input
            type="password"
            id="admin-pin"
            required
            placeholder="Masukkan kata sandi / PIN"
            class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
          />
        </div>
        <p id="login-error" class="text-xs text-rose-600 hidden">
          Kata sandi salah. Silakan coba lagi.
        </p>
        <button
          type="submit"
          class="w-full py-2.5 px-4 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded transition-colors shadow min-h-[44px]"
        >
          Masuk ke Panel Redaksi
        </button>
      </form>
    </div>

    <!-- Konten Dashboard Admin (Tersembunyi Sebelum Login) -->
    <div id="admin-dashboard-content" class="hidden space-y-8">
      <!-- Navigasi Tab Admin -->
      <div class="flex border-b border-academic-border text-xs sm:text-sm font-medium space-x-1 sm:space-x-3 overflow-x-auto pb-1" role="tablist">
        <button
          type="button"
          class="admin-tab active py-2.5 px-3.5 border-b-2 border-academic-navy text-academic-navy font-bold shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-add-article"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Terbitkan Naskah</span>
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-articles-list"
        >
          Naskah Terbit ({articles.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-editorial-settings"
        >
          Tim Redaksi ({editors.length + reviewers.length + 1})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-profile-settings"
        >
          Profil Jurnal
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-volume-settings"
        >
          Edisi & Terbitan
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-announcement-settings"
        >
          Pengumuman
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-journal-settings"
        >
          Kontak & Narahubung
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-indexing-settings"
        >
          Pengaturan Indexing ({indexing.length})
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px]"
          data-tab="tab-gdrive-config"
        >
          Google Drive Index
        </button>
        <button
          type="button"
          class="admin-tab py-2.5 px-3.5 border-b-2 border-transparent text-slate-600 hover:text-academic-navy shrink-0 min-h-[44px] flex items-center gap-1.5"
          data-tab="tab-security-settings"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>Keamanan & PIN</span>
        </button>
      </div>

      <!-- TAB 1: FORM INPUT ARTIKEL BARU -->
      <div id="tab-add-article" class="tab-panel space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-sm">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Formulir Penerbitan Artikel Ilmiah
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Saat disimpan, naskah langsung masuk ke database dan tayang seketika pada halaman publik.
            </p>
          </div>

          <form id="form-new-article" class="space-y-5">
            <!-- Judul & Rumpun -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
              <div class="md:col-span-8">
                <label for="art-title" class="block text-sm font-semibold text-slate-800 mb-1">
                  Judul Lengkap Artikel <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-title"
                  required
                  placeholder="Contoh: Analisis Kepatuhan Pajak atas Pemanfaatan Fasilitas Super Tax Deduction..."
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                />
              </div>

              <div class="md:col-span-4">
                <label for="art-subject" class="block text-sm font-semibold text-slate-800 mb-1">
                  Rumpun Keilmuan <span class="text-rose-600">*</span>
                </label>
                <select
                  id="art-subject"
                  required
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none bg-white min-h-[44px]"
                >
                  <option value="Audit">Audit & Investigasi Fraud</option>
                  <option value="Akuntansi">Akuntansi Keuangan & Manajemen</option>
                  <option value="Pajak">Perpajakan & Kebijakan Fiskal</option>
                </select>
              </div>
            </div>

            <!-- Panel Mandiri Penulis & Afiliasi -->
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 sm:p-5 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
                <div>
                  <h3 class="text-sm font-bold text-academic-navy flex items-center gap-2">
                    <svg class="w-4 h-4 text-academic-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    Daftar Penulis & Afiliasi Naskah
                  </h3>
                  <p class="text-xs text-slate-600 mt-0.5">
                    Konfigurasi mandiri penulis. Anda dapat menambah penulis pendamping secara dinamis dengan informasi lengkap.
                  </p>
                </div>
                <button
                  type="button"
                  id="btn-add-author"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-academic-navy hover:bg-academic-navy-light text-white text-xs font-semibold rounded shadow-xs transition-colors self-start sm:self-auto"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                  <span>+ Tambah Penulis</span>
                </button>
              </div>

              <!-- Container Baris Penulis Dinamis -->
              <div id="authors-container" class="space-y-3">
                <div class="author-row bg-white p-4 rounded border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-end shadow-2xs">
                  <div class="md:col-span-4">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Nama Penulis Utama <span class="text-rose-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="author_name"
                      required
                      placeholder="Contoh: Dr. Rahmat Hidayat, M.Ak."
                      class="author-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                    />
                  </div>
                  <div class="md:col-span-4">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Afiliasi / Universitas / Lembaga Riset <span class="text-rose-600">*</span>
                    </label>
                    <input
                      type="text"
                      name="author_affiliation"
                      required
                      placeholder="Contoh: Universitas Indonesia"
                      class="author-affiliation-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                    />
                  </div>
                  <div class="md:col-span-3">
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                      Email Korespondensi <span class="text-slate-400 font-normal">(Opsional)</span>
                    </label>
                    <input
                      type="email"
                      name="author_email"
                      placeholder="rahmat@ui.ac.id"
                      class="author-email-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
                    />
                  </div>
                  <div class="md:col-span-1 flex justify-end">
                    <button
                      type="button"
                      class="btn-remove-author p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors"
                      title="Hapus baris penulis ini"
                      disabled
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Abstrak & Kata Kunci -->
            <div>
              <label for="art-abstract" class="block text-sm font-semibold text-slate-800 mb-1">
                Teks Abstrak (Bahasa Indonesia atau Inggris) <span class="text-rose-600">*</span>
              </label>
              <textarea
                id="art-abstract"
                rows="4"
                required
                placeholder="Tuliskan latar belakang singkat, tujuan, metode penelitian, dan kesimpulan temuan utama..."
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
              ></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="art-keywords" class="block text-sm font-semibold text-slate-800 mb-1">
                  Kata Kunci (Keywords) <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-keywords"
                  required
                  placeholder="Contoh: Kepatuhan Pajak, Super Tax Deduction, Fiskal"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
                />
                <span class="text-xs text-slate-500 mt-1 block">Pisahkan dengan koma (3-5 kata kunci).</span>
              </div>

              <div>
                <label for="art-pdffile" class="block text-sm font-semibold text-slate-800 mb-1">
                  Nama File PDF di Google Drive <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="art-pdffile"
                  required
                  placeholder="Contoh: jtaap-v1n1-04-rahmat-pajak.pdf"
                  class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
                />
                <span class="text-xs text-slate-500 mt-1 block">Nama file PDF naskah yang disimpan di Google Drive / Cloudflare R2.</span>
              </div>
            </div>

            <!-- Metadata Edisi & Halaman -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 bg-slate-50 p-4 rounded border border-slate-200 text-xs sm:text-sm">
              <div>
                <label for="art-volume" class="block font-semibold text-slate-800 mb-1">Volume</label>
                <input type="number" id="art-volume" value={journalConfig.currentIssue?.volume ?? 1} min="1" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none" />
              </div>
              <div>
                <label for="art-issue" class="block font-semibold text-slate-800 mb-1">Nomor Issue</label>
                <input type="number" id="art-issue" value={journalConfig.currentIssue?.issue ?? 1} min="1" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none" />
              </div>
              <div>
                <label for="art-pages" class="block font-semibold text-slate-800 mb-1">Rentang Halaman</label>
                <input type="text" id="art-pages" value="45-58" placeholder="Contoh: 45-58" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none" />
              </div>
              <div>
                <label for="art-doi" class="block font-semibold text-slate-800 mb-1">DOI Suffix</label>
                <input type="text" id="art-doi" value="10.5281/zenodo.jtaap.2026.1104" class="w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy outline-none font-mono" />
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                id="btn-submit-article"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan & Publikasikan ke Database</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 2: DAFTAR ARTIKEL TERBIT -->
      <div id="tab-articles-list" class="tab-panel hidden space-y-4">
        <div class="academic-card p-6 rounded border border-academic-border bg-white">
          <h2 class="text-lg font-serif font-bold text-academic-navy pb-3 border-b border-slate-200 mb-4">
            Daftar Artikel yang Sedang Aktif di Database ({articles.length})
          </h2>

          <div class="overflow-x-auto">
            <table class="w-full text-xs text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-300">
                  <th class="p-3 font-semibold">Judul Artikel</th>
                  <th class="p-3 font-semibold">Penulis</th>
                  <th class="p-3 font-semibold">Bidang</th>
                  <th class="p-3 font-semibold">Edisi</th>
                  <th class="p-3 font-semibold text-right">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {articles.map((item) => (
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="p-3 font-medium text-academic-navy max-w-xs truncate">
                      {item.title}
                    </td>
                    <td class="p-3 text-slate-600">
                      {item.authors.map(a => a.name).join(', ')}
                    </td>
                    <td class="p-3">
                      <span class="academic-badge bg-slate-100 border text-slate-800">
                        {item.subject}
                      </span>
                    </td>
                    <td class="p-3 text-slate-600">
                      Vol. {item.volume} No. {item.issue}
                    </td>
                    <td class="p-3 text-right space-x-2">
                      <a
                        href={`/article/${item.slug}`}
                        target="_blank"
                        class="text-blue-700 hover:underline font-semibold"
                      >
                        Buka
                      </a>
                      <button
                        type="button"
                        class="btn-delete-article text-red-600 hover:text-red-800 font-semibold"
                        data-slug={item.slug}
                      >
                        Hapus
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 3: PENGATURAN TIM REDAKSI (EDITORIAL TEAM SETUP) -->
      <div id="tab-editorial-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white space-y-6">
          <div class="border-b border-slate-200 pb-3 flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Kelola Dewan Redaksi & Mitra Bestari
              </h2>
              <p class="text-xs text-academic-ink-muted mt-0.5">
                Semua perubahan yang disimpan di sini langsung memperbarui halaman <code>/editorial-team</code> dan metadata publikasi.
              </p>
            </div>
            <a href="/editorial-team" target="_blank" class="text-xs font-semibold text-blue-700 hover:underline">
              Lihat Halaman Publik ↗
            </a>
          </div>

          <!-- Section A: Pemimpin Redaksi (Editor-in-Chief) -->
          <div class="bg-slate-50 p-4 rounded border border-slate-200 space-y-3">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              1. Pemimpin Redaksi (Editor-in-Chief)
            </span>
            <form id="form-eic" class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Lengkap & Gelar</label>
                <input type="text" id="eic-name" value={editorInChief.name} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white font-medium" />
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Afiliasi / Komunitas Riset</label>
                <input type="text" id="eic-affil" value={editorInChief.affiliation} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Email Redaksi</label>
                  <input type="email" id="eic-email" value={editorInChief.email} required class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white font-mono" />
                </div>
                <button type="submit" class="px-4 py-1.5 bg-[#1e4a7a] hover:bg-[#153457] text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  Simpan EIC
                </button>
              </div>
            </form>
          </div>

          <!-- Section B: Dewan Editor Bidang -->
          <div class="space-y-4">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              2. Dewan Editor Eksekutif ({editors.length} Anggota)
            </span>

            <!-- Form Tambah Editor -->
            <form id="form-add-editor" class="p-3 bg-slate-50 rounded border border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Editor</label>
                <input type="text" id="new-ed-name" required placeholder="Nama & Gelar" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Peran / Bidang</label>
                <input type="text" id="new-ed-role" required placeholder="Contoh: Managing Editor" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Afiliasi</label>
                  <input type="text" id="new-ed-affil" required placeholder="Nama Universitas / Lembaga" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
                </div>
                <button type="submit" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  + Tambah
                </button>
              </div>
            </form>

            <div class="border border-slate-200 rounded overflow-hidden">
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-700 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Nama</th>
                    <th class="p-2.5">Peran / Bidang</th>
                    <th class="p-2.5">Afiliasi</th>
                    <th class="p-2.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  {editors.map((ed) => (
                    <tr class="hover:bg-slate-50">
                      <td class="p-2.5 font-bold text-slate-800">{ed.name}</td>
                      <td class="p-2.5 text-slate-600">{ed.role}</td>
                      <td class="p-2.5 text-slate-500">{ed.affiliation}</td>
                      <td class="p-2.5 text-right">
                        <button type="button" class="btn-delete-member text-red-600 hover:text-red-800 font-semibold" data-id={ed.id}>
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Section C: Mitra Bestari (Reviewers) -->
          <div class="space-y-4">
            <span class="font-serif font-bold text-sm text-academic-navy block">
              3. Mitra Bestari / Peer Reviewers ({reviewers.length} Penelaah)
            </span>

            <!-- Form Tambah Reviewer -->
            <form id="form-add-reviewer" class="p-3 bg-slate-50 rounded border border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs items-end">
              <div>
                <label class="block font-semibold text-slate-700 mb-1">Nama Reviewer</label>
                <input type="text" id="new-rev-name" required placeholder="Nama Lengkap & Gelar" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
              </div>
              <div class="flex gap-2 items-end">
                <div class="flex-grow">
                  <label class="block font-semibold text-slate-700 mb-1">Afiliasi Universitas / Lembaga</label>
                  <input type="text" id="new-rev-affil" required placeholder="Nama Kampus / Lembaga Riset" class="w-full px-2 py-1.5 border border-slate-300 rounded bg-white" />
                </div>
                <button type="submit" class="px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold rounded text-xs min-h-[34px] shrink-0">
                  + Tambah
                </button>
              </div>
            </form>

            <div class="border border-slate-200 rounded overflow-hidden">
              <table class="w-full text-xs text-left">
                <thead class="bg-slate-100 text-slate-700 border-b border-slate-200">
                  <tr>
                    <th class="p-2.5">Nama Reviewer</th>
                    <th class="p-2.5">Afiliasi Universitas / Lembaga</th>
                    <th class="p-2.5 text-right">Aksi</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                  {reviewers.map((rev) => (
                    <tr class="hover:bg-slate-50">
                      <td class="p-2.5 font-bold text-slate-800">{rev.name}</td>
                      <td class="p-2.5 text-slate-600">{rev.affiliation}</td>
                      <td class="p-2.5 text-right">
                        <button type="button" class="btn-delete-member text-red-600 hover:text-red-800 font-semibold" data-id={rev.id}>
                          Hapus
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB: PROFIL & IDENTITAS JURNAL -->
      <div id="tab-profile-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Profil, Identitas & Akreditasi Jurnal
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Pengaturan nama jurnal, akreditasi, frekuensi penerbitan, lisensi, dan DOI langsung tersimpan ke Cloudflare D1.
            </p>
          </div>

          <form id="form-profile-settings" class="space-y-4 text-xs">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="md:col-span-2">
                <label for="cfg-journal-name" class="block font-semibold text-academic-navy mb-1">
                  Nama Jurnal Lengkap (Bahasa Indonesia) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-journal-name"
                  value={journalConfig.name}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-serif text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-journal-name-en" class="block font-semibold text-academic-navy mb-1">
                  Nama Jurnal (Bahasa Inggris / English Title)
                </label>
                <input
                  type="text"
                  id="cfg-journal-name-en"
                  value={journalConfig.nameEn}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-journal-short" class="block font-semibold text-academic-navy mb-1">
                  Singkatan / Inisial Jurnal (Akronim) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-journal-short"
                  value={journalConfig.shortName}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div class="md:col-span-2">
                <label for="cfg-accredited" class="block font-semibold text-academic-navy mb-1">
                  Status & Keterangan Akreditasi (Tagline)
                </label>
                <input
                  type="text"
                  id="cfg-accredited"
                  value={journalConfig.accreditedText}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-frequency" class="block font-semibold text-academic-navy mb-1">
                  Frekuensi Terbitan
                </label>
                <input
                  type="text"
                  id="cfg-frequency"
                  value={journalConfig.publicationFrequency}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-doi-prefix" class="block font-semibold text-academic-navy mb-1">
                  Prefix DOI Resmi (Zenodo / Crossref)
                </label>
                <input
                  type="text"
                  id="cfg-doi-prefix"
                  value={journalConfig.doiPrefix}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-license" class="block font-semibold text-academic-navy mb-1">
                  Nama Lisensi Karya
                </label>
                <input
                  type="text"
                  id="cfg-license"
                  value={journalConfig.license}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-license-url" class="block font-semibold text-academic-navy mb-1">
                  Tautan URL Lisensi
                </label>
                <input
                  type="url"
                  id="cfg-license-url"
                  value={journalConfig.licenseUrl}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-similarity" class="block font-semibold text-academic-navy mb-1">
                  Batas Maksimal Similarity Turnitin (%)
                </label>
                <input
                  type="number"
                  id="cfg-similarity"
                  value={journalConfig.submission.turnitinMaxSimilarity}
                  min="5"
                  max="50"
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white font-mono"
                />
              </div>

              <div>
                <label for="cfg-review-time" class="block font-semibold text-academic-navy mb-1">
                  Estimasi Waktu Review Naskah
                </label>
                <input
                  type="text"
                  id="cfg-review-time"
                  value={journalConfig.submission.reviewTimeEstimate}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Profil Jurnal</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGATURAN EDISI & TERBITAN AKTIF (VOLUME / ISSUE) -->
      <div id="tab-volume-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengaturan Terbitan Aktif (Current Issue & Volume)
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Atur edisi yang sedang tayang pada bagian "Current Issue" di beranda dan halaman terbitan terkini.
            </p>
          </div>

          <form id="form-volume-settings" class="space-y-4 text-sm">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50 p-4 sm:p-5 rounded border border-slate-200">
              <div>
                <label for="cfg-vol-num" class="block font-semibold text-slate-800 mb-1">
                  Volume Terbitan Aktif <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-vol-num"
                  value={journalConfig.currentIssue?.volume ?? 1}
                  min="1"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="cfg-issue-num" class="block font-semibold text-slate-800 mb-1">
                  Nomor Issue Terbitan Aktif <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-issue-num"
                  value={journalConfig.currentIssue?.issue ?? 1}
                  min="1"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div>
                <label for="cfg-issue-year" class="block font-semibold text-slate-800 mb-1">
                  Tahun Terbitan <span class="text-rose-600">*</span>
                </label>
                <input
                  type="number"
                  id="cfg-issue-year"
                  value={journalConfig.currentIssue?.year ?? 2026}
                  min="2020"
                  max="2040"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-period" class="block font-semibold text-slate-800 mb-1">
                  Periode / Bulan Publikasi Edisi <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-issue-period"
                  value={journalConfig.currentIssue?.period || 'Maret 2026'}
                  placeholder="Contoh: Maret 2026 atau Januari - Juni 2026"
                  required
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white outline-none focus:border-academic-navy"
                />
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-cover" class="block font-semibold text-slate-800 mb-1">
                  URL Gambar Sampul (Cover Image) Edisi
                </label>
                <input
                  type="url"
                  id="cfg-issue-cover"
                  value={journalConfig.currentIssue?.coverUrl || ''}
                  placeholder="https://cdnjttap.darpana.web.id/0:/cover-jtaap-vol1.jpg atau kosongkan untuk mockup otomatis"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white font-mono outline-none focus:border-academic-navy"
                />
                <span class="text-xs text-slate-500 mt-1 block">
                  Kosongkan jika ingin menggunakan mockup kartu sampul bergaya OJS secara otomatis.
                </span>
              </div>

              <div class="sm:col-span-3">
                <label for="cfg-issue-theme" class="block font-semibold text-slate-800 mb-1">
                  Tema Khusus / Keterangan Edisi Ini
                </label>
                <textarea
                  id="cfg-issue-theme"
                  rows="2"
                  placeholder="Contoh: Edisi Perdana: Inovasi Audit, Akuntansi Keberlanjutan & Modernisasi Sistem Perpajakan"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded text-sm bg-white outline-none focus:border-academic-navy"
                >{journalConfig.currentIssue?.theme || ''}</textarea>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Terbitan Aktif</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGUMUMAN / ANNOUNCEMENT -->
      <div id="tab-announcement-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-xs">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengumuman Redaksi & Call for Papers
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Pengumuman ini tampil langsung pada kartu atas beranda jurnal dan dapat diaktifkan atau dinonaktifkan kapan saja.
            </p>
          </div>

          <form id="form-announcement-settings" class="space-y-4 text-xs">
            <div class="p-4 bg-amber-50/60 border border-amber-200 rounded space-y-4">
              <div class="flex items-center gap-2">
                <input
                  type="checkbox"
                  id="cfg-ann-active"
                  checked={journalConfig.announcement?.active}
                  class="w-4 h-4 rounded text-amber-700 cursor-pointer"
                />
                <label for="cfg-ann-active" class="font-bold text-amber-950 cursor-pointer text-xs">
                  Tampilkan Kotak Pengumuman ini di Beranda Jurnal
                </label>
              </div>

              <div>
                <label for="cfg-ann-title" class="block font-semibold text-slate-800 mb-1">
                  Judul Pengumuman <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-ann-title"
                  value={journalConfig.announcement?.title || ''}
                  placeholder="Contoh: Call for Papers: Volume 1 Nomor 1 (2026)"
                  class="w-full px-3 py-2 border border-slate-300 rounded font-serif text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-ann-date" class="block font-semibold text-slate-800 mb-1">
                  Tanggal Pengumuman (YYYY-MM-DD)
                </label>
                <input
                  type="text"
                  id="cfg-ann-date"
                  value={journalConfig.announcement?.date || ''}
                  placeholder="2026-03-01"
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-xs bg-white"
                />
              </div>

              <div>
                <label for="cfg-ann-content" class="block font-semibold text-slate-800 mb-1">
                  Isi Pengumuman Lengkap
                </label>
                <textarea
                  id="cfg-ann-content"
                  rows="4"
                  placeholder="Tuliskan isi pengumuman, ruang lingkup naskah, atau tanggal penting..."
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white leading-relaxed"
                >{journalConfig.announcement?.content || ''}</textarea>
              </div>
            </div>

            <div class="pt-4 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Pengumuman ke Database</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB: PENGATURAN KONTAK WA, EMAIL & JURNAL -->
      <div id="tab-journal-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengaturan Narahubung Redaksi & Komunitas
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Data ini langsung tersimpan ke database dan mengupdate tombol WhatsApp, email, dan footer.
            </p>
          </div>

          <form id="form-contact-settings" class="space-y-4 text-xs">
            <!-- Kontak WhatsApp & Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-emerald-50/50 p-4 rounded border border-emerald-200">
              <div>
                <label for="cfg-wa-num" class="block font-semibold text-emerald-950 mb-1">
                  Nomor WhatsApp API (Format: 628xxxxxxxxxx) <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-wa-num"
                  value={journalConfig.submission.whatsappNumber}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div>
                <label for="cfg-wa-display" class="block font-semibold text-emerald-950 mb-1">
                  Tampilan Nomor WhatsApp di Web <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="cfg-wa-display"
                  value={journalConfig.submission.whatsappDisplay}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="cfg-email" class="block font-semibold text-emerald-950 mb-1">
                  Alamat Email Resmi Redaksi <span class="text-red-500">*</span>
                </label>
                <input
                  type="email"
                  id="cfg-email"
                  value={journalConfig.submission.email}
                  required
                  class="w-full px-3 py-2 border border-slate-300 rounded font-mono text-sm bg-white"
                />
              </div>

              <div class="sm:col-span-2">
                <label for="cfg-wa-msg" class="block font-semibold text-emerald-950 mb-1">
                  Pesan Pembuka Otomatis WhatsApp Penulis
                </label>
                <input
                  type="text"
                  id="cfg-wa-msg"
                  value={journalConfig.submission.whatsappDefaultMessage}
                  class="w-full px-3 py-2 border border-slate-300 rounded text-xs bg-white"
                />
              </div>
            </div>

            <!-- Organisasi & Komunitas Riset -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-slate-50 p-4 rounded border border-slate-200">
              <div>
                <label class="block font-semibold text-academic-navy mb-1">Nama Organisasi / Komunitas Riset</label>
                <input type="text" id="cfg-org-name" value={journalConfig.institution} class="w-full px-3 py-2 border border-slate-300 rounded bg-white" />
              </div>

              <div>
                <label class="block font-semibold text-academic-navy mb-1">Penerbit (Publisher Press)</label>
                <input type="text" id="cfg-pub-name" value={journalConfig.publisher} class="w-full px-3 py-2 border border-slate-300 rounded bg-white" />
              </div>

              <div class="sm:col-span-2">
                <label class="block font-semibold text-academic-navy mb-1">Alamat Sekretariat Redaksi</label>
                <input type="text" id="cfg-address" value={journalConfig.address} class="w-full px-3 py-2 border border-slate-300 rounded bg-white" />
              </div>

              <div>
                <label class="block font-semibold text-academic-navy mb-1">e-ISSN</label>
                <input type="text" id="cfg-eissn" value={journalConfig.eIssn} class="w-full px-3 py-2 border border-slate-300 rounded bg-white font-mono" />
              </div>

              <div>
                <label class="block font-semibold text-academic-navy mb-1">p-ISSN</label>
                <input type="text" id="cfg-pissn" value={journalConfig.pIssn} class="w-full px-3 py-2 border border-slate-300 rounded bg-white font-mono" />
              </div>
            </div>

            <!-- Fitur Sidebar Toggles -->
            <div class="p-4 bg-white border border-slate-200 rounded space-y-2">
              <span class="font-bold text-academic-navy block mb-2">Visibilitas Modul Sidebar Kanan:</span>
              <div class="flex flex-wrap gap-4 text-xs">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-idx" checked={journalConfig.features.showIndexingBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Kotak Indexed By</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-tools" checked={journalConfig.features.showToolsBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Recommended Tools</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="toggle-issn" checked={journalConfig.features.showIssnBlock} class="rounded text-blue-600" />
                  <span>Tampilkan Barcode ISSN</span>
                </label>
              </div>
            </div>

            <div class="pt-2 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white font-semibold rounded text-sm transition-colors shadow min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan Pengaturan Kontak & Jurnal</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 5: PENGATURAN INDEXING & PENGINDEKS -->
      <div id="tab-indexing-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white">
          <div class="border-b border-slate-200 pb-3 mb-6 flex flex-wrap items-center justify-between gap-2">
            <div>
              <h2 class="text-lg font-serif font-bold text-academic-navy">
                Kelola Pangkalan Data & Pengindeks Jurnal
              </h2>
              <p class="text-xs text-academic-ink-muted mt-1">
                Centang pada kolom "Di Sidebar" untuk langsung menampilkan atau menyembunyikan logo pengindeks di bilah kanan.
              </p>
            </div>
            <a
              href="/indexing"
              target="_blank"
              class="text-xs font-semibold text-blue-700 hover:underline"
            >
              Buka Halaman Indexing Publik ↗
            </a>
          </div>

          <!-- Tabel Status Pengindeks -->
          <div class="overflow-x-auto mb-6">
            <table class="w-full text-xs text-left border-collapse">
              <thead>
                <tr class="bg-slate-100 text-slate-700 border-b border-slate-300">
                  <th class="p-2.5 font-semibold">Nama Pengindeks</th>
                  <th class="p-2.5 font-semibold">Kategori</th>
                  <th class="p-2.5 font-semibold">Status</th>
                  <th class="p-2.5 font-semibold text-center">Tampil di Sidebar</th>
                  <th class="p-2.5 font-semibold">Tautan URL</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                {indexing.map((idx) => (
                  <tr class="hover:bg-slate-50">
                    <td class="p-2.5 font-bold text-slate-900">{idx.name}</td>
                    <td class="p-2.5 text-slate-600">{idx.category}</td>
                    <td class="p-2.5">
                      <span class={`text-[10px] font-bold px-2 py-0.5 rounded-xs uppercase ${
                        idx.status === 'Indexed'
                          ? 'bg-emerald-100 text-emerald-800'
                          : idx.status === 'In Process'
                          ? 'bg-blue-100 text-blue-800'
                          : 'bg-amber-100 text-amber-800'
                      }`}>
                        {idx.status}
                      </span>
                    </td>
                    <td class="p-2.5 text-center">
                      <input
                        type="checkbox"
                        class="toggle-index-sidebar cursor-pointer"
                        data-name={idx.name}
                        checked={idx.showInSidebar}
                      />
                    </td>
                    <td class="p-2.5">
                      <div class="flex items-center gap-1.5 min-w-[280px]">
                        <input
                          type="url"
                          value={idx.url}
                          class="input-index-url w-full px-2.5 py-1 text-xs font-mono border border-slate-300 rounded focus:border-blue-600 outline-none"
                          data-name={idx.name}
                          placeholder="https://..."
                        />
                        <button
                          type="button"
                          class="btn-save-index-url shrink-0 px-3 py-1 bg-slate-700 hover:bg-slate-800 text-white text-[11px] font-semibold rounded transition-colors"
                          data-name={idx.name}
                        >
                          Simpan
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 6: INTEGRASI GOOGLE DRIVE INDEX -->
      <div id="tab-gdrive-config" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Pengaturan Cloudflare Worker Google Drive Index
            </h2>
            <p class="text-xs text-academic-ink-muted mt-1">
              Tentukan alamat Worker Google Drive Index untuk mengalirkan file PDF naskah.
            </p>
          </div>

          <form id="form-gdrive" class="space-y-4">
            <div>
              <label for="cfg-gdrive-url" class="block text-sm font-semibold text-slate-800 mb-1">
                URL Worker Google Drive Index
              </label>
              <input
                type="url"
                id="cfg-gdrive-url"
                value={journalConfig.storage.gdriveIndexBaseUrl}
                required
                placeholder="https://cdn-papers.sektansia.workers.dev"
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
              />
            </div>

            <div class="flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded shadow transition-colors min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4" />
                </svg>
                <span>Simpan URL Google Drive</span>
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- TAB 7: KEAMANAN & GANTI PIN ADMIN -->
      <div id="tab-security-settings" class="tab-panel hidden space-y-6">
        <div class="academic-card p-6 rounded border border-academic-border bg-white shadow-sm max-w-xl">
          <div class="border-b border-slate-200 pb-3 mb-6">
            <h2 class="text-lg font-serif font-bold text-academic-navy">
              Ganti Kata Sandi / PIN Panel Redaksi
            </h2>
            <p class="text-xs sm:text-sm text-academic-ink-muted mt-1">
              Perbarui PIN untuk mengamankan akses panel administrasi jurnal.
            </p>
          </div>

          <form id="form-change-pin" class="space-y-4">
            <div>
              <label for="current-pin" class="block text-sm font-semibold text-slate-800 mb-1">
                PIN Saat Ini *
              </label>
              <input
                type="password"
                id="current-pin"
                required
                placeholder="Masukkan PIN lama"
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
              />
            </div>

            <div>
              <label for="new-pin" class="block text-sm font-semibold text-slate-800 mb-1">
                PIN Baru *
              </label>
              <input
                type="password"
                id="new-pin"
                required
                minlength="4"
                placeholder="Minimal 4 karakter"
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
              />
            </div>

            <div>
              <label for="confirm-new-pin" class="block text-sm font-semibold text-slate-800 mb-1">
                Konfirmasi PIN Baru *
              </label>
              <input
                type="password"
                id="confirm-new-pin"
                required
                minlength="4"
                placeholder="Ketik ulang PIN baru"
                class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
              />
            </div>

            <div class="pt-2 flex justify-end">
              <button
                type="submit"
                class="px-6 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm font-semibold rounded shadow transition-colors min-h-[44px] flex items-center gap-2"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span>Simpan PIN Baru</span>
              </button>
            </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Hapus Kustom (Indah, Bersih, Akademik) -->
  <div id="confirm-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded border border-slate-200 shadow-2xl max-w-md w-full p-6 space-y-4 animate-in fade-in zoom-in-95">
      <div class="flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-full bg-red-50 text-red-700 flex items-center justify-center shrink-0 border border-red-200">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </div>
        <div>
          <h3 id="confirm-modal-title" class="text-base font-serif font-bold text-academic-navy leading-snug">
            Konfirmasi Penghapusan
          </h3>
          <p id="confirm-modal-desc" class="text-xs text-slate-600 mt-1 leading-relaxed">
            Apakah Anda yakin ingin menghapus data ini dari database? Tindakan ini bersifat permanen.
          </p>
        </div>
      </div>

      <div id="confirm-modal-item" class="p-3 bg-slate-50 border border-slate-200 rounded text-xs font-mono text-slate-800 break-all">
        <!-- Item detail -->
      </div>

      <div class="flex items-center justify-end gap-2.5 pt-2">
        <button
          type="button"
          id="btn-cancel-modal"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded transition-colors"
        >
          Batal
        </button>
        <button
          type="button"
          id="btn-confirm-delete"
          class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded shadow-xs transition-colors"
        >
          Ya, Hapus Sekarang
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  function showToast(msg: string, isError = false) {
    const toast = document.getElementById('admin-toast');
    const toastMsg = document.getElementById('admin-toast-msg');
    if (!toast || !toastMsg) return;
    toastMsg.innerText = msg;
    toast.className = `mb-6 p-4 rounded-xs border text-xs font-semibold flex items-center justify-between transition-all ${
      isError ? 'bg-red-50 text-red-800 border-red-300' : 'bg-emerald-50 text-emerald-800 border-emerald-300'
    }`;
    toast.classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Login & Logout Check
  const loginForm = document.getElementById('admin-login-form');
  const loginLock = document.getElementById('admin-login-lock');
  const dashboardContent = document.getElementById('admin-dashboard-content');
  const loginError = document.getElementById('login-error');
  const adminPinInput = document.getElementById('admin-pin') as HTMLInputElement | null;
  const logoutBtn = document.getElementById('btn-admin-logout');

  function setAuthenticated(isAuth: boolean) {
    if (isAuth) {
      sessionStorage.setItem('sektansia_admin_auth', 'true');
      loginLock?.classList.add('hidden');
      dashboardContent?.classList.remove('hidden');
      logoutBtn?.classList.remove('hidden');
      loginError?.classList.add('hidden');
    } else {
      sessionStorage.removeItem('sektansia_admin_auth');
      loginLock?.classList.remove('hidden');
      dashboardContent?.classList.add('hidden');
      logoutBtn?.classList.add('hidden');
    }
  }

  if (sessionStorage.getItem('sektansia_admin_auth') === 'true') {
    setAuthenticated(true);
  }

  logoutBtn?.addEventListener('click', () => {
    setAuthenticated(false);
    showToast('✓ Anda telah berhasil keluar dari sesi panel redaksi.');
  });

  loginForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pin = adminPinInput?.value.trim();
    if (!pin) return;

    try {
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'verify', pin }),
      });
      const data = await res.json();
      if (data.success) {
        setAuthenticated(true);
        if (adminPinInput) adminPinInput.value = '';
      } else {
        loginError?.classList.remove('hidden');
        if (loginError && data.error) loginError.textContent = data.error;
      }
    } catch (err: any) {
      loginError?.classList.remove('hidden');
      if (loginError) loginError.textContent = 'Gagal memverifikasi: ' + err.message;
    }
  });

  // Custom Confirmation Modal Helper
  let pendingDeleteAction: (() => Promise<void>) | null = null;
  const confirmModal = document.getElementById('confirm-modal');
  const confirmTitle = document.getElementById('confirm-modal-title');
  const confirmDesc = document.getElementById('confirm-modal-desc');
  const confirmItem = document.getElementById('confirm-modal-item');
  const cancelBtn = document.getElementById('btn-cancel-modal');
  const confirmBtn = document.getElementById('btn-confirm-delete');

  function openConfirmModal(options: {
    title: string;
    message: string;
    item: string;
    onConfirm: () => Promise<void>;
  }) {
    if (confirmTitle) confirmTitle.textContent = options.title;
    if (confirmDesc) confirmDesc.textContent = options.message;
    if (confirmItem) confirmItem.textContent = options.item;
    pendingDeleteAction = options.onConfirm;
    confirmModal?.classList.remove('hidden');
  }

  function closeConfirmModal() {
    confirmModal?.classList.add('hidden');
    pendingDeleteAction = null;
  }

  cancelBtn?.addEventListener('click', closeConfirmModal);
  confirmModal?.addEventListener('click', (e) => {
    if (e.target === confirmModal) closeConfirmModal();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !confirmModal?.classList.contains('hidden')) {
      closeConfirmModal();
    }
  });

  confirmBtn?.addEventListener('click', async () => {
    if (pendingDeleteAction) {
      const action = pendingDeleteAction;
      closeConfirmModal();
      await action();
    }
  });

  // Tab switching with persistence
  const tabs = document.querySelectorAll<HTMLButtonElement>('.admin-tab');
  const panels = document.querySelectorAll<HTMLElement>('.tab-panel');

  function switchTab(targetId: string) {
    sessionStorage.setItem('sektansia_active_tab', targetId);
    tabs.forEach((t) => {
      if (t.getAttribute('data-tab') === targetId) {
        t.classList.remove('border-transparent', 'text-slate-600');
        t.classList.add('border-academic-navy', 'text-academic-navy', 'font-bold');
      } else {
        t.classList.remove('border-academic-navy', 'text-academic-navy', 'font-bold');
        t.classList.add('border-transparent', 'text-slate-600');
      }
    });

    panels.forEach((p) => {
      if (p.id === targetId) {
        p.classList.remove('hidden');
      } else {
        p.classList.add('hidden');
      }
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-tab');
      if (targetId) switchTab(targetId);
    });
  });

  // Restore active tab
  const savedTab = sessionStorage.getItem('sektansia_active_tab');
  if (savedTab && document.getElementById(savedTab)) {
    switchTab(savedTab);
  }

  // Dynamic Authors Builder Logic
  const authorsContainer = document.getElementById('authors-container');
  const btnAddAuthor = document.getElementById('btn-add-author');

  function updateRemoveButtonsState() {
    if (!authorsContainer) return;
    const rows = authorsContainer.querySelectorAll('.author-row');
    rows.forEach((row) => {
      const btnRemove = row.querySelector('.btn-remove-author') as HTMLButtonElement | null;
      if (btnRemove) {
        btnRemove.disabled = rows.length <= 1;
        if (rows.length <= 1) {
          btnRemove.classList.add('opacity-30', 'cursor-not-allowed');
        } else {
          btnRemove.classList.remove('opacity-30', 'cursor-not-allowed');
        }
      }
    });
  }

  function bindRemoveEvent(btn: HTMLButtonElement) {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const rows = authorsContainer?.querySelectorAll('.author-row') || [];
      if (rows.length > 1) {
        const row = btn.closest('.author-row');
        row?.remove();
        updateRemoveButtonsState();
      }
    });
  }

  // Bind initial row's remove button
  const initialRemoveBtn = authorsContainer?.querySelector('.btn-remove-author') as HTMLButtonElement | null;
  if (initialRemoveBtn) {
    bindRemoveEvent(initialRemoveBtn);
  }
  updateRemoveButtonsState();

  btnAddAuthor?.addEventListener('click', () => {
    if (!authorsContainer) return;
    const currentCount = authorsContainer.querySelectorAll('.author-row').length + 1;
    const newRow = document.createElement('div');
    newRow.className = 'author-row bg-white p-4 rounded border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 items-end shadow-2xs animate-fadeIn';
    newRow.innerHTML = `
      <div class="md:col-span-4">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Nama Penulis #${currentCount} <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="author_name"
          required
          placeholder="Contoh: Nama Penulis Pendamping"
          class="author-name-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
        />
      </div>
      <div class="md:col-span-4">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Afiliasi / Universitas / Lembaga Riset <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          name="author_affiliation"
          required
          placeholder="Contoh: Universitas Gadjah Mada"
          class="author-affiliation-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none"
        />
      </div>
      <div class="md:col-span-3">
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Email Korespondensi <span class="text-slate-400 font-normal">(Opsional)</span>
        </label>
        <input
          type="email"
          name="author_email"
          placeholder="penulis@ugm.ac.id"
          class="author-email-input w-full px-3 py-2 text-sm border border-slate-300 rounded focus:border-academic-navy focus:ring-1 focus:ring-academic-navy outline-none font-mono"
        />
      </div>
      <div class="md:col-span-1 flex justify-end">
        <button
          type="button"
          class="btn-remove-author p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded transition-colors"
          title="Hapus baris penulis ini"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>
    `;

    const btnRemove = newRow.querySelector('.btn-remove-author') as HTMLButtonElement | null;
    if (btnRemove) {
      bindRemoveEvent(btnRemove);
    }

    authorsContainer.appendChild(newRow);
    updateRemoveButtonsState();
  });

  // 1. Simpan Naskah Baru (Database)
  const articleForm = document.getElementById('form-new-article');
  articleForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const title = (document.getElementById('art-title') as HTMLInputElement).value;
    const subject = (document.getElementById('art-subject') as HTMLSelectElement).value;

    // Kumpulkan penulis dari konfigurasi panel mandiri
    const authorRows = authorsContainer ? authorsContainer.querySelectorAll('.author-row') : [];
    const authorsList: { name: string; affiliation: string; email?: string }[] = [];

    authorRows.forEach((row) => {
      const nameInput = row.querySelector('.author-name-input') as HTMLInputElement | null;
      const affInput = row.querySelector('.author-affiliation-input') as HTMLInputElement | null;
      const emailInput = row.querySelector('.author-email-input') as HTMLInputElement | null;

      if (nameInput && nameInput.value.trim()) {
        const item: { name: string; affiliation: string; email?: string } = {
          name: nameInput.value.trim(),
          affiliation: affInput ? affInput.value.trim() : '',
        };
        if (emailInput && emailInput.value.trim()) {
          item.email = emailInput.value.trim();
        }
        authorsList.push(item);
      }
    });

    if (authorsList.length === 0) {
      showToast('Harap masukkan minimal satu nama penulis naskah!', true);
      return;
    }

    const keywordsList = keywordsRaw.split(',').map((k) => k.trim());
    const [firstP, lastP] = pages.split('-').map((p) => Number(p.trim()) || 1);
    const today = new Date().toISOString().split('T')[0];

    const articleData = {
      slug,
      title,
      authors: authorsList,
      abstract,
      keywords: keywordsList,
      volume,
      issue,
      year: new Date().getFullYear(),
      pages,
      firstPage: firstP,
      lastPage: lastP || firstP + 10,
      publishDate: today,
      receivedDate: today,
      acceptedDate: today,
      doi,
      pdfFileName: pdfFile,
      fileSizeBytes: 450000,
      subject,
    };

    try {
      const res = await fetch('/api/articles', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add', article: articleData }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Artikel berhasil diterbitkan dan tersimpan di database!');
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('Gagal menyimpan artikel: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Terjadi kesalahan jaringan: ' + err.message, true);
    }
  });

  // Hapus Artikel (Modal Kustom & Hapus Baris Tanpa Reload)
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-article').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-slug');
      if (!slug) return;
      const row = btn.closest('tr');
      const title = row?.querySelector('td')?.textContent?.trim() || slug;

      openConfirmModal({
        title: 'Hapus Naskah Artikel',
        message: 'Naskah artikel ini akan dihapus secara permanen dari database Cloudflare D1. Tindakan ini tidak dapat dibatalkan.',
        item: `Judul: "${title}" (Slug: ${slug})`,
        onConfirm: async () => {
          try {
            const res = await fetch('/api/articles', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete', slug }),
            });
            const json = await res.json();
            if (json.success) {
              if (row) {
                row.style.transition = 'all 0.3s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => row.remove(), 300);
              }
              const tabArt = document.querySelector('[data-tab="tab-articles-list"]');
              if (tabArt) {
                const currentRows = document.querySelectorAll('#tab-articles-list tbody tr').length - 1;
                tabArt.textContent = `Naskah Terbit (${Math.max(0, currentRows)})`;
              }
              showToast(`✓ Artikel "${slug}" berhasil dihapus dari database!`);
            } else {
              showToast('Gagal menghapus: ' + json.error, true);
            }
          } catch (err: any) {
            showToast('Gagal menghapus: ' + err.message, true);
          }
        },
      });
    });
  });

  // 2. Simpan Pemimpin Redaksi (EIC)
  const formEic = document.getElementById('form-eic');
  formEic?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('eic-name') as HTMLInputElement).value;
    const affiliation = (document.getElementById('eic-affil') as HTMLInputElement).value;
    const email = (document.getElementById('eic-email') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/editorial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'update_eic', name, affiliation, email }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Data Pemimpin Redaksi (Editor-in-Chief) berhasil diperbarui di database!');
      }
    } catch (err: any) {
      showToast('Gagal menyimpan: ' + err.message, true);
    }
  });

  // Tambah Editor
  const formAddEd = document.getElementById('form-add-editor');
  formAddEd?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('new-ed-name') as HTMLInputElement).value;
    const role = (document.getElementById('new-ed-role') as HTMLInputElement).value;
    const affiliation = (document.getElementById('new-ed-affil') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/editorial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add_member', type: 'editor', name, role, affiliation }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Anggota Dewan Editor berhasil ditambahkan ke database!');
        setTimeout(() => location.reload(), 1000);
      }
    } catch (err: any) {
      showToast('Gagal menambah editor: ' + err.message, true);
    }
  });

  // Tambah Reviewer
  const formAddRev = document.getElementById('form-add-reviewer');
  formAddRev?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('new-rev-name') as HTMLInputElement).value;
    const affiliation = (document.getElementById('new-rev-affil') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/editorial', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'add_member', type: 'reviewer', name, affiliation }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Mitra Bestari (Reviewer) berhasil ditambahkan ke database!');
        setTimeout(() => location.reload(), 1000);
      }
    } catch (err: any) {
      showToast('Gagal menambah reviewer: ' + err.message, true);
    }
  });

  // Hapus Anggota Tim Redaksi (Modal Kustom & Hapus Baris Tanpa Reload)
  document.querySelectorAll<HTMLButtonElement>('.btn-delete-member').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      const row = btn.closest('tr');
      const name = row?.querySelector('td')?.textContent?.trim() || 'Anggota Redaksi';

      openConfirmModal({
        title: 'Hapus Anggota Redaksi',
        message: 'Data anggota tim redaksi ini akan dihapus secara permanen dari database Cloudflare D1.',
        item: `Nama: "${name}"`,
        onConfirm: async () => {
          try {
            const res = await fetch('/api/editorial', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete_member', id }),
            });
            const json = await res.json();
            if (json.success) {
              if (row) {
                row.style.transition = 'all 0.3s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => row.remove(), 300);
              }
              const tabEd = document.querySelector('[data-tab="tab-editorial-settings"]');
              if (tabEd) {
                const totalRows = document.querySelectorAll('#tab-editorial-settings tbody tr').length - 1;
                tabEd.textContent = `Tim Redaksi (${Math.max(0, totalRows)})`;
              }
              showToast(`✓ Anggota "${name}" berhasil dihapus dari database!`);
            } else {
              showToast('Gagal menghapus: ' + json.error, true);
            }
          } catch (err: any) {
            showToast('Gagal menghapus: ' + err.message, true);
          }
        },
      });
    });
  });

  // Simpan Profil & Identitas Jurnal
  const formProfile = document.getElementById('form-profile-settings');
  formProfile?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
      name: (document.getElementById('cfg-journal-name') as HTMLInputElement).value,
      nameEn: (document.getElementById('cfg-journal-name-en') as HTMLInputElement).value,
      shortName: (document.getElementById('cfg-journal-short') as HTMLInputElement).value,
      accreditedText: (document.getElementById('cfg-accredited') as HTMLInputElement).value,
      publicationFrequency: (document.getElementById('cfg-frequency') as HTMLInputElement).value,
      doiPrefix: (document.getElementById('cfg-doi-prefix') as HTMLInputElement).value,
      license: (document.getElementById('cfg-license') as HTMLInputElement).value,
      licenseUrl: (document.getElementById('cfg-license-url') as HTMLInputElement).value,
      turnitinMaxSimilarity: Number((document.getElementById('cfg-similarity') as HTMLInputElement).value) || 20,
      reviewTimeEstimate: (document.getElementById('cfg-review-time') as HTMLInputElement).value,
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Profil jurnal berhasil disimpan ke database Cloudflare D1!');
      } else {
        showToast('Gagal menyimpan profil: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menyimpan profil: ' + err.message, true);
    }
  });

  // Simpan Edisi & Terbitan Aktif (Volume / Issue)
  const formVolume = document.getElementById('form-volume-settings');
  formVolume?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
      currentVolume: Number((document.getElementById('cfg-vol-num') as HTMLInputElement).value) || 1,
      currentIssue: Number((document.getElementById('cfg-issue-num') as HTMLInputElement).value) || 1,
      currentYear: Number((document.getElementById('cfg-issue-year') as HTMLInputElement).value) || 2026,
      currentPeriod: (document.getElementById('cfg-issue-period') as HTMLInputElement).value,
      currentTheme: (document.getElementById('cfg-issue-theme') as HTMLTextAreaElement).value,
      currentCoverUrl: (document.getElementById('cfg-issue-cover') as HTMLInputElement).value.trim(),
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Edisi terbitan aktif berhasil disimpan ke database D1!');
      } else {
        showToast('Gagal menyimpan edisi: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menyimpan edisi: ' + err.message, true);
    }
  });

  // Simpan Pengumuman / Announcement
  const formAnnouncement = document.getElementById('form-announcement-settings');
  formAnnouncement?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
      announcementActive: (document.getElementById('cfg-ann-active') as HTMLInputElement).checked,
      announcementTitle: (document.getElementById('cfg-ann-title') as HTMLInputElement).value,
      announcementDate: (document.getElementById('cfg-ann-date') as HTMLInputElement).value,
      announcementContent: (document.getElementById('cfg-ann-content') as HTMLTextAreaElement).value,
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Pengumuman redaksi berhasil disimpan ke database D1!');
      } else {
        showToast('Gagal menyimpan pengumuman: ' + json.error, true);
      }
    } catch (err: any) {
      showToast('Gagal menyimpan pengumuman: ' + err.message, true);
    }
  });

  // 3. Simpan Kontak & Identitas Jurnal
  const formContact = document.getElementById('form-contact-settings');
  formContact?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = {
      whatsappNumber: (document.getElementById('cfg-wa-num') as HTMLInputElement).value,
      whatsappDisplay: (document.getElementById('cfg-wa-display') as HTMLInputElement).value,
      whatsappMessage: (document.getElementById('cfg-wa-msg') as HTMLInputElement).value,
      email: (document.getElementById('cfg-email') as HTMLInputElement).value,
      institution: (document.getElementById('cfg-org-name') as HTMLInputElement).value,
      publisher: (document.getElementById('cfg-pub-name') as HTMLInputElement).value,
      address: (document.getElementById('cfg-address') as HTMLInputElement).value,
      eIssn: (document.getElementById('cfg-eissn') as HTMLInputElement).value,
      pIssn: (document.getElementById('cfg-pissn') as HTMLInputElement).value,
      showIndexingBlock: (document.getElementById('toggle-idx') as HTMLInputElement).checked,
      showToolsBlock: (document.getElementById('toggle-tools') as HTMLInputElement).checked,
      showIssnBlock: (document.getElementById('toggle-issn') as HTMLInputElement).checked,
    };

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Seluruh data kontak & pengaturan jurnal berhasil disimpan ke database!');
      }
    } catch (err: any) {
      showToast('Gagal menyimpan kontak: ' + err.message, true);
    }
  });

  // 4. Toggle Indexing Sidebar
  document.querySelectorAll<HTMLInputElement>('.toggle-index-sidebar').forEach((chk) => {
    chk.addEventListener('change', async () => {
      const name = chk.getAttribute('data-name');
      const showInSidebar = chk.checked;
      if (!name) return;

      try {
        const res = await fetch('/api/indexing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, showInSidebar }),
        });
        const json = await res.json();
        if (json.success) {
          showToast(`✓ Status tampilan "${name}" di sidebar berhasil diperbarui!`);
        }
      } catch (err: any) {
        showToast('Gagal mengupdate indexing: ' + err.message, true);
      }
    });
  });

  // 5. Simpan URL Google Drive
  const formGDrive = document.getElementById('form-gdrive');
  formGDrive?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const gdriveBaseUrl = (document.getElementById('cfg-gdrive-url') as HTMLInputElement).value;

    try {
      const res = await fetch('/api/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ gdriveBaseUrl }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ URL Google Drive Index berhasil disimpan ke database!');
      }
    } catch (err: any) {
      showToast('Gagal menyimpan: ' + err.message, true);
    }
  });

  // 6. Simpan Perubahan URL Platform Pengindeks
  document.querySelectorAll<HTMLButtonElement>('.btn-save-index-url').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.getAttribute('data-name');
      if (!name) return;
      const row = btn.closest('tr');
      const input = row?.querySelector<HTMLInputElement>('.input-index-url');
      const url = input?.value.trim();
      if (!url) {
        showToast('Tautan URL tidak boleh kosong!', true);
        return;
      }

      try {
        const res = await fetch('/api/indexing', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, url }),
        });
        const json = await res.json();
        if (json.success) {
          showToast(`✓ Tautan URL untuk "${name}" berhasil diperbarui ke database!`);
        } else {
          showToast('Gagal menyimpan URL: ' + json.error, true);
        }
      } catch (err: any) {
        showToast('Gagal menyimpan URL: ' + err.message, true);
      }
    });
  });

  // 7. Ganti Kata Sandi / PIN Panel Redaksi
  const formChangePin = document.getElementById('form-change-pin');
  formChangePin?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const currentPin = (document.getElementById('current-pin') as HTMLInputElement).value;
    const newPin = (document.getElementById('new-pin') as HTMLInputElement).value;
    const confirmNewPin = (document.getElementById('confirm-new-pin') as HTMLInputElement).value;

    if (newPin !== confirmNewPin) {
      showToast('Konfirmasi PIN baru tidak cocok dengan PIN baru!', true);
      return;
    }

    try {
      const res = await fetch('/api/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'change_pin', currentPin, newPin }),
      });
      const json = await res.json();
      if (json.success) {
        showToast('✓ Kata sandi / PIN Admin berhasil diperbarui!');
        (formChangePin as HTMLFormElement).reset();
      } else {
        showToast(json.error || 'Gagal mengubah PIN', true);
      }
    } catch (err: any) {
      showToast('Gagal mengubah PIN: ' + err.message, true);
    }
  });
</script>
