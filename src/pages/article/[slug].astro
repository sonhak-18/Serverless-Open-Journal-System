---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import SidebarOJS from '../../components/SidebarOJS.astro';
import { getDbArticleBySlug, getDbSettings } from '../../lib/db';
import { getPdfDownloadUrl, getWhatsAppSubmissionUrl } from '../../config/journal';
import { kvGetCounter } from '../../lib/kv';

const { slug } = Astro.params;
const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const article = slug ? await getDbArticleBySlug(slug, d1) : null;

if (!article) {
  return Astro.redirect('/404');
}

const journalConfig = await getDbSettings(d1);
const pdfUrl = getPdfDownloadUrl(article.pdfFileName);

const kv = (Astro.locals as any)?.runtime?.env?.KV;
const defaultViews = 310 + (article.firstPage || 1) * 14;
const defaultDownloads = 120 + (article.firstPage || 1) * 8;
const initialViews = await kvGetCounter(`stats:views:${article.slug}`, defaultViews, kv);
const initialDownloads = await kvGetCounter(`stats:downloads:${article.slug}`, defaultDownloads, kv);

const cleanDoi = article.doi ? article.doi.replace(/^https?:\/\/doi\.org\//i, '') : '';
const doiUrl = article.doi ? (article.doi.startsWith('http') ? article.doi : `https://doi.org/${cleanDoi}`) : '';

const firstAuthorLastName = article.authors[0].name.split(' ').slice(-1)[0];
const apaCitation = `${firstAuthorLastName}, ${article.authors[0].name.charAt(0)}. (${article.year}). ${article.title}. ${journalConfig.name}, ${article.volume}(${article.issue}), ${article.pages}. ${doiUrl}`;
const ieeeCitation = `${article.authors.map(a => `${a.name.charAt(0)}. ${a.name.split(' ').slice(-1)[0]}`).join(', ')}, "${article.title}," ${journalConfig.shortName}, vol. ${article.volume}, no. ${article.issue}, pp. ${article.pages}, ${article.year}, doi: ${cleanDoi}.`;
const harvardCitation = `${firstAuthorLastName}, ${article.authors[0].name.charAt(0)}. (${article.year}) '${article.title}', ${journalConfig.name}, ${article.volume}(${article.issue}), pp. ${article.pages}. Available at: ${doiUrl}.`;

const waInquiryUrl = getWhatsAppSubmissionUrl(article.title);
---

<Layout title={article.title} description={article.abstract} article={article}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Naskah Lengkap (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <!-- Breadcrumb OJS -->
        <nav class="text-xs text-slate-500 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
          <a href="/" class="hover:underline">Home</a>
          <span>&gt;</span>
          <a href="/archives" class="hover:underline">Archives</a>
          <span>&gt;</span>
          <a href="/current" class="hover:underline">Vol. {article.volume} No. {article.issue} ({article.year})</a>
          <span>&gt;</span>
          <span class="text-slate-700 font-medium truncate max-w-sm">{article.title}</span>
        </nav>

        <!-- Header Artikel -->
        <div class="border-b border-slate-200 pb-5">
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-academic-navy leading-snug">
            {article.title}
          </h1>

          <!-- Daftar Penulis -->
          <div class="mt-4 space-y-2">
            {article.authors.map((author) => (
              <div class="text-base sm:text-lg">
                <span class="font-bold text-academic-navy">{author.name}</span>
                {author.email && (
                  <span class="text-slate-500 font-mono text-sm ml-1.5">({author.email})</span>
                )}
                <p class="text-sm sm:text-base text-slate-600 italic mt-0.5">{author.affiliation}</p>
              </div>
            ))}
          </div>

          <!-- Metadata Penerbitan OJS -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center gap-4 text-xs sm:text-sm text-slate-600">
            <div>
              <strong>DOI:</strong>{' '}
              <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline font-mono">
                {doiUrl}
              </a>
            </div>
            <div>
              <strong>Halaman:</strong> {article.pages}
            </div>
            <div>
              <strong>Dipublikasikan:</strong> {new Date(article.publishDate).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}
            </div>
          </div>
        </div>

        <!-- Tombol Download PDF OJS Style & Statistik Real-Time -->
        <div class="p-5 bg-slate-50 border border-slate-200 rounded space-y-3 shadow-2xs">
          <div class="flex items-center justify-between flex-wrap gap-3">
            <div>
              <span class="block text-base font-bold text-slate-800">Naskah Lengkap Artikel:</span>
              <span class="text-xs sm:text-sm text-slate-500 font-mono">{article.pdfFileName}</span>
            </div>

            <a
              href={pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              id="btn-download-pdf"
              data-track-download={article.slug}
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-academic-navy hover:bg-academic-navy-light text-white text-sm sm:text-base font-bold rounded shadow-xs transition-colors tracking-wide"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd" />
              </svg>
              <span>UNDUH / BACA PDF</span>
            </a>
          </div>

          <!-- Metrik Pembaca OJS (Real-Time Cloudflare KV) -->
          <div class="pt-2 border-t border-slate-200 flex items-center gap-4 text-xs sm:text-sm text-slate-500 font-mono">
            <span class="inline-flex items-center gap-1.5" title="Jumlah pembaca abstrak (Edge KV)">
              <span class="text-emerald-700">📊</span>
              <span>Abstract Views: <strong id="stat-views" class="text-slate-800 font-bold">{initialViews}</strong></span>
            </span>
            <span>|</span>
            <span class="inline-flex items-center gap-1.5" title="Jumlah unduhan PDF resmi">
              <span class="text-red-700">📄</span>
              <span>PDF Downloads: <strong id="stat-downloads" class="text-slate-800 font-bold">{initialDownloads}</strong></span>
            </span>
          </div>
        </div>

        <!-- Abstrak -->
        <div class="space-y-2">
          <h2 class="text-lg sm:text-xl font-serif font-bold uppercase tracking-wider text-academic-navy border-b border-slate-200 pb-1.5">
            Abstract
          </h2>
          <p class="text-base md:text-lg text-slate-800 leading-relaxed text-justify bg-white p-6 sm:p-7 border border-slate-200 rounded shadow-2xs">
            {article.abstract}
          </p>
        </div>

        <!-- Kata Kunci -->
        <div class="space-y-1">
          <h3 class="text-base font-bold uppercase text-slate-800">
            Keywords:
          </h3>
          <p class="text-base text-slate-700 italic">
            {article.keywords.join(', ')}
          </p>
        </div>

        <!-- Widget Format Sitasi (APA, IEEE, Harvard) -->
        <div class="border border-slate-300 bg-white p-4 rounded-xs">
          <div class="flex items-center justify-between border-b border-slate-200 pb-2 mb-3">
            <h3 class="text-xs font-serif font-bold text-slate-900 uppercase tracking-wider">
              How to Cite
            </h3>
            <span class="text-[11px] text-slate-500">Pilih Format Sitasi</span>
          </div>

          <div class="flex border-b border-slate-200 text-xs font-medium space-x-3 mb-2" role="tablist">
            <button type="button" id="tab-apa" class="citation-tab py-1 border-b-2 border-blue-700 text-blue-700 font-bold" data-target="content-apa">
              APA 7th
            </button>
            <button type="button" id="tab-ieee" class="citation-tab py-1 border-b-2 border-transparent text-slate-500 hover:text-slate-800" data-target="content-ieee">
              IEEE
            </button>
            <button type="button" id="tab-harvard" class="citation-tab py-1 border-b-2 border-transparent text-slate-500 hover:text-slate-800" data-target="content-harvard">
              Harvard
            </button>
          </div>

          <div class="bg-slate-50 p-3 rounded-xs border border-slate-200 font-mono text-xs text-slate-800 leading-relaxed">
            <p id="content-apa" class="citation-content">{apaCitation}</p>
            <p id="content-ieee" class="citation-content hidden">{ieeeCitation}</p>
            <p id="content-harvard" class="citation-content hidden">{harvardCitation}</p>
          </div>

          <div class="mt-2.5 flex items-center justify-between">
            <span id="copy-status" class="text-xs text-emerald-700 font-medium opacity-0 transition-opacity">
              ✓ Sitasi berhasil disalin ke clipboard!
            </span>
            <button
              type="button"
              id="btn-copy-citation"
              class="px-3 py-1 bg-slate-200 hover:bg-slate-300 text-slate-800 text-xs font-semibold rounded-xs transition-colors"
            >
              Salin Sitasi
            </button>
          </div>
        </div>

        <!-- Lisensi Hak Cipta OJS -->
        <div class="p-3 bg-slate-50 border border-slate-200 text-xs text-slate-600 rounded-xs">
          <strong>Hak Cipta:</strong> Penulis yang mempublikasikan naskah pada jurnal ini menyetujui lisensi <a href={journalConfig.licenseUrl} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:underline">{journalConfig.license}</a>.
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.citation-tab');
  const contents = document.querySelectorAll<HTMLElement>('.citation-content');
  const copyBtn = document.getElementById('btn-copy-citation');
  const copyStatus = document.getElementById('copy-status');

  let activeContentId = 'content-apa';

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetId = tab.getAttribute('data-target');
      if (!targetId) return;

      activeContentId = targetId;

      tabs.forEach((t) => {
        t.classList.remove('border-blue-700', 'text-blue-700', 'font-bold');
        t.classList.add('border-transparent', 'text-slate-500');
      });

      tab.classList.remove('border-transparent', 'text-slate-500');
      tab.classList.add('border-blue-700', 'text-blue-700', 'font-bold');

      contents.forEach((c) => {
        if (c.id === targetId) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    });
  });

  if (copyBtn && copyStatus) {
    copyBtn.addEventListener('click', async () => {
      const activeEl = document.getElementById(activeContentId);
      if (!activeEl) return;

      try {
        await navigator.clipboard.writeText(activeEl.innerText);
        copyStatus.classList.remove('opacity-0');
        setTimeout(() => {
          copyStatus.classList.add('opacity-0');
        }, 3000);
      } catch (err) {
        console.error('Gagal menyalin:', err);
      }
    });
  }

  // Real-time Track Abstract View
  const articleSlug = document.body.getAttribute('data-article-slug');
  if (articleSlug) {
    fetch('/api/stats', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'track_view', slug: articleSlug }),
    })
      .then((r) => r.json())
      .then((data) => {
        if (data.views) {
          const el = document.getElementById('stat-views');
          if (el) el.textContent = data.views;
        }
      })
      .catch(() => {});
  }

  // Real-time update download counter on click
  const dlBtn = document.getElementById('btn-download-pdf');
  if (dlBtn && articleSlug) {
    dlBtn.addEventListener('click', () => {
      const el = document.getElementById('stat-downloads');
      if (el) {
        const current = parseInt(el.textContent || '0', 10);
        el.textContent = (current + 1).toString();
      }
    });
  }
</script>
