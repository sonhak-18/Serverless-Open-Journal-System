---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import { getDbSettings, getDbEditorial } from '../lib/db';

const journalConfig = await getDbSettings();
const { editorInChief, editors, reviewers } = await getDbEditorial();
---

<Layout title="Editorial Team & Reviewers" description={`Dewan Redaksi dan Mitra Bestari ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Dewan Redaksi (~68%) -->
      <main class="lg:col-span-8 space-y-8">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>Editorial Team</span>
        </div>

        <div class="border-b-2 border-amber-600 pb-2">
          <h1 class="text-xl md:text-2xl font-serif font-bold text-slate-900">
            Editorial Team
          </h1>
        </div>

        <!-- Editor in Chief -->
        <div class="space-y-3">
          <h2 class="text-sm font-serif font-bold text-[#1b3d6d] border-b border-slate-200 pb-1">
            Editor-in-Chief
          </h2>
          <div class="p-4 bg-white border border-slate-200 rounded-xs">
            <h3 class="text-sm font-bold text-slate-900">
              {editorInChief.name}
            </h3>
            <p class="text-xs text-slate-600 mt-0.5">
              {editorInChief.affiliation}
            </p>
            <p class="text-xs text-slate-500 font-mono mt-1">
              Email: <a href={`mailto:${editorInChief.email}`} class="text-blue-700 hover:underline">{editorInChief.email}</a>
            </p>
          </div>
        </div>

        <!-- Managing & Associate Editors -->
        <div class="space-y-3">
          <h2 class="text-sm font-serif font-bold text-[#1b3d6d] border-b border-slate-200 pb-1">
            Managing & Section Editors
          </h2>
          <div class="space-y-2">
            {editors.map((editor) => (
              <div class="p-3 bg-white border border-slate-200 rounded-xs">
                <h3 class="text-xs font-bold text-slate-900">
                  {editor.name}
                </h3>
                <p class="text-xs text-slate-500 font-medium">
                  {editor.role}
                </p>
                <p class="text-xs text-slate-600">
                  {editor.affiliation}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Peer Reviewers / Mitra Bestari -->
        <div id="reviewers" class="space-y-3">
          <h2 class="text-sm font-serif font-bold text-[#1b3d6d] border-b border-slate-200 pb-1">
            Peer Reviewers (Mitra Bestari)
          </h2>
          <div class="space-y-2">
            {reviewers.map((reviewer) => (
              <div class="p-3 bg-slate-50 border border-slate-200 rounded-xs">
                <h3 class="text-xs font-bold text-slate-900">
                  {reviewer.name}
                </h3>
                <p class="text-xs text-slate-600">
                  {reviewer.affiliation}
                </p>
              </div>
            ))}
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
