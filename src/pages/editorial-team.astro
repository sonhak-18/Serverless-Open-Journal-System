---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import { getDbSettings, getDbEditorial } from '../lib/db';

const d1 = (Astro.locals as any)?.runtime?.env?.DB;
const journalConfig = await getDbSettings(d1);
const { editorInChief, editors, reviewers } = await getDbEditorial(d1);
---

<Layout title="Editorial Team & Reviewers" description={`Dewan Redaksi dan Mitra Bestari ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Dewan Redaksi (~68%) -->
      <main class="lg:col-span-8 space-y-8">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>Editorial Team</span>
        </div>

        <div class="border-b-2 border-academic-gold pb-2">
          <h1 class="text-2xl md:text-3xl font-serif font-bold text-academic-navy">
            Editorial Team
          </h1>
        </div>

        <!-- Editor in Chief -->
        <div class="space-y-3">
          <h2 class="text-lg font-serif font-bold text-academic-navy border-b border-slate-200 pb-1.5">
            Editor-in-Chief
          </h2>
          <div class="p-5 bg-white border border-slate-200 rounded shadow-2xs space-y-1">
            <h3 class="text-base font-bold text-slate-900">
              {editorInChief.name}
            </h3>
            <p class="text-sm text-slate-600">
              {editorInChief.affiliation}
            </p>
            <p class="text-xs sm:text-sm text-slate-500 font-mono pt-1">
              Email: <a href={`mailto:${editorInChief.email}`} class="text-academic-teal hover:underline">{editorInChief.email}</a>
            </p>
          </div>
        </div>

        <!-- Managing & Associate Editors -->
        <div class="space-y-3">
          <h2 class="text-lg font-serif font-bold text-academic-navy border-b border-slate-200 pb-1.5">
            Managing & Section Editors
          </h2>
          <div class="space-y-3">
            {editors.map((editor) => (
              <div class="p-4 bg-white border border-slate-200 rounded shadow-2xs">
                <h3 class="text-sm sm:text-base font-bold text-slate-900">
                  {editor.name}
                </h3>
                <p class="text-xs sm:text-sm text-academic-teal font-semibold mt-0.5">
                  {editor.role}
                </p>
                <p class="text-sm text-slate-600 mt-0.5">
                  {editor.affiliation}
                </p>
              </div>
            ))}
          </div>
        </div>

        <!-- Peer Reviewers / Mitra Bestari -->
        <div id="reviewers" class="space-y-3">
          <h2 class="text-lg font-serif font-bold text-academic-navy border-b border-slate-200 pb-1.5">
            Peer Reviewers (Mitra Bestari)
          </h2>
          <div class="space-y-3">
            {reviewers.map((reviewer) => (
              <div class="p-4 bg-slate-50 border border-slate-200 rounded">
                <h3 class="text-sm sm:text-base font-bold text-slate-900">
                  {reviewer.name}
                </h3>
                <p class="text-sm text-slate-600 mt-0.5">
                  {reviewer.affiliation}
                </p>
              </div>
            ))}
          </div>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
