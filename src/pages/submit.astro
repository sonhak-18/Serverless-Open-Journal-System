---
import Layout from '../layouts/Layout.astro';
import SidebarOJS from '../components/SidebarOJS.astro';
import { journalConfig, getWhatsAppSubmissionUrl, getEmailSubmissionUrl } from '../config/journal';

const waUrl = getWhatsAppSubmissionUrl();
const emailUrl = getEmailSubmissionUrl();
---

<Layout title="Online Submission" description={`Petunjuk penyerahan naskah artikel ilmiah ${journalConfig.name}`}>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Kolom Kiri: Penyerahan Naskah (~68%) -->
      <main class="lg:col-span-8 space-y-6">
        <div class="text-xs text-slate-500 mb-2">
          <a href="/" class="hover:underline">Home</a> &gt; <span>Submissions</span>
        </div>

        <div class="border-b-2 border-amber-600 pb-2">
          <h1 class="text-xl md:text-2xl font-serif font-bold text-slate-900">
            Submissions (Penyerahan Naskah)
          </h1>
        </div>

        <p class="text-xs text-slate-700 leading-relaxed">
          {journalConfig.name} menerima naskah hasil penelitian empiris dan studi konseptual di bidang audit, akuntansi, dan perpajakan. Untuk mempermudah proses korespondensi, calon penulis dapat menyerahkan manuskrip langsung ke narahubung redaksi melalui jalur di bawah ini.
        </p>

        <!-- Pilihan Jalur Penyerahan Naskah -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- WhatsApp Redaksi -->
          <div class="p-5 border border-slate-300 bg-white rounded-xs space-y-3">
            <h2 class="text-sm font-serif font-bold text-[#1b3d6d]">
              1. Jalur Cepat (WhatsApp Redaksi)
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Kirimkan berkas naskah (.docx atau .pdf) secara langsung ke WhatsApp sekretariat redaksi untuk konfirmasi cepat dan pengecekan orisinalitas awal.
            </p>
            <div class="text-xs text-slate-700 bg-slate-50 p-2.5 rounded-xs border border-slate-200">
              <span class="block text-slate-500 text-[11px]">Narahubung:</span>
              <span class="font-bold font-mono">{journalConfig.submission.whatsappDisplay}</span>
            </div>
            <a
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="block text-center py-2 px-3 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-xs transition-colors"
            >
              Hubungi WhatsApp Redaksi
            </a>
          </div>

          <!-- Email Sekretariat -->
          <div class="p-5 border border-slate-300 bg-white rounded-xs space-y-3">
            <h2 class="text-sm font-serif font-bold text-[#1b3d6d]">
              2. Jalur Surat Elektronik (Email)
            </h2>
            <p class="text-xs text-slate-600 leading-relaxed">
              Kirimkan manuskrip lengkap beserta identitas seluruh penulis dan surat pengantar ke alamat surat elektronik resmi redaksi pelaksana.
            </p>
            <div class="text-xs text-slate-700 bg-slate-50 p-2.5 rounded-xs border border-slate-200">
              <span class="block text-slate-500 text-[11px]">Alamat Email:</span>
              <span class="font-bold font-mono">{journalConfig.submission.email}</span>
            </div>
            <a
              href={emailUrl}
              class="block text-center py-2 px-3 bg-[#1e4a7a] hover:bg-[#153457] text-white text-xs font-semibold rounded-xs transition-colors"
            >
              Kirim via Email Redaksi
            </a>
          </div>
        </div>

        <!-- Submission Preparation Checklist -->
        <div class="p-5 border border-slate-200 bg-slate-50 rounded-xs space-y-3">
          <h2 class="text-sm font-serif font-bold text-slate-900 border-b border-slate-200 pb-1">
            Submission Preparation Checklist
          </h2>
          <p class="text-xs text-slate-600">
            Sebelum mengirimkan naskah, pastikan poin-poin berikut telah terpenuhi:
          </p>
          <ul class="text-xs text-slate-700 space-y-2 list-disc list-inside">
            <li>Naskah belum pernah dipublikasikan sebelumnya dan tidak sedang dalam pertimbangan di jurnal lain.</li>
            <li>Format berkas manuskrip tersedia dalam format Microsoft Word (.docx).</li>
            <li>Teks mematuhi pedoman format penulisan dan sitasi APA 7th Edition yang tercantum dalam Author Guidelines.</li>
            <li>Hasil pemeriksaan orisinalitas Turnitin tidak melebihi ambang batas toleransi {journalConfig.submission.turnitinMaxSimilarity}%.</li>
          </ul>
        </div>
      </main>

      <!-- Kolom Kanan: Sidebar Standarisasi OJS (~32%) -->
      <div class="lg:col-span-4">
        <SidebarOJS />
      </div>
    </div>
  </div>
</Layout>
